    // <<< icons

    //  A picture's own picture, drawn in pencil: the picture clipped to a hand-drawn rectangle (the corners a little off, the sides a little bowed, a different one for each place it is
    //  drawn), with its outline in two pencil strokes on top, that boil about five times a second under the pointer. The picture goes in as its child. `hot` is the hover.
    component PThumb(x: number, y: number, w: number, h: number, hot: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jb = 1.2 * a
        group {
            clip path { at: x, y; move 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 0.0), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 2.3); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 4.6), -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 6.9); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 9.2), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 11.5); line w + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 13.8), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 16.1); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 18.4), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 20.7); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 23.0), h + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 25.3); line 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 27.6), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 29.9); line -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 32.2), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 34.5); close }
            path { at: x, y; color: deep; opacity: 70%; move 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 0.0), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 2.3); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 4.6), -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 6.9); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 9.2), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 11.5); line w + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 13.8), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 16.1); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 18.4), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 20.7); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 23.0), h + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 25.3); line 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 27.6), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 29.9); line -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 32.2), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 34.5); close }
            children
        }
        path { at: x, y; stroke: 1.6; color: ink; opacity: 85%; move 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 0.0) + jb * sin(fr * 47 + 1000), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 2.3) + jb * sin(fr * 61 + 2000); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 4.6) + jb * sin(fr * 50 + 1311), -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 6.9) + jb * sin(fr * 63 + 2277); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 9.2) + jb * sin(fr * 53 + 1622), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 11.5) + jb * sin(fr * 65 + 2554); line w + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 13.8) + jb * sin(fr * 56 + 1933), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 16.1) + jb * sin(fr * 67 + 2831); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 18.4) + jb * sin(fr * 59 + 2244), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 20.7) + jb * sin(fr * 69 + 3108); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 23.0) + jb * sin(fr * 62 + 2555), h + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 25.3) + jb * sin(fr * 71 + 3385); line 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 27.6) + jb * sin(fr * 65 + 2866), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 29.9) + jb * sin(fr * 73 + 3662); line -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 32.2) + jb * sin(fr * 68 + 3177), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 34.5) + jb * sin(fr * 75 + 3939); close }
        path { at: x + 0.6, y + 0.6; stroke: 1.0; color: ink; opacity: 25% * a; move 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 0.0) + jb * sin(fr * 47 + 1000), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 2.3) + jb * sin(fr * 61 + 2000); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 4.6) + jb * sin(fr * 50 + 1311), -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 6.9) + jb * sin(fr * 63 + 2277); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 9.2) + jb * sin(fr * 53 + 1622), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 11.5) + jb * sin(fr * 65 + 2554); line w + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 13.8) + jb * sin(fr * 56 + 1933), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 16.1) + jb * sin(fr * 67 + 2831); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 18.4) + jb * sin(fr * 59 + 2244), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 20.7) + jb * sin(fr * 69 + 3108); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 23.0) + jb * sin(fr * 62 + 2555), h + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 25.3) + jb * sin(fr * 71 + 3385); line 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 27.6) + jb * sin(fr * 65 + 2866), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 29.9) + jb * sin(fr * 73 + 3662); line -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 32.2) + jb * sin(fr * 68 + 3177), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 34.5) + jb * sin(fr * 75 + 3939); close }
    }

    // ── some pieces that come again and again ──
    //  The glass the menus, the dialogs and the cards are made of: dark underneath, so that what is written on it reads, then the glass, or flat obsidian when the shell has its glass off.
    component Pane(px: number, py: number, pw: number, ph: number, rad: number, gl: number) {
        box { from: px, py; size: pw, ph; corner: rad * rr; color: mix(tint, #000000, 0.2); opacity: 98% }
        body {
            color: tint
            glass: 1
            lens: false
            rim: 70%
            shine: 0, 0
            shadow: 0, 12, 30, 42%
            opacity: gl * (1 - ob)
            show: ob < 0.996
            box { from: px, py; size: pw, ph; corner: rad * rr }
        }
        body {
            color: mix(mix(mix(tint, #000000, 0.7), ink, 0.3), tint, pl)
            rim: 0%
            border: (2 + 1.2 * uk) * pl, deep
            shadow: 0, 12, 30, 45%
            opacity: ob
            show: ob > 0.004
            box { from: px, py; size: pw, ph; corner: rad * rr }
        }
    }
    //  A button of a dialog: `tone` 0 plain, 1 the accent, 2 the alert colour; it says `ev(arg)` when pressed.
    component Btn(bx: number, by: number, bw: number, bl: text, tone: number, ev: event, arg: number) {
        prop hv = 0 ~quick
        follow hv = bz.hover
        box { from: bx, by; size: bw, 34; corner: 12 * rr; color: if(tone == 2, alert, if(tone == 1, mint, ink)); opacity: if(tone == 0, 8% + 8% * hv, 80% + 20% * hv) }
        text bl { at: bx + bw / 2, by + 17; anchor: center; size: 13.5; weight: 600; color: if(tone == 0, ink, onmint); family: "Space Grotesk" }
        zone box bz { from: bx, by; size: bw, 34; corner: 12 * rr; cursor: pointer; label: bl }
        on press bz { emit ev(arg) }
        on leave bz { pen = 0 }
        on enter bz { pen = 1 }
        on hover bz for 80ms { pen = 1 }
    }
    //  One of the little pills under the search field: what to look for, and where.
    component Chip(cx: number, cy: number, cw: number, cl: text, sel: number, k: number) {
        prop hv = 0 ~quick
        follow hv = cz.hover
        box { from: cx, cy; size: cw, 26; corner: 13 * rr; color: mix(ink, mint, sel); opacity: 7% + 9% * hv + 20% * sel }
        box { from: cx, cy; size: cw, 26; corner: 13 * rr; stroke: 1.1; color: mint; opacity: 55% * sel }
        text cl { at: cx + cw / 2, cy + 13; anchor: center; size: 12; weight: 600; color: mix(faint, ink, 0.4 + 0.6 * sel); family: "Space Grotesk" }
        zone box cz { from: cx, cy; size: cw, 26; corner: 13 * rr; cursor: pointer; label: cl; role: toggle; checked: sel > 0.5 }
        on press cz { emit sopt(k) }
    }
    //  A small switch, on or off (the permissions card).
    component Tog(tx: number, ty: number, sel: number, tl: text, k: number) {
        prop hv = 0 ~quick
        follow hv = kz.hover
        box { from: tx, ty; size: 26, 22; corner: 7 * rr; color: mix(ink, mint, sel); opacity: 8% + 8% * hv + 62% * sel }
        text tl { at: tx + 13, ty + 11; anchor: center; size: 12; weight: 700; color: mix(faint, onmint, sel); family: "Space Grotesk" }
        zone box kz { from: tx, ty; size: 26, 22; corner: 7 * rr; cursor: pointer; label: tl; role: toggle; checked: sel > 0.5 }
        on press kz { emit perm(k) }
    }

    // ── the shape of the window ──
    let W = screen.width
    let H = screen.height
    let slim = W < 720
    let side = if(slim, 60, 212)         // the places: only their pictures when it is narrow
    let tb = 60                          // the toolbar
    let sbh = 30                         // the bar under the folder
    let tabsh = if(tabs.count > 1, 36, 0)        // the strip of tabs, when there is more than one
    let fsh = if(searching, 38, 0)               // the search's choices
    let trsh = if(in.trash, 40, 0)               // the trash's two buttons
    let mx = side + 14
    let mw = W - side - 28
    let my = tb + 8 + tabsh + fsh + trsh
    let hh = if(view == lines, 30, 0)            // the heads of the columns, when it is lines
    let cy0 = my + hh                            // where the first row is
    let mh = H - my - sbh - 8
    let vph = mh - hh                            // how much of the folder is seen at once
    let tile.w = max(tilebase, floor(mw / 12))   // a window so wide that twelve would not fill it gets bigger tiles
    let tile.h = if(view == grid, tile.w + 4, 38)
    let isz = tile.w / 128                       // how much bigger than the first size a picture is
    let ih = round((tile.w - 12) * 0.68)         // the height of a tile's picture
    let lpr = 12                         // in the lines, a row of the model is a block of this many lines, one under the other (so the model stays small)
    let row.h = if(view == grid, tile.h, 38 * lpr)
    let cols.now = if(view == grid, max(floor(mw / tile.w), 1), 1)
    let content = if(view == grid, total * tile.h, itemsn * 38) + 8
    let maxsc = max(content - vph, 0)
    let wide = mw > 620                  // in the lines: with the kind and the date, or only the size
    let namew = if(wide, mw - 530, mw - 170)
    let lkx = mw - 470                   // the lines' columns, from the left of a line
    let ldx = mw - 330
    let lsx = mw - 16
    let pill.w = W - side - 126 - 254
    on change cols.now { emit set_cols(cols.now) }
    on change view { emit set_cols(cols.now) }
    on change ready { emit set_cols(cols.now); vh = vph; crumbw = pill.w - 40; tilew = tile.w; roomw = mw - 44 }
    on change vph { vh = vph }
    on change mw { roomw = mw - 44 }
    on change pill.w { crumbw = pill.w - 40 }
    on change tile.w { tilew = tile.w }
    on focus { emit focused }

    // ── the glass ──
    body {
        color: tint
        glass: 1
        lens: false
        rim: 60%
        shine: 0, 0
        opacity: 90% * (1 - ob)
        show: ob < 0.996
        box { from: 0, 0; size: W, H; corner: 22 * rr }
    }
    body {
        color: mix(mix(mix(tint, #000000, 0.7), ink, 0.3), tint, pl)
        rim: 0%
        border: (2 + 1.2 * uk) * pl, deep
        opacity: ob
        show: ob > 0.004
        box { from: 0, 0; size: W, H; corner: 22 * rr }
    }
    //  The places lie on it a little darker, and the folder sits in a hollow of its own.
    box { from: 0, 0; size: side, H; corner: 22 * rr; color: panel; opacity: 30% }
    box { from: side - 24, 0; size: 24, H; color: tint; opacity: 0 }
    box { from: side, 14; size: 1, H - 28; color: ink; opacity: 8% }
    box { from: mx - 6, my - 4; size: mw + 12, mh + 6; corner: 14 * rr; color: deep; opacity: 24% }

    // ── the places ──
    //  A row of the list is a place (a folder to go to), a drive (with how full it is, and a way to let it go), or a heading over the ones that follow.
    group {
        PFile0(if(slim, 30, 34), 31, 0.42, 0, 0, 1)
        text "Files" { at: 58, 31; anchor: left center; size: 17; weight: 700; color: ink; show: not slim; family: "Space Grotesk" }
        column placelist {
            at: 8, 72
            view: side - 16, H - 72 - 44
            step: 38
            gap: 2
            for p in places {
                group {
                    size: side - 16, if(p.kind == 1, 30, if(p.kind == 2, 44, 38))
                    //  a heading
                    text p.name { at: 14, 18; anchor: left center; size: 11; weight: 700; color: faint; opacity: 80%; show: p.kind == 1 and not slim; family: "Space Grotesk" }
                    box { from: 10, 14; size: side - 36, 1; color: ink; opacity: 10%; show: p.kind == 1 and slim }
                    group {
                        show: p.kind != 1
                        prop hv = 0 ~quick
                        follow hv = pz.hover
                        box { from: 0, 0; size: side - 16, if(p.kind == 2, 42, 36); corner: 11 * rr; color: mix(ink, mint, if(p.here, 1, 0)); opacity: 8% * hv + if(p.here, 20%, 0%) }
                        box { from: 0, 0; size: side - 16, if(p.kind == 2, 42, 36); corner: 11 * rr; stroke: 1.2; color: mint; opacity: if(p.here, 55%, 0%) }
                        PPlace(22, 18, 0.42, p.pk, 1)
                        text p.name { at: 46, 18; anchor: left center; size: 13.5; weight: 600; width: side - 70 - if(p.eject, 28, 0); lines: 1; color: ink; show: not slim; family: "Space Grotesk" }
                        box { from: 46, 34; size: side - 16 - 46 - 14, 3; corner: 2; color: ink; opacity: 14%; show: p.kind == 2 and p.use >= 0 and not slim }
                        box { from: 46, 34; size: max((side - 16 - 46 - 14) * p.use, 2), 3; corner: 2; color: mix(mint, alert, p.use); opacity: 80%; show: p.kind == 2 and p.use >= 0 and not slim }
                        zone box pz { from: 0, 0; size: side - 16, if(p.kind == 2, 42, 36); corner: 11 * rr; cursor: pointer; label: "{p.name}"; role: item }
                        on press pz { emit place(p.at) }
                        on press right pz { menu.x = pointer.x; menu.y = pointer.y; emit place_menu(p.at) }
                        on drop pz { emit dropped(-100 - p.at) }
                        on leave pz { pen = 0 }
                        on enter pz { pen = 1 }
                        on hover pz for 80ms { pen = 1 }
                        // the way to let a drive go
                        group {
                            show: p.eject and not slim
                            prop eh2 = 0 ~quick
                            follow eh2 = ez.hover
                            box { from: side - 16 - 30, 5; size: 26, 26; corner: 8 * rr; color: mint; opacity: 20% * eh2 }
                            PGlyphS34(side - 16 - 17, 18, 0.62, 34, 1)
                            zone box ez { from: side - 16 - 30, 5; size: 26, 26; corner: 8 * rr; cursor: pointer; label: "Eject {p.name}" }
                            on press ez { emit place_eject(p.at) }
                        }
                    }
                }
            }
        }
    }

    //  Under the places: drop a folder there to pin it to them. It lights up while something is being carried over the window.
    let pin.y = H - 100
    zone box pinzone { from: 8, pin.y; size: side - 16, 52; corner: 12 * rr; label: "Drop a folder here to pin it"; role: region; active: drag.over > 0.5 }
    on drop pinzone { emit dropped(-400) }
    //  (Only while the pointer is over it: a hint that shows whenever anything is carried over the window is a hint where you are not going.)
    prop pinh = 0 ~quick
    follow pinh = if(drag.over > 0.5, pinzone.hover, 0)
    group {
        show: pinh > 0.01
        opacity: pinh
        box { from: 8, pin.y; size: side - 16, 52; corner: 12 * rr; color: tint; opacity: 96% }
        box { from: 8, pin.y; size: side - 16, 52; corner: 12 * rr; stroke: 1.4; color: mint; opacity: 55% }
        box { from: 8, pin.y; size: side - 16, 52; corner: 12 * rr; color: mint; opacity: 8% }
        text "Drop a folder here to pin it" { at: side / 2, pin.y + 26; anchor: center; width: side - 40; lines: 2; align: center; size: 12.5; weight: 600; color: mint; show: not slim; family: "Space Grotesk" }
        PGlyphS36(side / 2, pin.y + 26, 0.9, 36, 1)
    }

    // ── the toolbar: back, forward, up, where you are, how it looks ──
    repeat i in 0..8 {
        let bx = pick(i, side + 28, side + 66, side + 104, W - 196, W - 158, W - 112, W - 70, W - 28)
        let on = pick(i, can.back, can.fwd, 1, 1, 1, 1, 1, 1)
        let sel = pick(i, 0, 0, 0, if(view == grid, 1, 0), if(view == lines, 1, 0), if(hidden, 1, 0), 0, 0)
        prop bh.$i = 0 ~quick
        follow bh.$i = bz.$i.hover
        box { at: bx, 34; size: 34, 34; corner: 10 * rr; color: if(i == 7, alert, mix(ink, mint, sel)); opacity: if(i == 7, 26%, 12%) * bh.$i + 22% * sel }
        PGlyph(bx, 34, 1, i, bh.$i, if(on > 0.5, 1, 0.3))
        zone box bz.$i { at: bx, 34; size: 34, 34; corner: 10 * rr; cursor: pointer; active: on > 0.5; label: pick(i, "Back", "Forward", "Up one folder", "Tiles", "Lines", "Hidden files", "New folder", "Close") }
        on press bz.$i { emit act(pick(i, 12, 13, 11, 31, 32, 14, 1, 50)) }
        on leave bz.$i { pen = 0 }
        on enter bz.$i { pen = 1 }
        on hover bz.$i for 80ms { pen = 1 }
    }
    //  Where you are: each folder on the way, to be clicked (and the rest of the room is for typing a path: Ctrl+L, or click there).
    box { from: side + 126, 16; size: pill.w, 36; corner: 18 * rr; color: ink; opacity: 7% }
    zone box pillz { from: side + 126, 16; size: pill.w, 36; corner: 18 * rr; cursor: text; label: "Path"; role: region }
    on press pillz { emit act(60) }
    //  The search: a magnifier before the buttons on the right; open, the field takes the place of the path (it filters this folder as you type; Enter looks in the folders under it too).
    prop srh = 0 ~quick
    follow srh = sbz.hover
    box { at: W - 234, 34; size: 34, 34; corner: 10 * rr; color: mix(ink, mint, if(searching, 1, 0)); opacity: 12% * srh + 22% * if(searching, 1, 0) }
    ellipse { at: W - 235, 33; radius: 6.5; stroke: 1.8; color: ink; opacity: 85% + 15% * srh }
    path { at: W - 235, 33; stroke: 1.8; color: ink; opacity: 85% + 15% * srh; move 4.7, 4.7; line 9, 9 }
    zone box sbz { at: W - 234, 34; size: 34, 34; corner: 10 * rr; cursor: pointer; label: "Search" }
    on press sbz { emit act(33) }
    group {
        show: searching
        box { from: side + 126, 16; size: pill.w, 36; corner: 18 * rr; stroke: 1.2; color: mint; opacity: 60% }
        ellipse { at: side + 150, 33; radius: 5.5; stroke: 1.6; color: mint; opacity: 90% }
        path { at: side + 150, 33; stroke: 1.6; color: mint; opacity: 90%; move 4, 4; line 7.5, 7.5 }
        input sq { at: side + 170, 26; width: pill.w - 60 - if(slim, 0, 190); size: 14; weight: 500; color: ink; placeholder: "Search"; show: searching; family: "Space Grotesk" }
        text "Enter: look in the folders under it" { at: side + 126 + pill.w - 18, 34; anchor: right center; size: 11.5; weight: 500; color: faint; opacity: 80%; show: not slim; family: "Space Grotesk" }
        on submit sq { emit search_go }
    }
    group {
        show: loc.edit and not searching
        box { from: side + 126, 16; size: pill.w, 36; corner: 18 * rr; stroke: 1.2; color: mint; opacity: 60% }
        PGlyphS39(side + 150, 34, 0.6, 39, 1)
        input locin { at: side + 170, 26; width: pill.w - 60; size: 14; weight: 500; color: ink; placeholder: "Type a folder, ~/ or smb://…"; show: loc.edit; family: "Space Grotesk" }
        on submit locin { emit loc_go }
    }
    for c in crumbs {
        group {
            show: not searching and not loc.edit
            let cx = side + 144 + c.x
            prop hv = 0 ~quick
            follow hv = cz.hover
            box { from: cx - 6, 21; size: c.w + 4, 26; corner: 8 * rr; color: mint; opacity: 16% * hv }
            text c.name { at: cx, 34; anchor: left center; size: 13.5; weight: if(c.last, 700, 500); color: if(c.last, ink, mix(ink, faint, 0.4)); lines: 1; family: "Space Grotesk" }
            text "›" { at: cx + c.w + 8, 33; anchor: center; size: 15; color: faint; opacity: 70%; show: not c.last; family: "Space Grotesk" }
            zone box cz { at: cx + c.w / 2 - 2, 34; size: c.w + 4, 26; corner: 8 * rr; cursor: pointer; label: "{c.name}" }
            on press cz { emit crumb(c.at) }
            on drop cz { emit dropped(-200 - c.at) }
        }
    }

    // ── the strip under the toolbar: the tabs, the search's choices, the trash's buttons ──
    group {
        show: tabs.count > 1
        for t in tabs {
            group {
                let tx = mx + t.x
                prop hv = 0 ~quick
                follow hv = tz.hover
                box { from: tx, tb + 11; size: t.w - 6, 28; corner: 10 * rr; color: mix(ink, mint, if(t.active, 1, 0)); opacity: 7% + 8% * hv + 18% * if(t.active, 1, 0) }
                box { from: tx, tb + 11; size: t.w - 6, 28; corner: 10 * rr; stroke: 1.1; color: mint; opacity: if(t.active, 50%, 0%) }
                text t.name { at: tx + 12, tb + 25; anchor: left center; size: 12.5; weight: if(t.active, 700, 500); color: ink; width: t.w - 52; lines: 1; family: "Space Grotesk" }
                zone box tz { from: tx, tb + 11; size: t.w - 34, 28; corner: 10 * rr; cursor: pointer; label: "{t.name}"; role: tab; selected: t.active }
                on press tz { emit tab_go(t.at) }
                on press middle tz { emit tab_close(t.at) }
                on drop tz { emit dropped(-300 - t.at) }
                prop xh = 0 ~quick
                follow xh = xz.hover
                box { from: tx + t.w - 32, tb + 15; size: 20, 20; corner: 7 * rr; color: ink; opacity: 14% * xh }
                PGlyphS7(tx + t.w - 22, tb + 25, 0.4, 7, 0.8)
                zone box xz { from: tx + t.w - 32, tb + 15; size: 20, 20; corner: 7 * rr; cursor: pointer; label: "Close {t.name}" }
                on press xz { emit tab_close(t.at) }
            }
        }
        prop nh = 0 ~quick
        follow nh = nz.hover
        box { from: W - 14 - 30, tb + 11; size: 28, 28; corner: 9 * rr; color: mint; opacity: 16% * nh }
        PGlyphS32(W - 14 - 16, tb + 25, 0.5, 32, 0.9)
        zone box nz { from: W - 14 - 30, tb + 11; size: 28, 28; corner: 9 * rr; cursor: pointer; label: "New tab" }
        on press nz { emit act(56) }
    }
    //  What to look for: names or what is written in the files, anything or one kind of thing, in this folder or all the home folder.
    group {
        show: searching
        let sy = tb + 8 + tabsh + 5
        text "Look in" { at: mx, sy + 13; anchor: left center; size: 11.5; weight: 600; color: faint; show: not slim; family: "Space Grotesk" }
        Chip(mx + if(slim, 0, 52), sy, 70, "Names", if(so.what == 0, 1, 0), 10)
        Chip(mx + if(slim, 0, 52) + 76, sy, 84, "Contents", if(so.what == 1, 1, 0), 11)
        Chip(mx + if(slim, 0, 52) + 176, sy, 44, "All", if(so.kind == 0, 1, 0), 20)
        Chip(mx + if(slim, 0, 52) + 226, sy, 64, "Folders", if(so.kind == 1, 1, 0), 21)
        Chip(mx + if(slim, 0, 52) + 296, sy, 70, "Pictures", if(so.kind == 2, 1, 0), 22)
        Chip(mx + if(slim, 0, 52) + 372, sy, 86, "Documents", if(so.kind == 3, 1, 0), 23)
        Chip(mx + if(slim, 0, 52) + 464, sy, 62, "Sounds", if(so.kind == 4, 1, 0), 24)
        Chip(mx + if(slim, 0, 52) + 532, sy, 62, "Videos", if(so.kind == 5, 1, 0), 25)
        Chip(mx + mw - 160, sy, 90, "This folder", if(so.where == 0, 1, 0), 30)
        Chip(mx + mw - 64, sy, 64, "Home", if(so.where == 1, 1, 0), 31)
    }
    group {
        show: in.trash
        let ty = tb + 8 + tabsh + fsh + 3
        box { from: mx - 6, ty; size: mw + 12, 34; corner: 12 * rr; color: alert; opacity: 10% }
        text "Things in the Trash stay until you empty it" { at: mx + 10, ty + 17; anchor: left center; size: 12.5; weight: 500; color: ink; opacity: 85%; show: not slim; family: "Space Grotesk" }
        Btn(mx + mw - 270, ty + 0, 110, "Restore", 0, act, 44)
        Btn(mx + mw - 152, ty + 0, 140, "Empty Trash", 2, act, 18)
    }

    // ── the folder: tiles, or lines ──
    //  It scrolls here and not in the layout, which would carry the list off with the pointer whenever a press began between two tiles; this way a press there starts a box that chooses what it covers.
    //  The wheel and the bar say where to (`sct`), and the list gets there with a spring (`sc`).
    prop sc = 0 ~calm
    follow sc = sct
    on change floor(sc / row.h) { emit slid(sc) }
    on change gen { sct = 0; sc: 0 ~0ms }
    zone box midzone { from: mx, cy0; size: mw, vph; label: "The folder"; role: region }
    on press midzone { rb.ax = clamp(pointer.x - mx, 0, mw); rb.ay = clamp(pointer.y - cy0, 0, vph) + sc; rb.bx = rb.ax; rb.by = rb.ay; emit tile(-1) }
    on drag midzone { rb.on = true; rb.bx = clamp(pointer.x - mx, 0, mw); rb.by = clamp(pointer.y - cy0, 0, vph) + sc; emit band }
    on release midzone { rb.on = false; emit band_end }
    every 40ms while rb.on {
        sct = clamp(sct + clamp(pointer.y - (cy0 + vph - 30), 0, 60) * 0.5 - clamp((cy0 + 30) - pointer.y, 0, 60) * 0.5, 0, maxsc)
        rb.by = clamp(pointer.y - cy0, 0, vph) + sc
    }
    on press right midzone { menu.x = pointer.x; menu.y = pointer.y; emit bg_menu }
    on scroll midzone { sct = clamp(sct - wheel * 90, 0, maxsc) }
    on drop midzone { emit dropped(-1) }
    text empty { at: mx + mw / 2, cy0 + vph / 2 - 10; anchor: center; size: 15; weight: 600; color: faint; show: total == 0 and ready; family: "Space Grotesk" }
    //  The heads of the columns (in the lines): to be pressed to sort by them, and the little arrow says which way.
    group {
        show: view == lines
        box { from: mx, my; size: mw, hh - 3; corner: 9 * rr; color: ink; opacity: 5% }
        text "Name" { at: mx + 50, my + 13; anchor: left center; size: 12; weight: 700; color: mix(faint, ink, if(sort == name, 1, 0.3)); family: "Space Grotesk" }
        text "Kind" { at: mx + lkx, my + 13; anchor: left center; size: 12; weight: 700; color: mix(faint, ink, if(sort == type, 1, 0.3)); show: wide; family: "Space Grotesk" }
        text "Modified" { at: mx + ldx, my + 13; anchor: left center; size: 12; weight: 700; color: mix(faint, ink, if(sort == date, 1, 0.3)); show: wide; family: "Space Grotesk" }
        text "Size" { at: mx + lsx, my + 13; anchor: right center; size: 12; weight: 700; color: mix(faint, ink, if(sort == size, 1, 0.3)); family: "Space Grotesk" }
        //  the arrow: up for the first at the top, down when it is turned round
        let ax = mx + if(sort == name, 50 + 44, if(sort == type, lkx + 40, if(sort == date, ldx + 68, lsx - 44)))
        path { at: ax, my + 13; stroke: 1.6; color: mint; opacity: 90%; move -4, if(sortrev, -2.5, 2.5); line 0, if(sortrev, 2.5, -2.5); line 4, if(sortrev, -2.5, 2.5) }
        zone box hz0 { from: mx, my; size: mw - 470 + 10, hh - 3; corner: 9 * rr; cursor: pointer; label: "Sort by name"; show: wide }
        zone box hz0b { from: mx, my; size: mw - 110, hh - 3; corner: 9 * rr; cursor: pointer; label: "Sort by name"; show: not wide }
        zone box hz1 { from: mx + lkx - 4, my; size: 134, hh - 3; corner: 9 * rr; cursor: pointer; label: "Sort by kind"; show: wide }
        zone box hz2 { from: mx + ldx - 4, my; size: 144, hh - 3; corner: 9 * rr; cursor: pointer; label: "Sort by date"; show: wide }
        zone box hz3 { from: mx + lsx - 90, my; size: 94, hh - 3; corner: 9 * rr; cursor: pointer; label: "Sort by size" }
        on press hz0 { emit sort_by(0) }
        on press hz0b { emit sort_by(0) }
        on press hz1 { emit sort_by(2) }
        on press hz2 { emit sort_by(3) }
        on press hz3 { emit sort_by(1) }
    }
    group {
        clip box { from: mx - 6, cy0 - 4; size: mw + 12, vph + 4; corner: 10 * rr }
        column grid {
            at: mx, cy0 - sc
            gap: 0
            for r in rows from first {
                group {
                    size: mw, row.h
                    move: 0, first * row.h
                    for c in r.cells {
                        group {
                            move: 0, if(view == grid, 0, mod(c.at, lpr) * tile.h)
                            let tx = if(view == grid, mod(c.at, cols) * tile.w, 0)
                            let tw = if(view == grid, tile.w - 8, mw)
                            prop on = 0 ~quick
                            follow on = if(c.picked, 1, 0)
                            prop hv = 0 ~quick
                            follow hv = t.hover
                            prop ta = 0 ~calm
                            follow ta = if(c.has.thumb, 1, 0)
                            box { from: tx, 0; size: tw, tile.h - 4; corner: 12 * rr; color: mix(ink, mint, on); opacity: 8% * hv + 20% * on }
                            box { from: tx, 0; size: tw, tile.h - 4; corner: 12 * rr; stroke: 1.2; color: mint; opacity: 65% * on }
                            box { from: tx, 0; size: tw, tile.h - 4; corner: 12 * rr; stroke: 1.1; color: ink; opacity: 38%; show: c.cur and not c.picked }
                            box { from: tx, 0; size: tw, tile.h - 4; corner: 12 * rr; stroke: 1.6; color: mint; opacity: 80% * hv * drag.over * if(c.ik == 0, 1, 0); show: c.ik == 0 and drag.over > 0.5 }
                            // A file's or a folder's picture, for the tiles and the lines alike: there is one copy of it here, not two, since each is long to load.
                            group {
                                show: not c.has.thumb
                                opacity: if(c.hidden, 55%, 100%) * if(c.cut, 50%, 100%) * if(c.broken, 40%, 100%)
                                PFile(if(view == grid, tx + tw / 2, tx + 24), if(view == grid, ih * 0.58 + 2, 17), if(view == grid, 0.95 * isz, 0.4), c.ik, hv, 1)
                            }
                            // Tiles: the picture, and the name under it.
                            group {
                                show: view == grid
                                opacity: if(c.hidden, 55%, 100%) * if(c.cut, 50%, 100%)
                                // A picture shows itself, in a frame, instead of its icon.
                                group {
                                    show: c.has.thumb
                                    PThumb(tx + 6, 6, tw - 12, ih, hv) {
                                        image c.thumb { at: tx + 6, 6; size: tw - 12, ih; opacity: ta }
                                    }
                                }
                                text c.name { at: tx + tw / 2, ih + 11; anchor: center top; width: tile.w - 20; lines: 2; align: center; size: 12; weight: 500; color: ink; line_height: 1.2; family: "Space Grotesk" }
                            }
                            // Lines: the picture, the name, the kind, the date and the size.
                            group {
                                show: view == lines
                                opacity: if(c.hidden, 55%, 100%) * if(c.cut, 50%, 100%)
                                group {
                                    show: c.has.thumb
                                    PThumb(tx + 8, 3, 34, 26, hv) {
                                        image c.thumb { at: tx + 8, 3; size: 34, 26; opacity: ta }
                                    }
                                }
                                text c.name { at: tx + 50, 17; anchor: left center; width: namew; lines: 1; size: 13; weight: 500; color: ink; family: "Space Grotesk" }
                                text c.kind { at: tx + lkx, 17; anchor: left center; size: 12; color: faint; width: 130; lines: 1; show: wide; family: "Space Grotesk" }
                                text c.date { at: tx + ldx, 17; anchor: left center; size: 12; color: faint; width: 140; lines: 1; show: wide; family: "Space Grotesk" }
                                text c.size { at: tx + lsx, 17; anchor: right center; size: 12; color: faint; family: "Space Grotesk" }
                            }
                            // What else is true of it: it is a link to somewhere (a ring with an arrow), it is one you starred.
                            group {
                                show: c.link
                                let lbx = if(view == grid, tx + tw / 2 - 22 * isz, tx + 14)
                                let lby = if(view == grid, ih * 0.58 + 2 + 20 * isz, 26)
                                ellipse { at: lbx, lby; radius: 7.5; color: tint; opacity: 92% }
                                ellipse { at: lbx, lby; radius: 7.5; stroke: 1.1; color: mint; opacity: 80% }
                                path { at: lbx, lby; stroke: 1.5; color: ink; move -2.6, 2.6; line 2.6, -2.6 }
                                path { at: lbx, lby; stroke: 1.5; color: ink; move -1, -3.2; line 3.2, -3.2; line 3.2, 1 }
                            }
                            group {
                                show: c.star
                                let stx = if(view == grid, tx + tw / 2 + 24 * isz, tx + tw - 26)
                                let sty = if(view == grid, 11, 10)
                                path { at: stx, sty; color: mint; opacity: 95%; move 0, -6.5; line 1.9, -2; line 6.5, -1.9; line 2.9, 1; line 4, 5.8; line 0, 3.2; line -4, 5.8; line -2.9, 1; line -6.5, -1.9; line -1.9, -2; close }
                            }
                            zone box t { from: tx, 0; size: tw, tile.h - 4; corner: 12 * rr; carries: "{c.carry}"; carry_icon: "{dragicon}"; label: "{c.name}"; role: item; selected: c.picked }
                            on press t { emit tile(c.at) }
                            on release t { emit tile_up(c.at) }
                            on press right t { menu.x = pointer.x; menu.y = pointer.y; emit tile_menu(c.at) }
                            on press middle t { emit tile_mid(c.at) }
                            on drop t { emit dropped(c.at) }
                            on hover t for 900ms while drag.over > 0.5 and c.ik == 0 { emit spring(c.at) }
                            on leave t { pen = 0 }
                            on enter t { pen = 1 }
                            on hover t for 80ms { pen = 1 }
                        }
                    }
                }
            }
        }
    }
    //  The box being dragged over the folder to choose what is in it.
    group {
        show: rb.on
        clip box { from: mx - 6, cy0 - 4; size: mw + 12, vph + 4; corner: 10 * rr }
        box { from: mx + min(rb.ax, rb.bx), cy0 + min(rb.ay, rb.by) - sc; size: abs(rb.bx - rb.ax), abs(rb.by - rb.ay); corner: 4; color: mint; opacity: 14% }
        box { from: mx + min(rb.ax, rb.bx), cy0 + min(rb.ay, rb.by) - sc; size: abs(rb.bx - rb.ax), abs(rb.by - rb.ay); corner: 4; stroke: 1.2; color: mint; opacity: 75% }
    }
    //  The bar at the right: where in the folder, and a grip to drag.
    let sbt = clamp(vph * vph / max(content, 1), 36, max(vph, 36))
    let sby = cy0 + (vph - sbt) * sc / max(maxsc, 1)
    prop sbo = 0 ~calm
    follow sbo = if(maxsc > 0, 1, 0)
    box { from: mx + mw + 3, sby; size: 5, sbt; corner: 3; color: ink; opacity: sbo * (16% + 30% * scz.hover); show: sbo > 0.01 }
    zone box scz { from: mx + mw - 4, cy0; size: 18, vph; active: maxsc > 0; cursor: pointer; label: "Scroll bar" }
    on press scz { sct = clamp((pointer.y - cy0 - sbt / 2) / max(vph - sbt, 1) * maxsc, 0, maxsc) }
    on drag scz { sct = clamp((pointer.y - cy0 - sbt / 2) / max(vph - sbt, 1) * maxsc, 0, maxsc) }
    //  The list lies over the middle... and what is carried over the folder lands in it: the same kind of hint as the pin zone's, for the middle, while the pointer is there.
    prop midh = 0 ~quick
    follow midh = if(drag.over > 0.5, midzone.hover, 0)
    group {
        show: midh > 0.01
        opacity: midh
        box { from: mx - 4, my - 2; size: mw + 8, mh + 2; corner: 14 * rr; stroke: 1.4; color: mint; opacity: 55% }
        box { from: mx - 4, my - 2; size: mw + 8, mh + 2; corner: 14 * rr; color: mint; opacity: 6% }
        box { from: mx + mw / 2 - 130, my + mh - 46; size: 260, 30; corner: 15 * rr; color: tint; opacity: 90% }
        text "Drop to put it in this folder" { at: mx + mw / 2, my + mh - 31; anchor: center; size: 13; weight: 600; color: mint; family: "Space Grotesk" }
    }

    // ── what is going on, and what can be taken back: two cards that float at the bottom of the folder ──
    let jy = H - sbh - 8 - 70
    group {
        show: job.on
        let jx = mx + mw / 2 - 220
        Pane(jx, jy, 440, 62, 16, 0.6)
        text job.text { at: jx + 18, jy + 20; anchor: left center; size: 13; weight: 600; color: ink; width: 310; lines: 1; family: "Space Grotesk" }
        box { from: jx + 18, jy + 40; size: 310, 6; corner: 3; color: ink; opacity: 16% }
        box { from: jx + 18, jy + 40; size: 310 * clamp(job.p, 0, 1), 6; corner: 3; color: mint; opacity: 90%; show: job.p >= 0 }
        box { from: jx + 18 + 250 * fract(time * 0.9), jy + 40; size: 60, 6; corner: 3; color: mint; opacity: 90%; show: job.p < 0 }
        Btn(jx + 346, jy + 14, 80, "Cancel", 0, job_cancel, 0)
    }
    group {
        show: undo.on
        let uy = jy + if(job.on, -62, 18)
        let ux = mx + mw / 2 - 200
        Pane(ux, uy, 400, 44, 14, 0.6)
        text undo.text { at: ux + 18, uy + 22; anchor: left center; size: 13; weight: 600; color: ink; width: 270; lines: 1; family: "Space Grotesk" }
        Btn(ux + 296, uy + 5, 90, "Undo", 1, act, 47)
    }

    // ── the bar under the folder ──
    text status { at: side + 20, H - 17; anchor: left center; size: 12; weight: 500; color: faint; lines: 1; width: W - side - 400; family: "Space Grotesk" }
    text free { at: W - 204, H - 17; anchor: right center; size: 12; color: faint; family: "Space Grotesk" }
    prop sh = 0 ~quick
    follow sh = sorter.hover
    box { from: W - 136, H - 28; size: 124, 22; corner: 8 * rr; color: mint; opacity: 16% * sh }
    text sortname { at: W - 74, H - 17; anchor: center; size: 12; weight: 600; color: mix(faint, ink, sh); family: "Space Grotesk" }
    zone box sorter { from: W - 136, H - 28; size: 124, 22; corner: 8 * rr; cursor: pointer; label: "Sort order" }
    on press sorter { menu.x = pointer.x; menu.y = pointer.y; emit act(15) }
    prop zi = 0 ~quick
    follow zi = zinz.hover
    prop zo = 0 ~quick
    follow zo = zoutz.hover
    box { from: W - 166, H - 28; size: 22, 22; corner: 8 * rr; color: mint; opacity: 16% * zi }
    box { from: W - 192, H - 28; size: 22, 22; corner: 8 * rr; color: mint; opacity: 16% * zo }
    PGlyphS32(W - 155, H - 17, 0.5, 32, 0.9)
    PGlyphS33(W - 181, H - 17, 0.5, 33, 0.9)
    zone box zinz { from: W - 166, H - 28; size: 22, 22; corner: 8 * rr; cursor: pointer; label: "Bigger" }
    zone box zoutz { from: W - 192, H - 28; size: 22, 22; corner: 8 * rr; cursor: pointer; label: "Smaller" }
    on press zinz { emit act(51) }
    on press zoutz { emit act(52) }

    // ── the name dialog: a new folder, a new name, a place to connect to, or a question ──
    group {
        show: ask.on
        zone box askcatch { from: 0, 0; size: W, H; active: ask.on }
        on press askcatch { emit act(10) }
        box { from: 0, 0; size: W, H; corner: 22 * rr; color: deep; opacity: 45% }
        Pane(W / 2 - 220, H / 2 - 80, 440, 160, 18, 0.96)
        zone box askbox { from: W / 2 - 220, H / 2 - 80; size: 440, 160 }
        text ask.title { at: W / 2 - 196, H / 2 - 52; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk" }
        box { from: W / 2 - 196, H / 2 - 28; size: 392, 40; corner: 12 * rr; color: deep; opacity: 45%; show: ask.input }
        box { from: W / 2 - 196, H / 2 - 28; size: 392, 40; corner: 12 * rr; stroke: 1.2; color: mint; opacity: 55%; show: ask.input }
        input askin { at: W / 2 - 184, H / 2 - 18; width: 368; size: 15; weight: 500; color: ink; placeholder: "Name"; show: ask.input; family: "Space Grotesk" }
        text ask.msg { at: W / 2 - 196, H / 2 - 30; anchor: left top; size: 14; weight: 500; color: ink; opacity: 85%; width: 392; lines: 3; show: not ask.input; family: "Space Grotesk" }
        on submit askin { emit ask_ok }
        Btn(W / 2 + 12, H / 2 + 30, 90, "Cancel", 0, act, 10)
        Btn(W / 2 + 106, H / 2 + 30, 90, ask.ok, if(ask.danger, 2, 1), ask_ok, 0)
    }
    on change ask.gen { focus askin }

    // ── a name that is taken ──
    group {
        show: cf.on
        zone box cfcatch { from: 0, 0; size: W, H; active: cf.on }
        box { from: 0, 0; size: W, H; corner: 22 * rr; color: deep; opacity: 45% }
        Pane(W / 2 - 250, H / 2 - 105, 500, 210, 18, 0.96)
        zone box cfbox { from: W / 2 - 250, H / 2 - 105; size: 500, 210 }
        text "Already there" { at: W / 2 - 226, H / 2 - 76; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk" }
        text cf.msg { at: W / 2 - 226, H / 2 - 52; anchor: left top; size: 13.5; weight: 500; color: ink; opacity: 85%; width: 452; lines: 3; family: "Space Grotesk" }
        prop cah = 0 ~quick
        follow cah = cfall.hover
        box { from: W / 2 - 226, H / 2 + 6; size: 20, 20; corner: 6 * rr; color: mix(ink, mint, if(cf.all, 1, 0)); opacity: 12% + 10% * cah + 60% * if(cf.all, 1, 0) }
        PGlyphS35(W / 2 - 216, H / 2 + 16, 0.5, 35, if(cf.all, 1, 0))
        text "Do the same for the others" { at: W / 2 - 196, H / 2 + 16; anchor: left center; size: 13; weight: 500; color: ink; family: "Space Grotesk" }
        zone box cfall { from: W / 2 - 230, H / 2 + 2; size: 260, 28; corner: 8 * rr; cursor: pointer; label: "Do the same for the others"; role: toggle; checked: cf.all }
        on press cfall { emit cf_pick(9) }
        Btn(W / 2 - 226, H / 2 + 54, 92, "Stop", 0, cf_pick, 0)
        Btn(W / 2 - 126, H / 2 + 54, 92, "Skip", 0, cf_pick, 1)
        Btn(W / 2 - 26, H / 2 + 54, 120, "Keep both", 0, cf_pick, 2)
        Btn(W / 2 + 102, H / 2 + 54, 124, "Replace", 2, cf_pick, 3)
    }

    // ── a list to choose from ──
    let pkh = 100 + picks.count * 42
    group {
        show: pick.on
        zone box pkcatch { from: 0, 0; size: W, H; active: pick.on }
        on press pkcatch { emit act(10) }
        box { from: 0, 0; size: W, H; corner: 22 * rr; color: deep; opacity: 45% }
        Pane(W / 2 - 220, H / 2 - pkh / 2, 440, pkh, 18, 0.96)
        zone box pkbox { from: W / 2 - 220, H / 2 - pkh / 2; size: 440, pkh }
        text pick.title { at: W / 2 - 196, H / 2 - pkh / 2 + 30; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk" }
        column pkc {
            at: W / 2 - 206, H / 2 - pkh / 2 + 56
            gap: 0
            for k in picks {
                group {
                    size: 412, 42
                    prop kh = 0 ~quick
                    follow kh = kz.hover
                    box { from: 0, 1; size: 412, 40; corner: 11 * rr; color: mint; opacity: 16% * kh }
                    box { from: 0, 1; size: 412, 40; corner: 11 * rr; stroke: 1; color: mint; opacity: 40% * kh }
                    PGlyphSP(24, 21, 0.78, k.ic, 1)
                    text k.label { at: 50, if(k.hs, 14, 21); anchor: left center; size: 13.5; weight: 600; color: ink; width: 346; lines: 1; family: "Space Grotesk" }
                    text k.sub { at: 50, 30; anchor: left center; size: 11; weight: 500; color: faint; width: 346; lines: 1; show: k.hs; family: "Space Grotesk" }
                    zone box kz { from: 0, 1; size: 412, 40; corner: 11 * rr; cursor: pointer; label: "{k.label}" }
                    on press kz { emit pick_ok(k.at) }
                }
            }
        }
        Btn(W / 2 + 106, H / 2 + pkh / 2 - 50, 90, "Cancel", 0, act, 10)
    }

    // ── the right-click menu ──
    //  It springs out of the pointer the way the shell's drawers do (a little smaller and faint to start), in the same glass, with each action's pencil picture, the key that does it on the right,
    //  a line between groups, and the one that puts something away in the alert colour. The logic fills `menuitems` and says how tall it is (`menu.h`).
    prop mo = 0 ~calm
    follow mo = if(menu.on, 1, 0)
    let mpx = clamp(menu.x, 8, W - 284)
    let mpy = clamp(menu.y, 8, H - menu.h - 8)
    let mrh = 32                        // how tall a line is (the logic adds them up with this number)
    group {
        show: mo > 0.01
        pivot: mpx, mpy
        scale: 0.9 + 0.1 * mo
        opacity: mo
        zone box menucatch { from: 0, 0; size: W, H; active: menu.on }
        on press menucatch { emit menu_close }
        on press right menucatch { emit menu_close }
        Pane(mpx, mpy, 268, menu.h, 16, 0.6)
        column menuc {
            at: mpx + 7, mpy + 7
            gap: 0
            for m in menuitems {
                group {
                    size: 254, mrh + if(m.sep, 9, 0)
                    prop mh = 0 ~quick
                    follow mh = mz.hover
                    box { from: 14, 4; size: 226, 1; color: ink; opacity: 10%; show: m.sep }
                    box { from: 0, if(m.sep, 10, 1); size: 254, mrh - 2; corner: 11 * rr; color: if(m.danger, alert, mint); opacity: 18% * mh }
                    box { from: 0, if(m.sep, 10, 1); size: 254, mrh - 2; corner: 11 * rr; stroke: 1; color: if(m.danger, alert, mint); opacity: 40% * mh }
                    PGlyphSM(25, if(m.sep, 10, 1) + mrh / 2 - 1, 0.74, m.ic, if(m.on, 1, 0.35))
                    text m.label { at: 50, if(m.sep, 10, 1) + mrh / 2 - 1; anchor: left center; size: 13.5; weight: 600; color: if(m.danger, mix(ink, alert, 0.55 + 0.45 * mh), ink); opacity: if(m.on, 100%, 38%); family: "Space Grotesk" }
                    text m.key { at: 242, if(m.sep, 10, 1) + mrh / 2 - 1; anchor: right center; size: 11.5; weight: 500; color: faint; opacity: if(m.on, 75%, 30%); show: not m.chk; family: "Space Grotesk" }
                    group { show: m.chk; PGlyphS35(230, if(m.sep, 10, 1) + mrh / 2 - 1, 0.55, 35, 1) }
                    zone box mz { from: 0, if(m.sep, 10, 1); size: 254, mrh - 2; corner: 11 * rr; cursor: pointer; active: m.on and menu.on; label: "{m.label}" }
                    on press mz { emit act(m.k) }
                    on leave mz { pen = 0 }
                    on enter mz { pen = 1 }
                    on hover mz for 80ms { pen = 1 }
                }
            }
        }
    }

    // ── the properties card ──
    //  What a file is: its picture, its name and what it is, then a line for each thing about it (the logic fills `pinfo` and `prows` and says how tall the card is, `prop.h`). A line can have a button.
    prop po = 0 ~calm
    follow po = if(prop.on, 1, 0)
    let ppx = W / 2 - 236
    let ppy = H / 2 - prop.h / 2
    group {
        show: po > 0.01
        pivot: W / 2, H / 2
        scale: 0.94 + 0.06 * po
        opacity: po
        zone box propcatch { from: 0, 0; size: W, H; active: prop.on }
        on press propcatch { emit act(10) }
        box { from: 0, 0; size: W, H; corner: 22 * rr; color: deep; opacity: 45% }
        Pane(ppx, ppy, 472, prop.h, 20, 0.6)
        zone box propbox { from: ppx, ppy; size: 472, prop.h }
        for i in pinfo {
            group {
                group { show: not i.has.thumb; PFile(ppx + 52, ppy + 52, 1, i.ik, 0, 1) }
                group {
                    show: i.has.thumb
                    body {
                        color: deep
                        rim: 14%
                        box { from: ppx + 20, ppy + 22; size: 64, 48; corner: 8 * rr }
                    }
                    clip box { from: ppx + 20, ppy + 22; size: 64, 48; corner: 8 * rr }
                    image i.thumb { at: ppx + 20, ppy + 22; size: 64, 48 }
                }
                text i.name { at: ppx + 102, ppy + 38; anchor: left center; size: 18; weight: 700; color: ink; width: 346; lines: 1; family: "Space Grotesk" }
                text i.sub { at: ppx + 102, ppy + 62; anchor: left center; size: 12.5; weight: 500; color: faint; width: 346; lines: 1; family: "Space Grotesk" }
            }
        }
        box { from: ppx + 22, ppy + 90; size: 428, 1; color: ink; opacity: 10% }
        column prc {
            at: ppx + 22, ppy + 100
            gap: 0
            for r in prows {
                group {
                    size: 428, 30
                    text r.label { at: 2, 15; anchor: left center; size: 12.5; weight: 500; color: faint; family: "Space Grotesk" }
                    text r.value { at: 112, 15; anchor: left center; size: 13; weight: 500; color: ink; width: if(r.hb, 214, 316); lines: 1; show: not r.tog; family: "Space Grotesk" }
                    // A row with a switch: Hidden (a name that starts with a dot).
                    group {
                        show: r.tog
                        prop tg = 0 ~quick
                        follow tg = if(r.on, 1, 0)
                        box { from: 112, 3; size: 46, 24; corner: 12 * rr; color: mix(ink, mint, tg); opacity: 20% + 60% * tg }
                        ellipse { at: 124 + 22 * tg, 15; radius: 8.5; color: mix(ink, onmint, 0.5 * tg) }
                        text r.value { at: 170, 15; anchor: left center; size: 13; weight: 500; color: ink; width: 258; lines: 1; family: "Space Grotesk" }
                        zone box tz { from: 108, 1; size: 150, 28; corner: 10 * rr; cursor: pointer; active: r.tog and prop.on; label: "{r.label}" }
                        on press tz { emit prop_act(r.k) }
                    }
                    // A row with a button: change the program that opens it, count its checksum.
                    group {
                        show: r.hb
                        prop bh3 = 0 ~quick
                        follow bh3 = bz3.hover
                        box { from: 330, 2; size: 98, 26; corner: 9 * rr; color: mint; opacity: 14% + 16% * bh3 }
                        text r.btn { at: 379, 15; anchor: center; size: 12; weight: 600; color: ink; family: "Space Grotesk" }
                        zone box bz3 { from: 330, 2; size: 98, 26; corner: 9 * rr; cursor: pointer; active: r.hb and prop.on; label: "{r.btn}" }
                        on press bz3 { emit prop_act(r.k) }
                    }
                }
            }
        }
        //  Who may do what: nine little switches (the numbers in the logic go from the owner's reading, 256, to everybody's executing, 1).
        group {
            show: pm.on
            let pmy = ppy + prop.h - 54 - 98
            text "Permissions" { at: ppx + 24, pmy + 11; anchor: left center; size: 12.5; weight: 500; color: faint; family: "Space Grotesk" }
            text "Owner" { at: ppx + 112, pmy + 11; anchor: left center; size: 12.5; weight: 500; color: ink; family: "Space Grotesk" }
            text "Group" { at: ppx + 112, pmy + 39; anchor: left center; size: 12.5; weight: 500; color: ink; family: "Space Grotesk" }
            text "Others" { at: ppx + 112, pmy + 67; anchor: left center; size: 12.5; weight: 500; color: ink; family: "Space Grotesk" }
            repeat i in 0..9 {
                Tog(ppx + 190 + mod(i, 3) * 34, pmy + floor(i / 3) * 28, mod(floor(pm.bits / pick(i, 256, 128, 64, 32, 16, 8, 4, 2, 1)), 2), pick(mod(i, 3), "r", "w", "x"), 8 - i)
            }
        }
        Btn(ppx + 472 - 22 - 96, ppy + prop.h - 54, 96, "Close", 1, act, 10)
    }

    // ── a look at a file ──
    prop pvo = 0 ~calm
    follow pvo = if(pv.on, 1, 0)
    let pvw = min(W - 60, 800)
    let pvh = min(H - 40, 640)
    let pvx = (W - pvw) / 2
    let pvy = (H - pvh) / 2
    let pvfit = min(pvw - 40, (pvh - 130) * 1.5625)
    image pvimg = from pv.path, 1000, 640
    group {
        show: pvo > 0.01
        pivot: W / 2, H / 2
        scale: 0.96 + 0.04 * pvo
        opacity: pvo
        zone box pvcatch { from: 0, 0; size: W, H; active: pv.on }
        on press pvcatch { emit act(10) }
        box { from: 0, 0; size: W, H; corner: 22 * rr; color: deep; opacity: 55% }
        Pane(pvx, pvy, pvw, pvh, 20, 0.7)
        zone box pvbox { from: pvx, pvy; size: pvw, pvh }
        text pv.name { at: pvx + 24, pvy + 28; anchor: left center; size: 16; weight: 700; color: ink; width: pvw - 120; lines: 1; family: "Space Grotesk" }
        text pv.sub { at: pvx + 24, pvy + 50; anchor: left center; size: 12; weight: 500; color: faint; width: pvw - 120; lines: 1; family: "Space Grotesk" }
        text "{pv.n} / {pv.of}" { at: pvx + pvw - 24, pvy + 28; anchor: right center; size: 12; weight: 600; color: faint; show: pv.of > 1; family: "Space Grotesk" }
        group {
            show: pv.kind == 1
            image pvimg { at: pvx + (pvw - pvfit) / 2, pvy + 68; size: pvfit, pvfit / 1.5625 }
        }
        text pv.text { at: pvx + 26, pvy + 76; anchor: left top; size: 12.5; weight: 500; color: ink; width: pvw - 52; lines: 26; line_height: 1.25; show: pv.kind == 2; family: "monospace" }
        text "← →  other files      Enter  open      Space or Esc  close" { at: pvx + pvw / 2, pvy + pvh - 24; anchor: center; size: 11.5; weight: 500; color: faint; show: not slim; family: "Space Grotesk" }
    }
}
