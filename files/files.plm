                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -6 * s + j * sin(fr * 44 + 204), -9 * s + j * sin(fr * 72 + 918); line 5 * s + j * sin(fr * 42 + 1201), 0 * s + j * sin(fr * 52 + 1193); line -6 * s + j * sin(fr * 42 + 1781), 9 * s + j * sin(fr * 43 + 3626) }
            }
