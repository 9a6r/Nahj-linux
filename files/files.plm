    //  The same pictures, still (no trembling): for the menus, where a copy of the boiling one for every line would be a long scene to load.
    component PGlyphS(cx: number, cy: number, s: number, g: number, o: number) {
        let a = 0
        let fr = 0
        let j = 0.3 * (0.5 + s)
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
