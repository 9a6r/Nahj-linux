            pivot: cx, cy
            group {
                show: g == 0
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move 6 * s + j * sin(fr * 64 + 4316), -9 * s + j * sin(fr * 46 + 3667); line -5 * s + j * sin(fr * 51 + 735), 0 * s + j * sin(fr * 41 + 2243); line 6 * s + j * sin(fr * 72 + 1023), 9 * s + j * sin(fr * 43 + 2031) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 6 * s + j * sin(fr * 60 + 1620), -9 * s + j * sin(fr * 58 + 4019); line -5 * s + j * sin(fr * 72 + 3788), 0 * s + j * sin(fr * 63 + 1755); line 6 * s + j * sin(fr * 42 + 370), 9 * s + j * sin(fr * 62 + 459) }
            }
