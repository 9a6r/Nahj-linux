    //  A toolbar button's picture (`g`): back, forward, up, tiles, lines, hidden files, new folder, close. `hot` swells it, turns it to the accent and redraws it, like the shell's own.
    component PGlyph(cx: number, cy: number, s: number, g: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let j = (0.3 + 0.4 * a) * (0.5 + s)
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
            scale: 1 + 0.08 * a
            group {
                show: g == 0
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move 6 * s + j * sin(fr * 60 + 3663), -9 * s + j * sin(fr * 44 + 4366); line -5 * s + j * sin(fr * 66 + 1856), 0 * s + j * sin(fr * 56 + 337); line 6 * s + j * sin(fr * 62 + 3368), 9 * s + j * sin(fr * 45 + 1873) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 6 * s + j * sin(fr * 63 + 4153), -9 * s + j * sin(fr * 63 + 288); line -5 * s + j * sin(fr * 66 + 4897), 0 * s + j * sin(fr * 58 + 1391); line 6 * s + j * sin(fr * 66 + 3260), 9 * s + j * sin(fr * 74 + 1088) }
            }
            group {
                show: g == 1
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -6 * s + j * sin(fr * 59 + 1812), -9 * s + j * sin(fr * 55 + 710); line 5 * s + j * sin(fr * 69 + 768), 0 * s + j * sin(fr * 57 + 1916); line -6 * s + j * sin(fr * 41 + 4129), 9 * s + j * sin(fr * 57 + 3870) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -6 * s + j * sin(fr * 68 + 3733), -9 * s + j * sin(fr * 64 + 1693); line 5 * s + j * sin(fr * 75 + 4353), 0 * s + j * sin(fr * 65 + 4745); line -6 * s + j * sin(fr * 44 + 4504), 9 * s + j * sin(fr * 40 + 2625) }
            }
            group {
                show: g == 2
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -9 * s + j * sin(fr * 57 + 714), 5 * s + j * sin(fr * 73 + 3630); line 0 * s + j * sin(fr * 44 + 1988), -6 * s + j * sin(fr * 56 + 475); line 9 * s + j * sin(fr * 67 + 2672), 5 * s + j * sin(fr * 67 + 1965) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -9 * s + j * sin(fr * 46 + 2315), 5 * s + j * sin(fr * 52 + 4878); line 0 * s + j * sin(fr * 63 + 2359), -6 * s + j * sin(fr * 65 + 1006); line 9 * s + j * sin(fr * 72 + 595), 5 * s + j * sin(fr * 68 + 2966) }
            }
            group {
                show: g == 3
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -10 * s + j * sin(fr * 64 + 3690), -10 * s + j * sin(fr * 74 + 1025); line -2 * s + j * sin(fr * 71 + 1291), -10 * s + j * sin(fr * 57 + 3277); line -2 * s + j * sin(fr * 65 + 2525), -2 * s + j * sin(fr * 44 + 1496); line -10 * s + j * sin(fr * 49 + 204), -2 * s + j * sin(fr * 51 + 4196); line -10 * s + j * sin(fr * 57 + 4588), -11 * s + j * sin(fr * 61 + 1151) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -10 * s + j * sin(fr * 61 + 4630), -10 * s + j * sin(fr * 41 + 1387); line -2 * s + j * sin(fr * 63 + 3916), -10 * s + j * sin(fr * 68 + 4479); line -2 * s + j * sin(fr * 44 + 4083), -2 * s + j * sin(fr * 64 + 4334); line -10 * s + j * sin(fr * 72 + 4143), -2 * s + j * sin(fr * 72 + 2177); line -10 * s + j * sin(fr * 76 + 4809), -11 * s + j * sin(fr * 65 + 1083) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move 2 * s + j * sin(fr * 71 + 4965), -10 * s + j * sin(fr * 69 + 4531); line 10 * s + j * sin(fr * 62 + 2692), -10 * s + j * sin(fr * 71 + 2876); line 10 * s + j * sin(fr * 66 + 3613), -2 * s + j * sin(fr * 40 + 3148); line 2 * s + j * sin(fr * 63 + 2488), -2 * s + j * sin(fr * 73 + 1664); line 2 * s + j * sin(fr * 66 + 4100), -11 * s + j * sin(fr * 43 + 4529) }
