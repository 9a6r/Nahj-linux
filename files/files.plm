                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -4 * s + j * sin(fr * 57 + 2122), 6 * s + j * sin(fr * 47 + 1978); line 2 * s + j * sin(fr * 60 + 3971), 6 * s + j * sin(fr * 70 + 1352) }
            }
            group {
                show: g == 13
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -9 * s + j * sin(fr * 46 + 215), -6 * s + j * sin(fr * 75 + 2097); line 9 * s + j * sin(fr * 61 + 3789), -6 * s + j * sin(fr * 76 + 4814) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -9 * s + j * sin(fr * 65 + 1096), -6 * s + j * sin(fr * 60 + 1686); line 9 * s + j * sin(fr * 43 + 2883), -6 * s + j * sin(fr * 63 + 1274) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -3 * s + j * sin(fr * 47 + 934), -6 * s + j * sin(fr * 45 + 1023); line -3 * s + j * sin(fr * 66 + 4275), -10 * s + j * sin(fr * 71 + 1247); line 3 * s + j * sin(fr * 75 + 2779), -10 * s + j * sin(fr * 56 + 387); line 3 * s + j * sin(fr * 46 + 2726), -6 * s + j * sin(fr * 66 + 3876) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -3 * s + j * sin(fr * 51 + 966), -6 * s + j * sin(fr * 67 + 1004); line -3 * s + j * sin(fr * 44 + 1614), -10 * s + j * sin(fr * 46 + 1045); line 3 * s + j * sin(fr * 65 + 4608), -10 * s + j * sin(fr * 56 + 2424); line 3 * s + j * sin(fr * 62 + 2952), -6 * s + j * sin(fr * 75 + 2191) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -7 * s + j * sin(fr * 44 + 2806), -6 * s + j * sin(fr * 71 + 540); line -6 * s + j * sin(fr * 73 + 1649), 10 * s + j * sin(fr * 57 + 337); line 6 * s + j * sin(fr * 74 + 1899), 10 * s + j * sin(fr * 59 + 1905); line 7 * s + j * sin(fr * 59 + 625), -6 * s + j * sin(fr * 46 + 4946) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -7 * s + j * sin(fr * 40 + 4106), -6 * s + j * sin(fr * 41 + 652); line -6 * s + j * sin(fr * 56 + 4022), 10 * s + j * sin(fr * 74 + 2246); line 6 * s + j * sin(fr * 48 + 378), 10 * s + j * sin(fr * 58 + 351); line 7 * s + j * sin(fr * 58 + 4939), -6 * s + j * sin(fr * 44 + 4390) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -2.5 * s + j * sin(fr * 41 + 2920), -2 * s + j * sin(fr * 54 + 2871); line -2.5 * s + j * sin(fr * 42 + 631), 6 * s + j * sin(fr * 76 + 951) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -2.5 * s + j * sin(fr * 64 + 2684), -2 * s + j * sin(fr * 49 + 581); line -2.5 * s + j * sin(fr * 42 + 2124), 6 * s + j * sin(fr * 58 + 3374) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move 2.5 * s + j * sin(fr * 73 + 2344), -2 * s + j * sin(fr * 49 + 118); line 2.5 * s + j * sin(fr * 52 + 2648), 6 * s + j * sin(fr * 42 + 3869) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 2.5 * s + j * sin(fr * 64 + 2441), -2 * s + j * sin(fr * 46 + 3080); line 2.5 * s + j * sin(fr * 48 + 2550), 6 * s + j * sin(fr * 70 + 3819) }
            }
            group {
                show: g == 14
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -10 * s + j * sin(fr * 41 + 2847), -4 * s + j * sin(fr * 54 + 1992); line -10 * s + j * sin(fr * 64 + 2799), -10 * s + j * sin(fr * 64 + 1295); line -4 * s + j * sin(fr * 43 + 589), -10 * s + j * sin(fr * 47 + 885) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -10 * s + j * sin(fr * 41 + 4632), -4 * s + j * sin(fr * 68 + 2750); line -10 * s + j * sin(fr * 54 + 454), -10 * s + j * sin(fr * 71 + 197); line -4 * s + j * sin(fr * 40 + 1030), -10 * s + j * sin(fr * 62 + 1866) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move 4 * s + j * sin(fr * 71 + 900), -10 * s + j * sin(fr * 40 + 888); line 10 * s + j * sin(fr * 68 + 1188), -10 * s + j * sin(fr * 70 + 1114); line 10 * s + j * sin(fr * 69 + 1481), -4 * s + j * sin(fr * 48 + 2578) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 4 * s + j * sin(fr * 60 + 4869), -10 * s + j * sin(fr * 76 + 2422); line 10 * s + j * sin(fr * 76 + 560), -10 * s + j * sin(fr * 57 + 3164); line 10 * s + j * sin(fr * 49 + 4756), -4 * s + j * sin(fr * 55 + 821) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move 10 * s + j * sin(fr * 52 + 851), 4 * s + j * sin(fr * 52 + 4807); line 10 * s + j * sin(fr * 41 + 141), 10 * s + j * sin(fr * 49 + 3600); line 4 * s + j * sin(fr * 57 + 2296), 10 * s + j * sin(fr * 42 + 4700) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 10 * s + j * sin(fr * 47 + 4380), 4 * s + j * sin(fr * 67 + 2802); line 10 * s + j * sin(fr * 53 + 3328), 10 * s + j * sin(fr * 42 + 3216); line 4 * s + j * sin(fr * 65 + 1062), 10 * s + j * sin(fr * 53 + 1544) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -4 * s + j * sin(fr * 57 + 3210), 10 * s + j * sin(fr * 62 + 3512); line -10 * s + j * sin(fr * 71 + 4799), 10 * s + j * sin(fr * 63 + 911); line -10 * s + j * sin(fr * 69 + 4732), 4 * s + j * sin(fr * 57 + 3566) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -4 * s + j * sin(fr * 58 + 2092), 10 * s + j * sin(fr * 48 + 1008); line -10 * s + j * sin(fr * 42 + 4186), 10 * s + j * sin(fr * 69 + 1150); line -10 * s + j * sin(fr * 60 + 4068), 4 * s + j * sin(fr * 60 + 3093) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -4 * s + j * sin(fr * 42 + 578), 0 * s + j * sin(fr * 42 + 4602); line -1 * s + j * sin(fr * 55 + 404), 4 * s + j * sin(fr * 53 + 2472); line 5 * s + j * sin(fr * 63 + 2337), -4 * s + j * sin(fr * 76 + 1894) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -4 * s + j * sin(fr * 61 + 1336), 0 * s + j * sin(fr * 68 + 2913); line -1 * s + j * sin(fr * 42 + 4121), 4 * s + j * sin(fr * 69 + 3746); line 5 * s + j * sin(fr * 52 + 4950), -4 * s + j * sin(fr * 57 + 2353) }
            }
            group {
                show: g == 15
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move 5.1 * s + j * sin(fr * 41 + 3049), -6.1 * s + j * sin(fr * 47 + 2539); line 7.5 * s + j * sin(fr * 53 + 4300), -2.7 * s + j * sin(fr * 46 + 2884); line 7.9 * s + j * sin(fr * 76 + 3410), 1.4 * s + j * sin(fr * 57 + 716); line 6.1 * s + j * sin(fr * 42 + 1640), 5.1 * s + j * sin(fr * 57 + 391); line 2.7 * s + j * sin(fr * 70 + 2844), 7.5 * s + j * sin(fr * 46 + 1456); line -1.4 * s + j * sin(fr * 49 + 4641), 7.9 * s + j * sin(fr * 41 + 4427); line -5.1 * s + j * sin(fr * 61 + 3632), 6.1 * s + j * sin(fr * 43 + 2038); line -7.5 * s + j * sin(fr * 64 + 2046), 2.7 * s + j * sin(fr * 58 + 3108); line -7.9 * s + j * sin(fr * 58 + 3629), -1.4 * s + j * sin(fr * 49 + 3475); line -6.1 * s + j * sin(fr * 72 + 2859), -5.1 * s + j * sin(fr * 69 + 1147); line -2.7 * s + j * sin(fr * 47 + 1809), -7.5 * s + j * sin(fr * 43 + 3160) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 5.1 * s + j * sin(fr * 46 + 3608), -6.1 * s + j * sin(fr * 47 + 3434); line 7.5 * s + j * sin(fr * 69 + 3199), -2.7 * s + j * sin(fr * 61 + 153); line 7.9 * s + j * sin(fr * 61 + 1284), 1.4 * s + j * sin(fr * 66 + 2803); line 6.1 * s + j * sin(fr * 45 + 3703), 5.1 * s + j * sin(fr * 43 + 1925); line 2.7 * s + j * sin(fr * 55 + 3592), 7.5 * s + j * sin(fr * 76 + 3313); line -1.4 * s + j * sin(fr * 62 + 1684), 7.9 * s + j * sin(fr * 73 + 3351); line -5.1 * s + j * sin(fr * 59 + 4616), 6.1 * s + j * sin(fr * 48 + 1666); line -7.5 * s + j * sin(fr * 70 + 3576), 2.7 * s + j * sin(fr * 73 + 2808); line -7.9 * s + j * sin(fr * 74 + 1862), -1.4 * s + j * sin(fr * 58 + 1191); line -6.1 * s + j * sin(fr * 71 + 2855), -5.1 * s + j * sin(fr * 63 + 3301); line -2.7 * s + j * sin(fr * 42 + 1800), -7.5 * s + j * sin(fr * 56 + 4914) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -2.7 * s + j * sin(fr * 66 + 402), -7.5 * s + j * sin(fr * 50 + 1833); line -7.7 * s + j * sin(fr * 71 + 1342), -8.5 * s + j * sin(fr * 64 + 716); line -4.7 * s + j * sin(fr * 55 + 946), -2.5 * s + j * sin(fr * 70 + 4497) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -2.7 * s + j * sin(fr * 60 + 4080), -7.5 * s + j * sin(fr * 44 + 476); line -7.7 * s + j * sin(fr * 56 + 1477), -8.5 * s + j * sin(fr * 56 + 1068); line -4.7 * s + j * sin(fr * 74 + 4306), -2.5 * s + j * sin(fr * 57 + 4105) }
            }
            group {
                show: g == 16
                ellipse { at: cx + 0 * s + j * sin(fr * 73 + 3145), cy + 0 * s + j * sin(fr * 61 + 1499); radius: 10.5 * s * (1 + 0.05 * sin(fr * 47 + 1823)); stroke: w1; color: mix(ink, mint, a); opacity: (o) }
                ellipse { at: cx + 0 * s + j * sin(fr * 48 + 4449) + off, cy + 0 * s + j * sin(fr * 61 + 1639) + off; radius: 10.5 * s; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28 }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move 0 * s + j * sin(fr * 61 + 4880), -5 * s + j * sin(fr * 72 + 1706); line 0 * s + j * sin(fr * 51 + 1251), -4 * s + j * sin(fr * 64 + 1858) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 0 * s + j * sin(fr * 46 + 529), -5 * s + j * sin(fr * 61 + 923); line 0 * s + j * sin(fr * 44 + 3735), -4 * s + j * sin(fr * 40 + 1236) }
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move 0 * s + j * sin(fr * 69 + 4079), -0.5 * s + j * sin(fr * 62 + 1256); line 0 * s + j * sin(fr * 45 + 3468), 6 * s + j * sin(fr * 50 + 836) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 0 * s + j * sin(fr * 57 + 2251), -0.5 * s + j * sin(fr * 66 + 900); line 0 * s + j * sin(fr * 54 + 2401), 6 * s + j * sin(fr * 53 + 4859) }
            }
        }
    }
    // <<< icons

    //  A picture's own picture, drawn in pencil: the picture clipped to a hand-drawn rectangle (the corners a little off, the sides a little bowed, a different one for each place it is
    //  drawn), with its outline in two pencil strokes on top, that boil about five times a second under the pointer. The picture goes in as its child. `hot` is the hover.
    component PThumb(x: number, y: number, w: number, h: number, hot: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let jb = 1.2 * a
        group {
            clip path { at: x, y; move 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 0.0), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 2.3); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 4.6), -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 6.9); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 9.2), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 11.5); line w + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 13.8), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 16.1); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 18.4), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 20.7); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 23.0), h + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 25.3); line 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 27.6), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 29.9); line -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 32.2), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 34.5); close }
            path { at: x, y; color: deep; opacity: 70%; move 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 0.0), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 2.3); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 4.6), -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 6.9); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 9.2), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 11.5); line w + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 13.8), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 16.1); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 18.4), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 20.7); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 23.0), h + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 25.3); line 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 27.6), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 29.9); line -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 32.2), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 34.5); close }
            children
        }
        path { at: x, y; stroke: 1.6; color: ink; opacity: 85%; move 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 0.0) + jb * sin(fr * 47 + 1000), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 2.3) + jb * sin(fr * 61 + 2000); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 4.6) + jb * sin(fr * 50 + 1311), -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 6.9) + jb * sin(fr * 63 + 2277); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 9.2) + jb * sin(fr * 53 + 1622), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 11.5) + jb * sin(fr * 65 + 2554); line w + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 13.8) + jb * sin(fr * 56 + 1933), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 16.1) + jb * sin(fr * 67 + 2831); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 18.4) + jb * sin(fr * 59 + 2244), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 20.7) + jb * sin(fr * 69 + 3108); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 23.0) + jb * sin(fr * 62 + 2555), h + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 25.3) + jb * sin(fr * 71 + 3385); line 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 27.6) + jb * sin(fr * 65 + 2866), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 29.9) + jb * sin(fr * 73 + 3662); line -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 32.2) + jb * sin(fr * 68 + 3177), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 34.5) + jb * sin(fr * 75 + 3939); close }
        path { at: x + 0.6, y + 0.6; stroke: 1.0; color: ink; opacity: 25% * a; move 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 0.0) + jb * sin(fr * 47 + 1000), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 2.3) + jb * sin(fr * 61 + 2000); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 4.6) + jb * sin(fr * 50 + 1311), -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 6.9) + jb * sin(fr * 63 + 2277); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 9.2) + jb * sin(fr * 53 + 1622), 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 11.5) + jb * sin(fr * 65 + 2554); line w + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 13.8) + jb * sin(fr * 56 + 1933), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 16.1) + jb * sin(fr * 67 + 2831); line w + 3.2 * a * sin(x * 0.37 + y * 0.91 + 18.4) + jb * sin(fr * 59 + 2244), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 20.7) + jb * sin(fr * 69 + 3108); line w * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 23.0) + jb * sin(fr * 62 + 2555), h + a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 25.3) + jb * sin(fr * 71 + 3385); line 0 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 27.6) + jb * sin(fr * 65 + 2866), h + 3.2 * a * sin(x * 0.37 + y * 0.91 + 29.9) + jb * sin(fr * 73 + 3662); line -a + 3.2 * a * sin(x * 0.37 + y * 0.91 + 32.2) + jb * sin(fr * 68 + 3177), h * 0.5 + 3.2 * a * sin(x * 0.37 + y * 0.91 + 34.5) + jb * sin(fr * 75 + 3939); close }
    }

    // ── the shape of the window ──
    let W = screen.width
    let H = screen.height
    let slim = W < 720
    let side = if(slim, 60, 212)         // the places: only their pictures when it is narrow
    let tb = 60                          // the toolbar
    let sbh = 30                         // the bar under the folder
    let mx = side + 14
    let mw = W - side - 28
    let my = tb + 8
    let mh = H - my - sbh - 8
    let tile.w = 128
    let tile.h = if(view == grid, 132, 38)
    let lpr = 12                         // in the lines, a row of the model is a block of this many lines, one under the other (so the model stays small)
    let row.h = if(view == grid, 132, 38 * lpr)
    let cols.now = if(view == grid, max(floor(mw / tile.w), 1), 1)
    on change cols.now { emit set_cols(cols.now) }
    on change view { emit set_cols(cols.now) }
    let pill.w = W - side - 126 - 254
    on change ready { emit set_cols(cols.now); vh = mh; crumbw = pill.w - 40 }
    on change mh { vh = mh }
    on change pill.w { crumbw = pill.w - 40 }
    on focus { emit focused }

    // ── the glass ──
    body {
        color: tint
        glass: 1
        lens: false
        rim: 60%
        shine: 0, 0
        opacity: 90% * (1 - ob)
        show: ob < 0.996
        box { from: 0, 0; size: W, H; corner: 22 * rr }
    }
    body {
        color: mix(mix(mix(tint, #000000, 0.7), ink, 0.3), tint, pl)
        rim: 0%
        border: (2 + 1.2 * uk) * pl, deep
        opacity: ob
        show: ob > 0.004
        box { from: 0, 0; size: W, H; corner: 22 * rr }
    }
    //  The places lie on it a little darker, and the folder sits in a hollow of its own.
    box { from: 0, 0; size: side, H; corner: 22 * rr; color: panel; opacity: 30% }
    box { from: side - 24, 0; size: 24, H; color: tint; opacity: 0 }
    box { from: side, 14; size: 1, H - 28; color: ink; opacity: 8% }
    box { from: mx - 6, my - 4; size: mw + 12, mh + 6; corner: 14 * rr; color: deep; opacity: 24% }

    // ── the places ──
    group {
        PFile(if(slim, 30, 34), 31, 0.42, 0, 0, 1)
        text "Files" { at: 58, 31; anchor: left center; size: 17; weight: 700; color: ink; show: not slim; family: "Space Grotesk" }
        column placelist {
            at: 8, 72
            gap: 2
            for p in places {
                group {
                    size: side - 16, 38
                    prop hv = 0 ~quick
                    follow hv = pz.hover
                    box { from: 0, 0; size: side - 16, 36; corner: 11 * rr; color: mix(ink, mint, if(p.here, 1, 0)); opacity: 8% * hv + if(p.here, 20%, 0%) }
                    box { from: 0, 0; size: side - 16, 36; corner: 11 * rr; stroke: 1.2; color: mint; opacity: if(p.here, 55%, 0%) }
                    PPlace(if(slim, 22, 22), 18, 0.42, p.pk, 1)
                    text p.name { at: 46, 18; anchor: left center; size: 13.5; weight: 600; width: side - 70; lines: 1; color: ink; show: not slim; family: "Space Grotesk" }
                    zone box pz { from: 0, 0; size: side - 16, 36; corner: 11 * rr; cursor: pointer; label: "{p.name}"; role: item }
                    on press pz { emit place(p.at) }
                    on press right pz { menu.x = pointer.x; menu.y = pointer.y; emit place_menu(p.at) }
                    on drop pz { emit dropped(-100 - p.at) }
                    on leave pz { pen = 0 }
                    on enter pz { pen = 1 }
                    on hover pz for 80ms { pen = 1 }
                }
            }
        }
    }

    //  Under the places: drop a folder there to pin it to them. It lights up while something is being carried over the window.
    let pin.y = 72 + places.count * 38 + 10
    zone box pinzone { from: 8, pin.y; size: side - 16, max(H - pin.y - 52, 40); corner: 12 * rr; label: "Drop a folder here to pin it"; role: region }
    on drop pinzone { emit dropped(-400) }
    //  (Only while the pointer is over it: a hint that shows whenever anything is carried over the window is a hint where you are not going.)
    prop pinh = 0 ~quick
    follow pinh = if(drag.over > 0.5, pinzone.hover, 0)
    group {
        show: pinh > 0.01 and H - pin.y - 52 > 40
        opacity: pinh
        box { from: 8, pin.y; size: side - 16, max(H - pin.y - 52, 40); corner: 12 * rr; stroke: 1.4; color: mint; opacity: 55% }
        box { from: 8, pin.y; size: side - 16, max(H - pin.y - 52, 40); corner: 12 * rr; color: mint; opacity: 8% }
        text "Drop a folder here to pin it" { at: side / 2, pin.y + 24; anchor: center; width: side - 40; lines: 2; align: center; size: 12.5; weight: 600; color: mint; show: not slim; family: "Space Grotesk" }
        PGlyph(side / 2, pin.y + if(slim, 24, 62), 1, 6, 0, if(slim, 1, 0.7))
    }

    // ── the toolbar: back, forward, up, where you are, how it looks ──
    repeat i in 0..8 {
        let bx = pick(i, side + 28, side + 66, side + 104, W - 196, W - 158, W - 112, W - 70, W - 28)
        let on = pick(i, can.back, can.fwd, 1, 1, 1, 1, 1, 1)
        let sel = pick(i, 0, 0, 0, if(view == grid, 1, 0), if(view == lines, 1, 0), if(hidden, 1, 0), 0, 0)
        prop bh.$i = 0 ~quick
        follow bh.$i = bz.$i.hover
        box { at: bx, 34; size: 34, 34; corner: 10 * rr; color: if(i == 7, alert, mix(ink, mint, sel)); opacity: if(i == 7, 26%, 12%) * bh.$i + 22% * sel }
        PGlyph(bx, 34, 1, i, bh.$i, if(on > 0.5, 1, 0.3))
        zone box bz.$i { at: bx, 34; size: 34, 34; corner: 10 * rr; cursor: pointer; active: on > 0.5; label: pick(i, "Back", "Forward", "Up one folder", "Tiles", "Lines", "Hidden files", "New folder", "Close") }
        on press bz.$i { emit act(pick(i, 12, 13, 11, 31, 32, 14, 1, 50)) }
        on leave bz.$i { pen = 0 }
        on enter bz.$i { pen = 1 }
        on hover bz.$i for 80ms { pen = 1 }
    }
    //  Where you are: each folder on the way, to be clicked.
    box { from: side + 126, 16; size: pill.w, 36; corner: 18 * rr; color: ink; opacity: 7% }
    //  The search: a magnifier before the buttons on the right; open, the field takes the place of the path (it filters this folder as you type; Enter looks in the folders under it too).
    prop srh = 0 ~quick
    follow srh = sbz.hover
    box { at: W - 234, 34; size: 34, 34; corner: 10 * rr; color: mix(ink, mint, if(searching, 1, 0)); opacity: 12% * srh + 22% * if(searching, 1, 0) }
    ellipse { at: W - 235, 33; radius: 6.5; stroke: 1.8; color: ink; opacity: 85% + 15% * srh }
    path { at: W - 235, 33; stroke: 1.8; color: ink; opacity: 85% + 15% * sbh; move 4.7, 4.7; line 9, 9 }
    zone box sbz { at: W - 234, 34; size: 34, 34; corner: 10 * rr; cursor: pointer; label: "Search" }
    on press sbz { emit act(33) }
    group {
        show: searching
        box { from: side + 126, 16; size: pill.w, 36; corner: 18 * rr; stroke: 1.2; color: mint; opacity: 60% }
        ellipse { at: side + 150, 33; radius: 5.5; stroke: 1.6; color: mint; opacity: 90% }
        path { at: side + 150, 33; stroke: 1.6; color: mint; opacity: 90%; move 4, 4; line 7.5, 7.5 }
        input sq { at: side + 170, 26; width: pill.w - 60 - if(slim, 0, 190); size: 14; weight: 500; color: ink; placeholder: "Search this folder"; show: searching; family: "Space Grotesk" }
        text "Enter: and the folders under it" { at: side + 126 + pill.w - 18, 34; anchor: right center; size: 11.5; weight: 500; color: faint; opacity: 80%; show: not slim; family: "Space Grotesk" }
        on submit sq { emit search_go }
    }
    for c in crumbs {
        group {
            show: not searching
            let cx = side + 144 + c.x
            prop hv = 0 ~quick
            follow hv = cz.hover
            box { from: cx - 6, 21; size: c.w + 4, 26; corner: 8 * rr; color: mint; opacity: 16% * hv }
            text c.name { at: cx, 34; anchor: left center; size: 13.5; weight: if(c.last, 700, 500); color: if(c.last, ink, mix(ink, faint, 0.4)); lines: 1; family: "Space Grotesk" }
            text "›" { at: cx + c.w + 8, 33; anchor: center; size: 15; color: faint; opacity: 70%; show: not c.last; family: "Space Grotesk" }
            zone box cz { at: cx + c.w / 2 - 2, 34; size: c.w + 4, 26; corner: 8 * rr; cursor: pointer; label: "{c.name}" }
            on press cz { emit crumb(c.at) }
            on drop cz { emit dropped(-200 - c.at) }
        }
    }

    // ── the folder: tiles, or lines ──
    zone box midzone { from: mx, my; size: mw, mh; label: "The folder"; role: region }
    on press midzone { emit tile(-1) }
    on press right midzone { menu.x = pointer.x; menu.y = pointer.y; emit bg_menu }
    on drop midzone { emit dropped(-1) }
    text "This folder is empty" { at: mx + mw / 2, my + mh / 2 - 10; anchor: center; size: 15; weight: 600; color: faint; show: total == 0 and ready; family: "Space Grotesk" }
    group {
        clip box { from: mx - 6, my - 4; size: mw + 12, mh + 4; corner: 10 * rr }
        column grid {
            at: mx, my
            view: mw, mh
            step: row.h
            content: if(view == grid, total * 132, itemsn * 38)
            for r in rows from first {
                group {
                    size: mw, row.h
                    move: 0, first * row.h
                    for c in r.cells {
                        group {
                            move: 0, if(view == grid, 0, mod(c.at, lpr) * tile.h)
                            let tx = if(view == grid, mod(c.at, cols) * tile.w, 0)
                            let tw = if(view == grid, tile.w - 8, mw)
                            prop on = 0 ~quick
                            follow on = if(c.picked, 1, 0)
                            prop hv = 0 ~quick
                            follow hv = t.hover
                            prop ta = 0 ~calm
                            follow ta = if(c.has.thumb, 1, 0)
                            box { from: tx, 0; size: tw, tile.h - 4; corner: 12 * rr; color: mix(ink, mint, on); opacity: 8% * hv + 20% * on }
                            box { from: tx, 0; size: tw, tile.h - 4; corner: 12 * rr; stroke: 1.2; color: mint; opacity: 65% * on }
                            box { from: tx, 0; size: tw, tile.h - 4; corner: 12 * rr; stroke: 1.6; color: mint; opacity: 80% * hv * drag.over * if(c.ik == 0, 1, 0); show: c.ik == 0 and drag.over > 0.5 }
                            // A file's or a folder's picture, for the tiles and the lines alike: there is one copy of it here, not two, since each is long to load.
                            group {
                                show: not c.has.thumb
                                opacity: if(c.hidden, 55%, 100%) * if(c.cut, 50%, 100%)
                                PFile(if(view == grid, tx + tw / 2, tx + 24), if(view == grid, 46, 17), if(view == grid, 0.95, 0.4), c.ik, hv, 1)
                            }
                            // Tiles: the picture, and the name under it.
                            group {
                                show: view == grid
                                opacity: if(c.hidden, 55%, 100%) * if(c.cut, 50%, 100%)
                                // A picture shows itself, in a frame, instead of its icon.
                                group {
                                    show: c.has.thumb
                                    PThumb(tx + 6, 6, tw - 12, 80, hv) {
                                        image c.thumb { at: tx + 6, 6; size: tw - 12, 80; opacity: ta }
                                    }
                                }
                                text c.name { at: tx + tw / 2, 90; anchor: center top; width: tile.w - 20; lines: 2; align: center; size: 12; weight: 500; color: ink; line_height: 1.2; family: "Space Grotesk" }
                            }
                            // Lines: the picture, the name, the date and the size.
                            group {
                                show: view == lines
                                opacity: if(c.hidden, 55%, 100%) * if(c.cut, 50%, 100%)
                                group {
                                    show: c.has.thumb
                                    PThumb(tx + 8, 3, 34, 26, hv) {
                                        image c.thumb { at: tx + 8, 3; size: 34, 26; opacity: ta }
                                    }
                                }
                                text c.name { at: tx + 50, 17; anchor: left center; width: tw - 380; lines: 1; size: 13; weight: 500; color: ink; family: "Space Grotesk" }
                                text c.date { at: tx + tw - 220, 17; anchor: left center; size: 12; color: faint; width: 125; lines: 1; family: "Space Grotesk" }
                                text c.size { at: tx + tw - 16, 17; anchor: right center; size: 12; color: faint; family: "Space Grotesk" }
                            }
                            zone box t { from: tx, 0; size: tw, tile.h - 4; corner: 12 * rr; carries: "{c.carry}"; carry_icon: "{dragicon}"; label: "{c.name}"; role: item; selected: c.picked }
                            on press t { emit tile(c.at) }
                            on press right t { menu.x = pointer.x; menu.y = pointer.y; emit tile_menu(c.at) }
                            on drop t { emit dropped(c.at) }
                            on leave t { pen = 0 }
                            on enter t { pen = 1 }
                            on hover t for 80ms { pen = 1 }
                        }
                    }
                }
            }
        }
    }
    //  The list lies over the middle and takes the presses on its empty part: those are the middle's too.
    on press right grid { menu.x = pointer.x; menu.y = pointer.y; emit bg_menu }
    on press grid { emit tile(-1) }
    on drop grid { emit dropped(-1) }
    //  What is carried over the folder lands in it: the same kind of hint as the pin zone's, for the middle, while the pointer is there.
    prop midh = 0 ~quick
    follow midh = if(drag.over > 0.5, midzone.hover, 0)
    group {
        show: midh > 0.01
        opacity: midh
        box { from: mx - 4, my - 2; size: mw + 8, mh + 2; corner: 14 * rr; stroke: 1.4; color: mint; opacity: 55% }
        box { from: mx - 4, my - 2; size: mw + 8, mh + 2; corner: 14 * rr; color: mint; opacity: 6% }
        box { from: mx + mw / 2 - 130, my + mh - 46; size: 260, 30; corner: 15 * rr; color: tint; opacity: 90% }
        text "Drop to put it in this folder" { at: mx + mw / 2, my + mh - 31; anchor: center; size: 13; weight: 600; color: mint; family: "Space Grotesk" }
    }
    on change floor(grid.scroll / row.h) { emit slid(grid.scroll) }
    on change gen { grid.scroll: 0 ~0ms }
    on change scroll_to while scroll_to >= 0 { grid.scroll: scroll_to ~calm }

    // ── the bar under the folder ──
    text status { at: side + 20, H - 17; anchor: left center; size: 12; weight: 500; color: faint; lines: 1; width: W - side - 360; family: "Space Grotesk" }
    text free { at: W - 150, H - 17; anchor: right center; size: 12; color: faint; family: "Space Grotesk" }
    prop sh = 0 ~quick
    follow sh = sorter.hover
    box { from: W - 136, H - 28; size: 124, 22; corner: 8 * rr; color: mint; opacity: 16% * sh }
    text sortname { at: W - 74, H - 17; anchor: center; size: 12; weight: 600; color: mix(faint, ink, sh); family: "Space Grotesk" }
    zone box sorter { from: W - 136, H - 28; size: 124, 22; corner: 8 * rr; cursor: pointer; label: "Sort order" }
    on press sorter { emit act(15) }

    //  In the trash: a button to empty it.
    prop eh = 0 ~quick
    group {
        show: in.trash
        box { from: W - 276, H - 28; size: 128, 22; corner: 8 * rr; color: alert; opacity: 18% + 14% * eh }
        text "Empty Trash" { at: W - 212, H - 17; anchor: center; size: 12; weight: 600; color: mix(alert, ink, 0.4 + 0.3 * eh); family: "Space Grotesk" }
        zone box emptier { from: W - 276, H - 28; size: 128, 22; corner: 8 * rr; cursor: pointer; active: in.trash; label: "Empty Trash" }
        follow eh = emptier.hover
        on press emptier { emit act(18) }
    }

    // ── the name dialog: a new folder, a new name, or a question ──
    group {
        show: ask.on
        zone box askcatch { from: 0, 0; size: W, H; active: ask.on }
        on press askcatch { emit act(10) }
        box { from: 0, 0; size: W, H; corner: 22 * rr; color: deep; opacity: 45% }
        body {
            color: tint
            glass: 1
            lens: false
            rim: 70%
            shine: 0, 0
            shadow: 0, 10, 28, 40%
            opacity: 96% * (1 - ob)
            show: ob < 0.996
            box { from: W / 2 - 220, H / 2 - 80; size: 440, 160; corner: 18 * rr }
        }
        body {
            color: mix(mix(mix(tint, #000000, 0.7), ink, 0.3), tint, pl)
            rim: 0%
            border: (2 + 1.2 * uk) * pl, deep
            shadow: 0, 10, 28, 45%
            opacity: ob
            show: ob > 0.004
            box { from: W / 2 - 220, H / 2 - 80; size: 440, 160; corner: 18 * rr }
        }
        zone box askbox { from: W / 2 - 220, H / 2 - 80; size: 440, 160 }
        text ask.title { at: W / 2 - 196, H / 2 - 52; anchor: left center; size: 16; weight: 700; color: ink; family: "Space Grotesk" }
        box { from: W / 2 - 196, H / 2 - 28; size: 392, 40; corner: 12 * rr; color: deep; opacity: 45%; show: ask.input }
        box { from: W / 2 - 196, H / 2 - 28; size: 392, 40; corner: 12 * rr; stroke: 1.2; color: mint; opacity: 55%; show: ask.input }
        input askin { at: W / 2 - 184, H / 2 - 18; width: 368; size: 15; weight: 500; color: ink; placeholder: "Name"; show: ask.input; family: "Space Grotesk" }
        text ask.msg { at: W / 2 - 196, H / 2 - 30; anchor: left top; size: 14; weight: 500; color: ink; opacity: 85%; width: 392; lines: 3; show: not ask.input; family: "Space Grotesk" }
        on submit askin { emit ask_ok }
        prop ch = 0 ~quick
        follow ch = askc.hover
        prop oh = 0 ~quick
        follow oh = asko.hover
        box { from: W / 2 + 12, H / 2 + 30; size: 90, 34; corner: 12 * rr; color: ink; opacity: 8% + 8% * ch }
        text "Cancel" { at: W / 2 + 57, H / 2 + 47; anchor: center; size: 13.5; weight: 600; color: ink; family: "Space Grotesk" }
        zone box askc { from: W / 2 + 12, H / 2 + 30; size: 90, 34; corner: 12 * rr; cursor: pointer; label: "Cancel" }
        on press askc { emit act(10) }
        box { from: W / 2 + 106, H / 2 + 30; size: 90, 34; corner: 12 * rr; color: if(ask.danger, alert, mint); opacity: 80% + 20% * oh }
        text ask.ok { at: W / 2 + 151, H / 2 + 47; anchor: center; size: 13.5; weight: 700; color: if(ask.danger, #ffffff, onmint); family: "Space Grotesk" }
        zone box asko { from: W / 2 + 106, H / 2 + 30; size: 90, 34; corner: 12 * rr; cursor: pointer; label: "OK" }
        on press asko { emit ask_ok }
    }
    on change ask.gen { focus askin }

    // ── the right-click menu ──
    //  It springs out of the pointer the way the shell's drawers do (a little smaller and faint to start), in the same glass, with each action's pencil picture, the key that does it on the right,
    //  a line between groups, and the one that puts something away in the alert colour. The logic fills `menuitems` and says how tall it is (`menu.h`).
    prop mo = 0 ~calm
    follow mo = if(menu.on, 1, 0)
    let mpx = clamp(menu.x, 8, W - 284)
    let mpy = clamp(menu.y, 8, H - menu.h - 8)
    group {
        show: mo > 0.01
        pivot: mpx, mpy
        scale: 0.9 + 0.1 * mo
        opacity: mo
        zone box menucatch { from: 0, 0; size: W, H; active: menu.on }
        on press menucatch { emit menu_close }
        on press right menucatch { emit menu_close }
        box { from: mpx, mpy; size: 268, menu.h; corner: 16 * rr; color: mix(tint, #000000, 0.2); opacity: 98% }
        body {
            color: tint
            glass: 1
            lens: false
            rim: 70%
            shine: 0, 0
            shadow: 0, 10, 26, 42%
            opacity: 60% * (1 - ob)
            show: ob < 0.996
            box { from: mpx, mpy; size: 268, menu.h; corner: 16 * rr }
        }
        body {
            color: mix(mix(mix(tint, #000000, 0.7), ink, 0.3), tint, pl)
            rim: 0%
            border: (2 + 1.2 * uk) * pl, deep
            shadow: 0, 10, 26, 45%
            opacity: ob
            show: ob > 0.004
            box { from: mpx, mpy; size: 268, menu.h; corner: 16 * rr }
        }
        column menuc {
            at: mpx + 7, mpy + 7
            gap: 0
            for m in menuitems {
                group {
                    size: 254, 36 + if(m.sep, 9, 0)
                    prop mh = 0 ~quick
                    follow mh = mz.hover
                    box { from: 14, 4; size: 226, 1; color: ink; opacity: 10%; show: m.sep }
                    box { from: 0, if(m.sep, 10, 1); size: 254, 34; corner: 11 * rr; color: if(m.danger, alert, mint); opacity: 18% * mh }
                    box { from: 0, if(m.sep, 10, 1); size: 254, 34; corner: 11 * rr; stroke: 1; color: if(m.danger, alert, mint); opacity: 40% * mh }
                    PGlyph(25, if(m.sep, 27, 18), 0.78, m.ic, mh, if(m.on, 1, 0.35))
                    text m.label { at: 50, if(m.sep, 27, 18); anchor: left center; size: 13.5; weight: 600; color: if(m.danger, mix(ink, alert, 0.55 + 0.45 * mh), ink); opacity: if(m.on, 100%, 38%); family: "Space Grotesk" }
                    text m.key { at: 242, if(m.sep, 27, 18); anchor: right center; size: 11.5; weight: 500; color: faint; opacity: if(m.on, 75%, 30%); family: "Space Grotesk" }
                    zone box mz { from: 0, if(m.sep, 10, 1); size: 254, 34; corner: 11 * rr; cursor: pointer; active: m.on and menu.on; label: "{m.label}" }
                    on press mz { emit act(m.k) }
                    on leave mz { pen = 0 }
                    on enter mz { pen = 1 }
                    on hover mz for 80ms { pen = 1 }
                }
            }
        }
    }

    // ── the properties card ──
    //  What a file is: its picture, its name and what it is, then a line for each thing about it (the logic fills `pinfo` and `prows` and says how tall the card is, `prop.h`).
    prop po = 0 ~calm
    follow po = if(prop.on, 1, 0)
    let ppx = W / 2 - 236
    let ppy = H / 2 - prop.h / 2
    group {
        show: po > 0.01
        pivot: W / 2, H / 2
        scale: 0.94 + 0.06 * po
        opacity: po
        zone box propcatch { from: 0, 0; size: W, H; active: prop.on }
        on press propcatch { emit act(10) }
        box { from: 0, 0; size: W, H; corner: 22 * rr; color: deep; opacity: 45% }
        box { from: ppx, ppy; size: 472, prop.h; corner: 20 * rr; color: mix(tint, #000000, 0.2); opacity: 98% }
        body {
            color: tint
            glass: 1
            lens: false
            rim: 70%
            shine: 0, 0
            shadow: 0, 12, 30, 42%
            opacity: 60% * (1 - ob)
            show: ob < 0.996
            box { from: ppx, ppy; size: 472, prop.h; corner: 20 * rr }
        }
        body {
            color: mix(mix(mix(tint, #000000, 0.7), ink, 0.3), tint, pl)
            rim: 0%
            border: (2 + 1.2 * uk) * pl, deep
            shadow: 0, 12, 30, 45%
            opacity: ob
            show: ob > 0.004
            box { from: ppx, ppy; size: 472, prop.h; corner: 20 * rr }
        }
        zone box propbox { from: ppx, ppy; size: 472, prop.h }
        for i in pinfo {
            group {
                group { show: not i.has.thumb; PFile(ppx + 52, ppy + 52, 1, i.ik, 0, 1) }
                group {
                    show: i.has.thumb
                    body {
                        color: deep
                        rim: 14%
                        box { from: ppx + 20, ppy + 22; size: 64, 48; corner: 8 * rr }
                    }
                    clip box { from: ppx + 20, ppy + 22; size: 64, 48; corner: 8 * rr }
                    image i.thumb { at: ppx + 20, ppy + 22; size: 64, 48 }
                }
                text i.name { at: ppx + 102, ppy + 38; anchor: left center; size: 18; weight: 700; color: ink; width: 346; lines: 1; family: "Space Grotesk" }
                text i.sub { at: ppx + 102, ppy + 62; anchor: left center; size: 12.5; weight: 500; color: faint; width: 346; lines: 1; family: "Space Grotesk" }
            }
        }
        box { from: ppx + 22, ppy + 90; size: 428, 1; color: ink; opacity: 10% }
        column prc {
            at: ppx + 22, ppy + 100
            gap: 0
            for r in prows {
                group {
                    size: 428, 30
                    text r.label { at: 2, 15; anchor: left center; size: 12.5; weight: 500; color: faint; family: "Space Grotesk" }
                    text r.value { at: 112, 15; anchor: left center; size: 13; weight: 500; color: ink; width: 316; lines: 1; show: not r.tog; family: "Space Grotesk" }
                    // A row with a switch: Hidden (a name that starts with a dot).
                    group {
                        show: r.tog
                        prop tg = 0 ~quick
                        follow tg = if(r.on, 1, 0)
                        box { from: 112, 3; size: 46, 24; corner: 12 * rr; color: mix(ink, mint, tg); opacity: 20% + 60% * tg }
                        ellipse { at: 124 + 22 * tg, 15; radius: 8.5; color: mix(ink, onmint, 0.5 * tg) }
                        text r.value { at: 170, 15; anchor: left center; size: 13; weight: 500; color: ink; width: 258; lines: 1; family: "Space Grotesk" }
                        zone box tz { from: 108, 1; size: 150, 28; corner: 10 * rr; cursor: pointer; active: r.tog and prop.on; label: "Hidden" }
                        on press tz { emit act(19) }
                    }
                }
            }
        }
        prop pch = 0 ~quick
        follow pch = propclose.hover
        box { from: ppx + 472 - 22 - 96, ppy + prop.h - 54; size: 96, 34; corner: 12 * rr; color: mint; opacity: 80% + 20% * pch }
        text "Close" { at: ppx + 472 - 22 - 48, ppy + prop.h - 37; anchor: center; size: 13.5; weight: 700; color: onmint; family: "Space Grotesk" }
        zone box propclose { from: ppx + 472 - 22 - 96, ppy + prop.h - 54; size: 96, 34; corner: 12 * rr; cursor: pointer; label: "Close" }
        on press propclose { emit act(10) }
    }

    // ── the keys ──
    on key Return while not ask.on and not searching { emit act(7) }
    on key F2 while not ask.on and not searching { emit act(2) }
    on key Delete while not ask.on and not searching { emit act(3) }
    on key Shift+Delete while not ask.on and not searching { emit act(17) }
    on key Return while ask.on and not ask.input { emit ask_ok }
    on key Ctrl+c while not ask.on and not searching { emit act(4) }
    on key Ctrl+x while not ask.on and not searching { emit act(5) }
    on key Ctrl+v while not ask.on and not searching { emit act(6) }
    on key Ctrl+a while not ask.on and not searching { emit act(8) }
    on key F5 { emit act(9) }
    on key Alt+Return { emit act(16) }
    on key Escape { emit act(10) }
    on key BackSpace while not ask.on and not searching { emit act(11) }
    on key Alt+Up { emit act(11) }
    on key Alt+Left { emit act(12) }
    on key Alt+Right { emit act(13) }
    on key Ctrl+h while not ask.on and not searching { emit act(14) }
    on key Ctrl+Shift+n { emit act(1) }
    on key Ctrl+f { emit act(30) }
    on key Ctrl+Shift+f { emit act(30) }
    on key Left while not ask.on and not searching { emit act(20) }
    on key Right while not ask.on and not searching { emit act(21) }
    on key Up while not ask.on and not searching { emit act(22) }
    on key Down while not ask.on and not searching { emit act(23) }
}
