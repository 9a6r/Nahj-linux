    //  A toolbar or menu picture (`g`): back, forward, up, tiles, lines, hidden files, new folder, close, then the menu's own. `hot` swells it, turns it to the accent and redraws it, like the shell's own.
    component PGlyph(cx: number, cy: number, s: number, g: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let j = (0.3 + 0.4 * a) * (0.5 + s)
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
            scale: 1 + 0.08 * a
            group {
                show: g == 0
                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move 6 * s + j * sin(fr * 74 + 3963), -9 * s + j * sin(fr * 58 + 1055); line -5 * s + j * sin(fr * 73 + 1925), 0 * s + j * sin(fr * 63 + 293); line 6 * s + j * sin(fr * 73 + 1047), 9 * s + j * sin(fr * 76 + 4094) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move 6 * s + j * sin(fr * 43 + 1219), -9 * s + j * sin(fr * 66 + 1329); line -5 * s + j * sin(fr * 69 + 1483), 0 * s + j * sin(fr * 68 + 2576); line 6 * s + j * sin(fr * 63 + 375), 9 * s + j * sin(fr * 59 + 4274) }
            }
            group {
