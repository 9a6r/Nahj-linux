language 0.1
import "../palette.plm"

//  Files: a file manager in the shell's own glass. Places down the left (the ones you know, the drives, the folders you pinned), where you are across the top (back, forward, up, a path you can click or
//  type, tabs under it), the folder as tiles or lines in the middle and a bar under it. Everything is drawn from the palette (so any theme is its own) and the file and folder pictures are pencil
//  drawings, like the shell's icons. The logic (files.luau) does the work with `find`, `cp`, `mv`, `gio` and the like, and says what is chosen, what is going on and what can be undone.
//
//  Keys (when the window has the keyboard): Enter opens, F2 renames, Delete trashes, Ctrl+C / X / V, Ctrl+A, Ctrl+I, Ctrl+Z undoes, Ctrl+Shift+N a new folder, Ctrl+H hidden files, F5 refreshes, Space looks
//  at a file, Ctrl+L types a path, Ctrl+T / Ctrl+W / Ctrl+Tab are the tabs, Ctrl+D pins this folder, Ctrl++ and Ctrl+- zoom, typing a name searches. Backspace or Alt+Up goes up, Alt+Left and Alt+Right back
//  and forward, Alt+Home goes home, the arrows move the choice (with Shift they extend it, with Ctrl they only move), Escape lets go of it. See `files.luau` for the whole list.
//
//  Open it with SUPER + E, or "Files" in the launcher (bin/vitreus-files).

scene Files {
    surface { size: 1100, 720; kind: window; title: "Files"; app_id: "vitreus.files"; keyboard: on_demand }

    permissions {
        services: "files", "files.write"
        run: "find", "magick", "ffmpeg", "ffprobe", "identify", "pdftoppm", "stat", "du", "file", "rm", "rmdir", "hyprctl", "xdg-open", "gio", "cp", "mv", "mkdir", "df", "xdg-user-dir", "printenv", "pleamar", "wl-copy", "wl-paste", "fc-match", "vitreus-files", "cat", "head", "chmod", "ln", "touch", "bsdtar", "grep", "sha256sum", "lsblk", "udisksctl", "awww", "which", "readlink", "kitty", "alacritty", "foot", "wezterm", "konsole", "gnome-terminal", "xterm", "date"
    }

    // ── what the logic says ──
    text dragicon = ""               // the picture that goes under the pointer while a file is dragged out (the logic makes it when a tile is pressed)
    fact view: grid | lines = grid
    fact hidden = false              // hidden files shown
    fact sort: name | size | type | date = name
    fact sortrev = false             // the order turned round
    fact dirfirst = true             // folders before files
    fact zoom = 3                    // how big the tiles are, 1 to 5
    fact tilebase = 128              // the tile's width that goes with it (the logic knows the steps)
    fact tilew = 128                 // the tile's width as drawn (the scene says: a wide window stretches them so that a row never has more than twelve)
    fact total = 0                   // rows of tiles in the folder (or blocks of lines)
    fact itemsn = 0                  // how many things are in it
    fact first = 0                   // the first row of the window the logic is showing
    fact cols = 6                    // tiles across, as the middle is wide
    fact gen = 0                     // goes up with each folder you go into: the list starts at its top
    fact sct = 0                     // where the list is scrolled to (pixels): the wheel, the bar and the logic all say it
    fact can.back = false
    fact can.fwd = false
    fact ready = false
    fact roomw = 700                 // how wide the folder's part is, for the tabs
    fact vh = 400                    // how tall the folder's window is, for scrolling a chosen tile into view
    fact clip.on = false             // something is waiting to be pasted
    fact ask.on = false              // the name dialog (new folder, rename)
    fact ask.gen = 0
    fact ask.input = true            // the dialog asks for a name (else it is a question with Cancel and a button)
    fact ask.danger = false          // and the button is the alert colour
    fact in.trash = false            // the folder shown is the trash
    fact in.list = false             // what is shown is a list made of places (a search, recent files, starred ones), not a folder
    fact menu.on = false             // the right-click menu
    fact menu.x = 0
    fact menu.y = 0
    fact menu.h = 100                // how tall the menu is (the logic adds up its rows and the lines between groups)
    fact prop.on = false             // the properties card
    fact prop.h = 320
    fact pm.on = false               // the card shows the permissions' switches (a single thing that is yours)
    fact pm.bits = 0                 // rwxrwxrwx as a number of nine bits
    fact crumbw = 300                // how much room the path has: the logic keeps the last folders that fit
    fact pen = 0                     // the pointer is on something that boils: the pencil's clock runs only then
    //  Every zone that boils says `leave` before `enter`, and `hover` again a moment after: when the pointer goes straight from one to the next, both fire in one frame and the one declared last stays (so `enter` has to be),
    //  and when it is another zone's `leave` that stays, the `hover` sets it right again in 80 ms. Without them the clock stopped under the pointer and the pencil froze.
    fact obs = false                 // Vitreus has its glass off: flat obsidian (Vitreus says so with `fact obs true`)
    fact look = 0                    // the shell's theme (Vitreus says so): 0 Glass, 1 Retro, 2 UwU, 3 Cyber; the plastic ones get an outline and a hard shadow
    text status = ""
    text empty = "This folder is empty"
    text free = ""
    text sortname = "Name"
    text ask.title = ""
    text ask.ok = "OK"
    text ask.msg = ""
    text askin = ""
    text sq = ""                      // what is typed in the search field
    fact searching = false           // the search field is open (it takes the place of the path)
    fact so.where = 0                // the search: 0 this folder, 1 the whole home folder
    fact so.what = 0                 // 0 names, 1 what is written in the files
    fact so.kind = 0                 // 0 anything, 1 folders, 2 pictures, 3 documents, 4 sounds, 5 videos
    text locin = ""                  // what is typed where the path is
    fact loc.edit = false            // the path is being typed
    fact rb.on = false               // a box is being dragged over the folder to choose what is in it
    fact rb.ax = 0                   // where it began and where it is, in the folder's own measures (the list's width, and down from its top)
    fact rb.ay = 0
    fact rb.bx = 0
    fact rb.by = 0
    fact job.on = false              // something is being copied, moved or put away
    fact job.p = 0                   // how far it has got, 0 to 1 (-1 when it cannot say)
    text job.text = ""
    fact undo.on = false             // the last thing done can be taken back
    text undo.text = ""
    fact cf.on = false               // the question about a name that is taken
    fact cf.all = false              // and the answer is for all the others
    text cf.name = ""
    text cf.msg = ""
    fact pick.on = false             // a list to choose from (open with, a template, what to make an archive of)
    text pick.title = ""
    fact pv.on = false               // the look at a file
    fact pv.kind = 0                 // 0 only what it is, 1 a picture, 2 its words
    text pv.name = ""
    text pv.sub = ""
    text pv.text = ""
    text pv.path = ""
    fact pv.n = 0                    // which of how many (so that the arrows say there is more)
    fact pv.of = 0
    event search_go ->               // Enter in it: look in the folders under this one too
    event loc_go ->                  // Enter in the path being typed

    model crumbs max 8 { at: number; name: text; path: text; x: number; w: number; last: bool }
    model places max 40 { at: number; name: text; path: text; pk: number; here: bool; pinned: bool; kind: number; eject: bool; use: number }
    model tabs max 10 { at: number; name: text; x: number; w: number; active: bool }
    model pinfo max 1 { name: text; sub: text; ik: number; thumb: image 192, 144; has.thumb: bool }
    model prows max 18 { label: text; value: text; tog: bool; on: bool; btn: text; hb: bool; k: number }
    model menuitems max 20 { label: text; k: number; on: bool; ic: number; key: text; danger: bool; sep: bool; chk: bool }
    model picks max 14 { at: number; label: text; sub: text; hs: bool; ic: number }
    model rows max 14 {
        list cells max 12 {
            at: number
            name: text
            ik: number
            carry: text
            thumb: image 192, 144
            has.thumb: bool
            picked: bool
            cur: bool
            hidden: bool
            cut: bool
            link: bool
            broken: bool
            star: bool
            size: text
            date: text
            kind: text
        }
    }

    event slid ->
    event set_cols ->
    event tile ->
    event tile_up ->
    event tile_menu ->
    event tile_mid ->
    event bg_menu ->
    event place ->
    event place_eject ->
    event crumb ->
    event act ->
    event ask_ok ->
    event menu_close ->
    event dropped ->
    event spring ->
    event place_menu ->
    event focused ->
    event band ->
    event band_end ->
    event sort_by ->
    event sopt ->
    event tab_go ->
    event tab_close ->
    event pick_ok ->
    event cf_pick ->
    event job_cancel ->
    event prop_act ->
    event perm ->

    // ── the pencil's clock, and the theme ──
    prop time = 0
    spin time by if(pen > 0.5, 1, 0)
    prop ob = 0 ~calm
    follow ob = if(obs or look == 1 or look == 2, 1, 0)
    prop pl = 0 ~calm
    follow pl = if(look == 1 or look == 2, 1, 0)
    prop uk = 0 ~calm
    follow uk = if(look == 2, 1, 0)
    prop sq = 0 ~calm
    follow sq = if(look == 1 or look == 3, 1, 0)       // Retro and Cyber cut their corners squarer, as the bar's drawers do (`rc` in vitreus.plm)
    let rr = 1 - 0.73 * sq                             // what every corner is multiplied by

    // >>> icons (written by gen_icons.py: edit that, not this)
    //  A file's or a folder's picture in pencil: a folder, a picture, a PDF, a sound, a video, code, an archive or any other file (`ik`, which the logic sets). `s` is its size (1 is 64 px); `hot` (hover) swells it and redraws it about five times a second. The folder takes the accent and the files the ink, so any palette is theirs.
    component PFile(cx: number, cy: number, s: number, ik: number, hot: number, o: number) {
        prop a = 0 ~calm
        follow a = hot
        let fr = if(a > 0.02, floor(time * 5), 0)
        let j = (0.3 + 0.4 * a) * (0.5 + s)
        let w1 = 1.3 + 1.1 * s
        let w2 = 0.9 + 0.6 * s
        let off = 0.35 * (0.5 + s)
        group {
            pivot: cx, cy
            scale: 1 + 0.08 * a
            group {
                show: ik >= 1
                path { at: cx, cy; stroke: w1; color: ink; opacity: (o); move -17 * s + j * sin(fr * 45 + 101), -26 * s + j * sin(fr * 68 + 4856); line 7 * s + j * sin(fr * 74 + 780), -26 * s + j * sin(fr * 52 + 2130); line 17 * s + j * sin(fr * 47 + 465), -16 * s + j * sin(fr * 74 + 2299); line 17 * s + j * sin(fr * 62 + 1367), 26 * s + j * sin(fr * 40 + 2667); line -17 * s + j * sin(fr * 76 + 4130), 26 * s + j * sin(fr * 48 + 4571); line -17 * s + j * sin(fr * 54 + 3974), -27 * s + j * sin(fr * 48 + 4999); line -17 * s + j * sin(fr * 72 + 2481), -20 * s + j * sin(fr * 45 + 3522) }
                path { at: cx + off, cy + off; stroke: w2; color: ink; opacity: (o) * 0.28; move -17 * s + j * sin(fr * 50 + 1208), -26 * s + j * sin(fr * 59 + 4259); line 7 * s + j * sin(fr * 66 + 3298), -26 * s + j * sin(fr * 49 + 4360); line 17 * s + j * sin(fr * 52 + 3180), -16 * s + j * sin(fr * 40 + 969); line 17 * s + j * sin(fr * 64 + 701), 26 * s + j * sin(fr * 43 + 2942); line -17 * s + j * sin(fr * 62 + 311), 26 * s + j * sin(fr * 41 + 4281); line -17 * s + j * sin(fr * 70 + 2785), -27 * s + j * sin(fr * 59 + 3787); line -17 * s + j * sin(fr * 60 + 1094), -20 * s + j * sin(fr * 71 + 3922) }
                path { at: cx, cy; stroke: w1; color: ink; opacity: (o); move 7 * s + j * sin(fr * 76 + 1498), -26 * s + j * sin(fr * 49 + 4943); line 7 * s + j * sin(fr * 73 + 1795), -16 * s + j * sin(fr * 67 + 2855); line 17 * s + j * sin(fr * 69 + 5000), -16 * s + j * sin(fr * 54 + 669) }
                path { at: cx + off, cy + off; stroke: w2; color: ink; opacity: (o) * 0.28; move 7 * s + j * sin(fr * 75 + 3369), -26 * s + j * sin(fr * 42 + 1701); line 7 * s + j * sin(fr * 51 + 470), -16 * s + j * sin(fr * 74 + 494); line 17 * s + j * sin(fr * 68 + 1644), -16 * s + j * sin(fr * 70 + 267) }
            }
            group {
                show: ik == 0
                path { at: cx, cy; stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -26 * s + j * sin(fr * 47 + 2717), -12 * s + j * sin(fr * 72 + 4292); line -26 * s + j * sin(fr * 46 + 1929), -22 * s + j * sin(fr * 75 + 3545); line -10 * s + j * sin(fr * 76 + 4587), -22 * s + j * sin(fr * 71 + 4904); line -4 * s + j * sin(fr * 68 + 2065), -15 * s + j * sin(fr * 40 + 761); line 26 * s + j * sin(fr * 47 + 2453), -15 * s + j * sin(fr * 46 + 3783); line 26 * s + j * sin(fr * 40 + 4116), 22 * s + j * sin(fr * 60 + 1822); line -26 * s + j * sin(fr * 65 + 2160), 22 * s + j * sin(fr * 62 + 3021); line -26 * s + j * sin(fr * 64 + 4307), -13 * s + j * sin(fr * 44 + 2888); line -26 * s + j * sin(fr * 45 + 4666), -8 * s + j * sin(fr * 74 + 2493) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -26 * s + j * sin(fr * 58 + 3847), -12 * s + j * sin(fr * 49 + 4830); line -26 * s + j * sin(fr * 59 + 302), -22 * s + j * sin(fr * 63 + 3078); line -10 * s + j * sin(fr * 69 + 3558), -22 * s + j * sin(fr * 45 + 3366); line -4 * s + j * sin(fr * 75 + 4183), -15 * s + j * sin(fr * 47 + 3585); line 26 * s + j * sin(fr * 72 + 4122), -15 * s + j * sin(fr * 65 + 4397); line 26 * s + j * sin(fr * 56 + 3540), 22 * s + j * sin(fr * 76 + 4025); line -26 * s + j * sin(fr * 72 + 4343), 22 * s + j * sin(fr * 41 + 4814); line -26 * s + j * sin(fr * 54 + 1156), -13 * s + j * sin(fr * 43 + 4386); line -26 * s + j * sin(fr * 46 + 3617), -8 * s + j * sin(fr * 70 + 1266) }
                path { at: cx, cy; stroke: w1; color: mix(mint, ink, 0.25); opacity: (o); move -26 * s + j * sin(fr * 70 + 1975), -5 * s + j * sin(fr * 47 + 3842); line 26 * s + j * sin(fr * 70 + 4569), -5 * s + j * sin(fr * 56 + 4685) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.28; move -26 * s + j * sin(fr * 65 + 2620), -5 * s + j * sin(fr * 75 + 4211); line 26 * s + j * sin(fr * 70 + 3392), -5 * s + j * sin(fr * 67 + 1759) }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move -17 * s + j * sin(fr * 58 + 2303), 18 * s + j * sin(fr * 40 + 371); line -9 * s + j * sin(fr * 49 + 4992), 6 * s + j * sin(fr * 69 + 4383) }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move -8 * s + j * sin(fr * 71 + 3048), 18 * s + j * sin(fr * 52 + 2230); line 0 * s + j * sin(fr * 71 + 3922), 6 * s + j * sin(fr * 72 + 4172) }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move 1 * s + j * sin(fr * 67 + 4669), 18 * s + j * sin(fr * 42 + 2476); line 9 * s + j * sin(fr * 60 + 3849), 6 * s + j * sin(fr * 46 + 3691) }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move 10 * s + j * sin(fr * 72 + 2220), 18 * s + j * sin(fr * 68 + 1599); line 18 * s + j * sin(fr * 67 + 4025), 6 * s + j * sin(fr * 44 + 2282) }
                path { at: cx, cy; stroke: w2; color: mix(mint, ink, 0.25); opacity: (o) * 0.24; move 19 * s + j * sin(fr * 71 + 3132), 18 * s + j * sin(fr * 46 + 1694); line 27 * s + j * sin(fr * 66 + 1298), 6 * s + j * sin(fr * 68 + 214) }
            }
            group {
                show: ik == 1
                path { at: cx, cy; stroke: w1; color: mint; opacity: (o); move -11 * s + j * sin(fr * 48 + 4441), 17 * s + j * sin(fr * 53 + 4334); line -4 * s + j * sin(fr * 48 + 1413), 4 * s + j * sin(fr * 51 + 3294); line 2 * s + j * sin(fr * 57 + 3584), 11 * s + j * sin(fr * 74 + 3492); line 7 * s + j * sin(fr * 45 + 3239), 5 * s + j * sin(fr * 59 + 1633); line 12 * s + j * sin(fr * 62 + 1531), 17 * s + j * sin(fr * 56 + 3900) }
                path { at: cx + off, cy + off; stroke: w2; color: mint; opacity: (o) * 0.28; move -11 * s + j * sin(fr * 71 + 3505), 17 * s + j * sin(fr * 58 + 3931); line -4 * s + j * sin(fr * 51 + 2768), 4 * s + j * sin(fr * 73 + 4048); line 2 * s + j * sin(fr * 68 + 1083), 11 * s + j * sin(fr * 73 + 4398); line 7 * s + j * sin(fr * 57 + 874), 5 * s + j * sin(fr * 53 + 1995); line 12 * s + j * sin(fr * 40 + 862), 17 * s + j * sin(fr * 69 + 2806) }
                ellipse { at: cx + 6 * s + j * sin(fr * 66 + 4565), cy + -8 * s + j * sin(fr * 51 + 322); radius: 3.2 * s * (1 + 0.05 * sin(fr * 47 + 1360)); stroke: w1; color: mint; opacity: (o) }
                ellipse { at: cx + 6 * s + j * sin(fr * 50 + 2981) + off, cy + -8 * s + j * sin(fr * 75 + 4788) + off; radius: 3.2 * s; stroke: w2; color: mint; opacity: (o) * 0.28 }
            }
            group {
                show: ik == 2
                path { at: cx, cy; stroke: w1; color: ink; opacity: (o); move -9 * s + j * sin(fr * 47 + 1428), -9 * s + j * sin(fr * 47 + 1068); line 9 * s + j * sin(fr * 42 + 1129), -9 * s + j * sin(fr * 73 + 3000) }
                path { at: cx + off, cy + off; stroke: w2; color: ink; opacity: (o) * 0.28; move -9 * s + j * sin(fr * 59 + 335), -9 * s + j * sin(fr * 67 + 4836); line 9 * s + j * sin(fr * 48 + 3016), -9 * s + j * sin(fr * 66 + 3246) }
                path { at: cx, cy; stroke: w1; color: ink; opacity: (o); move -9 * s + j * sin(fr * 64 + 2060), -2 * s + j * sin(fr * 66 + 1898); line 9 * s + j * sin(fr * 48 + 1602), -2 * s + j * sin(fr * 74 + 332) }
                path { at: cx + off, cy + off; stroke: w2; color: ink; opacity: (o) * 0.28; move -9 * s + j * sin(fr * 74 + 4645), -2 * s + j * sin(fr * 65 + 2188); line 9 * s + j * sin(fr * 49 + 1969), -2 * s + j * sin(fr * 41 + 235) }
                path { at: cx, cy; stroke: w1; color: alert; opacity: (o); move -11 * s + j * sin(fr * 57 + 4533), 9 * s + j * sin(fr * 70 + 3523); line 11 * s + j * sin(fr * 56 + 2678), 9 * s + j * sin(fr * 48 + 4963); line 11 * s + j * sin(fr * 45 + 1568), 19 * s + j * sin(fr * 75 + 411); line -11 * s + j * sin(fr * 72 + 2272), 19 * s + j * sin(fr * 61 + 4363); line -11 * s + j * sin(fr * 60 + 560), 9 * s + j * sin(fr * 40 + 2089) }
                path { at: cx + off, cy + off; stroke: w2; color: alert; opacity: (o) * 0.28; move -11 * s + j * sin(fr * 70 + 577), 9 * s + j * sin(fr * 54 + 4266); line 11 * s + j * sin(fr * 49 + 3369), 9 * s + j * sin(fr * 63 + 2004); line 11 * s + j * sin(fr * 75 + 2359), 19 * s + j * sin(fr * 61 + 1746); line -11 * s + j * sin(fr * 63 + 3041), 19 * s + j * sin(fr * 69 + 3848); line -11 * s + j * sin(fr * 75 + 3983), 9 * s + j * sin(fr * 59 + 1639) }
            }
            group {
                show: ik == 3
                path { at: cx, cy; stroke: w1; color: mint; opacity: (o); move 4 * s + j * sin(fr * 56 + 2569), -12 * s + j * sin(fr * 47 + 2949); line 4 * s + j * sin(fr * 70 + 4185), 10 * s + j * sin(fr * 47 + 4651) }
                path { at: cx + off, cy + off; stroke: w2; color: mint; opacity: (o) * 0.28; move 4 * s + j * sin(fr * 73 + 2123), -12 * s + j * sin(fr * 62 + 3835); line 4 * s + j * sin(fr * 62 + 776), 10 * s + j * sin(fr * 44 + 819) }
                path { at: cx, cy; stroke: w1; color: mint; opacity: (o); move 4 * s + j * sin(fr * 71 + 2656), -12 * s + j * sin(fr * 56 + 1951); line 11 * s + j * sin(fr * 50 + 2762), -8 * s + j * sin(fr * 67 + 4247); line 11 * s + j * sin(fr * 75 + 2817), -4 * s + j * sin(fr * 60 + 4140) }
                path { at: cx + off, cy + off; stroke: w2; color: mint; opacity: (o) * 0.28; move 4 * s + j * sin(fr * 65 + 2669), -12 * s + j * sin(fr * 51 + 1709); line 11 * s + j * sin(fr * 69 + 1903), -8 * s + j * sin(fr * 62 + 2968); line 11 * s + j * sin(fr * 66 + 4932), -4 * s + j * sin(fr * 64 + 1843) }
                ellipse { at: cx + -1 * s + j * sin(fr * 49 + 3718), cy + 12 * s + j * sin(fr * 76 + 1145); radius: 4.2 * s * (1 + 0.05 * sin(fr * 47 + 1441)); stroke: w1; color: mint; opacity: (o) }
                ellipse { at: cx + -1 * s + j * sin(fr * 57 + 2794) + off, cy + 12 * s + j * sin(fr * 47 + 2721) + off; radius: 4.2 * s; stroke: w2; color: mint; opacity: (o) * 0.28 }
            }
            group {
                show: ik == 4
                path { at: cx, cy; stroke: w1; color: mint; opacity: (o); move -6 * s + j * sin(fr * 42 + 1617), -8 * s + j * sin(fr * 75 + 4305); line 9 * s + j * sin(fr * 54 + 3956), 2 * s + j * sin(fr * 61 + 2914); line -6 * s + j * sin(fr * 62 + 2703), 12 * s + j * sin(fr * 70 + 2191); line -6 * s + j * sin(fr * 71 + 2779), -8 * s + j * sin(fr * 56 + 400) }
                path { at: cx + off, cy + off; stroke: w2; color: mint; opacity: (o) * 0.28; move -6 * s + j * sin(fr * 71 + 1191), -8 * s + j * sin(fr * 41 + 4037); line 9 * s + j * sin(fr * 63 + 2179), 2 * s + j * sin(fr * 69 + 1728); line -6 * s + j * sin(fr * 63 + 2341), 12 * s + j * sin(fr * 72 + 3376); line -6 * s + j * sin(fr * 59 + 1888), -8 * s + j * sin(fr * 43 + 3465) }
            }
            group {
                show: ik == 5
                path { at: cx, cy; stroke: w1; color: mint; opacity: (o); move -4 * s + j * sin(fr * 72 + 429), -8 * s + j * sin(fr * 70 + 161); line -11 * s + j * sin(fr * 43 + 875), 1 * s + j * sin(fr * 62 + 4900); line -4 * s + j * sin(fr * 56 + 2793), 10 * s + j * sin(fr * 41 + 1441) }
                path { at: cx + off, cy + off; stroke: w2; color: mint; opacity: (o) * 0.28; move -4 * s + j * sin(fr * 72 + 1667), -8 * s + j * sin(fr * 45 + 3563); line -11 * s + j * sin(fr * 67 + 1733), 1 * s + j * sin(fr * 50 + 2075); line -4 * s + j * sin(fr * 54 + 4151), 10 * s + j * sin(fr * 53 + 3150) }
                path { at: cx, cy; stroke: w1; color: mint; opacity: (o); move 4 * s + j * sin(fr * 50 + 4489), -8 * s + j * sin(fr * 67 + 3566); line 11 * s + j * sin(fr * 69 + 3075), 1 * s + j * sin(fr * 53 + 2628); line 4 * s + j * sin(fr * 68 + 4679), 10 * s + j * sin(fr * 70 + 851) }
