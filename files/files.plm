                path { at: cx, cy; stroke: w1; color: mix(ink, mint, a); opacity: (o); move -6 * s + j * sin(fr * 62 + 3023), -9 * s + j * sin(fr * 63 + 495); line 5 * s + j * sin(fr * 66 + 2359), 0 * s + j * sin(fr * 62 + 220); line -6 * s + j * sin(fr * 52 + 4418), 9 * s + j * sin(fr * 62 + 1287) }
                path { at: cx + off, cy + off; stroke: w2; color: mix(ink, mint, a); opacity: (o) * 0.28; move -6 * s + j * sin(fr * 61 + 4399), -9 * s + j * sin(fr * 57 + 4951); line 5 * s + j * sin(fr * 61 + 2593), 0 * s + j * sin(fr * 50 + 1887); line -6 * s + j * sin(fr * 47 + 2793), 9 * s + j * sin(fr * 49 + 1622) }
            }
