language 0.1

//  A Vitreus add-on: a scene of its own, started while its switch is on (Settings > Widgets > Add-ons) and started again if it stops.
//  This one is a small card in the top right corner of the desktop, under the windows. Change it into yours.
//  Colours: the shell's palette is not imported here (an add-on cannot reach into the shell's folder), so draw with colours of your own.
//  A scene says what it needs in `permissions`; this one needs nothing.

scene HelloAddon {
    surface { size: 260, 90; anchor: top_right; margin: 32; level: bottom }

    box { at: 130, 45; size: 252, 82; corner: 18; color: #1b2127; opacity: 80% }
    box { at: 130, 45; size: 252, 82; corner: 18; stroke: 1.5; color: #9ed6bd; opacity: 70% }
    text "Hello from an add-on" { at: 130, 45; anchor: center; size: 17; weight: 700; color: #f5f7f5; family: "Space Grotesk" }
}
