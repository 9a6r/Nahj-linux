language 0.1
import "addon-palette.plm"
import "addon-pencil.plm"

//  Equalizer, in boiled pencil: ten bands you drag, five presets and one switch, in a panel out of the add-on pill.
//  The scene only draws and reports what was touched (`eq_toggle`, `preset(n)`, `bset(band * 1000 + (dB + 12) * 10)`); eq.luau keeps the bands and
//  runs vitreus-eq, which does the filtering (PipeWire's filter-chain). Drag a band, right-click it to put it back to 0 dB.

scene Equalizer {
    surface { size: full, full; anchor: top_left; margin: 0; level: top, overlay while slot_open; screens: each max 4 }

    permissions {
        services: "files", "files.write"
        run: "vitreus-eq"
    }

    fact pal_ink_r = 0.9608
    fact pal_ink_g = 0.9686
    fact pal_ink_b = 0.9608
    fact pal_faint_r = 0.7608
    fact pal_faint_g = 0.7804
    fact pal_faint_b = 0.8000
    fact pal_mint_r = 0.6196
    fact pal_mint_g = 0.8392
    fact pal_mint_b = 0.7412
    fact pal_mintlo_r = 0.4235
    fact pal_mintlo_g = 0.7373
    fact pal_mintlo_b = 0.6118
    fact pal_minthi_r = 0.8627
    fact pal_minthi_g = 0.9725
    fact pal_minthi_b = 0.9255
    fact pal_onmint_r = 0.0627
    fact pal_onmint_g = 0.0863
    fact pal_onmint_b = 0.1020
    fact pal_tint_r = 0.1059
    fact pal_tint_g = 0.1294
    fact pal_tint_b = 0.1529
    fact pal_panel_r = 0.0863
    fact pal_panel_g = 0.1020
    fact pal_panel_b = 0.1216
    fact pal_deep_r = 0.0431
    fact pal_deep_g = 0.0549
    fact pal_deep_b = 0.0667
    fact pal_off_r = 0.2275
    fact pal_off_g = 0.2510
    fact pal_off_b = 0.2824
    fact pal_alert_r = 0.9373
    fact pal_alert_g = 0.2667
    fact pal_alert_b = 0.2667

    fact room_t = 0
    fact room_r = 0
    fact room_b = 0
    fact room_l = 0
    fact look = 0

    fact slot_open = false
    fact slot_sw = 0
    fact slot_sh = 0
    text slot_mon = ""
    fact mon_known = false
    fact mon_c0 = false
    fact mon_c1 = false
    fact mon_c2 = false
    fact mon_c3 = false
    fact slot_x = 0
    fact slot_y = 0
    fact slot_w = 0
    fact slot_h = 0
    let mon_here = if(screen.index == 0, if(mon_c0, 1, 0), if(screen.index == 1, if(mon_c1, 1, 0), if(screen.index == 2, if(mon_c2, 1, 0), if(mon_c3, 1, 0))))
    let shown = if(slot_open and (if(mon_known, mon_here > 0.5, slot_sw == 0 or (screen.width == slot_sw and screen.height == slot_sh))), 1, 0)

    let u = 1.1
    let fr = if(shown > 0.5, floor(time * 8), 0)

    prop wk = 0 ~700ms
    prop en1 = 0 ~200ms
    prop en2 = 0 ~380ms
    prop en3 = 0 ~520ms
    on change shown while shown > 0.5 { wk: 1; en1: 1 after 200ms; en2: 1 after 200ms; en3: 1 after 200ms }
    on change shown while shown < 0.5 { wk: 0 ~80ms; en1: 0 ~80ms; en2: 0 ~80ms; en3: 0 ~80ms; en1: 0 ~80ms after 205ms; en2: 0 ~80ms after 205ms; en3: 0 ~80ms after 205ms }
    every 500ms while shown > 0.5 and en1 < 0.002 { en1: 1 after 200ms; en2: 1 after 200ms; en3: 1 after 200ms }

    //  What eq.luau reports: whether the EQ is on, which preset is lit (-1: your own curve), what to say under the name, and the ten gains in dB.
    fact eq_on = 0
    fact cur = 0
    text status = "Off"
    fact held = -1
    event eq_toggle ->
    event preset ->
    event bset ->
    repeat i in 0..10 {
        fact g.$i = 0
    }
    prop ea = 0 ~calm
    follow ea = eq_on
    let dim = 0.45 + 0.55 * ea

    //  The spectrum eq.luau gets from vitreus-eq while the panel is out: a level and a peak for each band, 0 to 1. Each goes through a spring so the bars move like light, not like numbers.
    //  `fl` is the flash that runs along the bands when the switch goes on.
    repeat i in 0..10 {
        fact lv.$i = 0
        fact pk.$i = 0
        prop ls.$i = 0 ~90ms
        prop ps.$i = 0 ~140ms
        prop fl.$i = 0 ~160ms
        follow ls.$i = lv.$i
        follow ps.$i = pk.$i
    }
    on change eq_on while eq_on > 0.5 {
        fl.0: 1 ~70ms after 0ms
        fl.0: 0 ~420ms after 120ms
        fl.1: 1 ~70ms after 45ms
        fl.1: 0 ~420ms after 165ms
        fl.2: 1 ~70ms after 90ms
        fl.2: 0 ~420ms after 210ms
        fl.3: 1 ~70ms after 135ms
        fl.3: 0 ~420ms after 255ms
        fl.4: 1 ~70ms after 180ms
        fl.4: 0 ~420ms after 300ms
        fl.5: 1 ~70ms after 225ms
        fl.5: 0 ~420ms after 345ms
        fl.6: 1 ~70ms after 270ms
        fl.6: 0 ~420ms after 390ms
        fl.7: 1 ~70ms after 315ms
        fl.7: 0 ~420ms after 435ms
        fl.8: 1 ~70ms after 360ms
        fl.8: 0 ~420ms after 480ms
        fl.9: 1 ~70ms after 405ms
        fl.9: 0 ~420ms after 525ms
    }
    let energy = (ls.0 + ls.1 + ls.2 + ls.3 + ls.4 + ls.5 + ls.6 + ls.7 + ls.8 + ls.9) / 10

    let left = slot_x - slot_w / 2
    let top = slot_y - slot_h / 2
    let wd = slot_w - 48
    let x0 = left + 24

    //  The bands: 12 dB up and down. A column is 1/10 of the width; y is worked out the same way in the rules below.
    let by0 = top + 138 * u
    let by1 = top + slot_h - 34 * u
    let bh = by1 - by0
    let bym = (by0 + by1) / 2
    let colw = wd / 10
    let ky[10]
    repeat i in 0..10 {
        ky[i] = by0 + (12 - g.$i) / 24 * bh
    }

    group {
        opacity: en1
        move: 0, (1 - en1) * 12

        //  ── the switch card ──
        let cy0 = top + 6
        let ch0 = 58 * u
        let con = eq_on
        let chot = if(con > 0.5 or card_z.hover > 0.5, 1, 0)
        box { from: x0, cy0; size: wd, ch0; corner: 12 * u; color: mint; opacity: 5% * card_z.hover * shown }
        PFill(tx: x0, ty: cy0, tw: wd, th: ch0, sx: x0 + wd - 26 * u, sy: cy0 + ch0 / 2, on: con, av: shown)
        PRound(x: x0 + 2.6 * u, y: cy0 + 2.6 * u, w: wd - 5.2 * u, h: ch0 - 5.2 * u, r: 9.7 * u, s: 1, wd: 1.7 * u, c: mix(faint, mint, con), a: (0.5 + 0.45 * con) * shown, f: chot * fr)
        PSwitch(sx: x0 + wd - 26 * u, sy: cy0 + ch0 / 2, on: con, av: shown, s: 7, f: chot * fr)
        //  the icon: three faders
        repeat k in 0..3 {
            PLn(ax: x0 + (24 + k * 8) * u, ay: cy0 + ch0 / 2 - 9 * u, bx: x0 + (24 + k * 8) * u, by: cy0 + ch0 / 2 + 9 * u, s: 20 + k, wd: 1.8 * u, c: mix(faint, mint, con), a: shown, f: chot * fr)
            ellipse { at: x0 + (24 + k * 8) * u, cy0 + ch0 / 2 + (pick(k, 3, -4, 1) - 6 * pick(k, ls.1, ls.4, ls.7)) * u; radius: (3 + 1.5 * pick(k, ls.1, ls.4, ls.7)) * u; color: mix(faint, mint, con); opacity: 80% * shown }
        }
        text "Equalizer" { at: x0 + 54 * u, cy0 + ch0 / 2 - 8.5 * u; anchor: left center; size: 13.5 * u; weight: 700; color: ink; opacity: shown; family: "Space Grotesk" }
        text status { at: x0 + 54 * u, cy0 + ch0 / 2 + 8.5 * u; anchor: left center; size: 11 * u; weight: 600; width: wd - 110 * u; lines: 1; color: mix(faint, mint, con); opacity: shown; family: "Space Grotesk" }
        zone box card_z { from: x0, cy0; size: wd, ch0; corner: 12 * u; cursor: pointer; label: "Equalizer on or off"; active: shown > 0.5 }
        on press card_z { emit eq_toggle }
    }

    group {
        opacity: en2
        move: 0, (1 - en2) * 12

        //  ── presets ──
        let py = top + 6 + 58 * u + 14 * u
        let pg = 8
        let pw = (wd - 4 * pg) / 5
        let ph = 28 * u
        repeat k in 0..5 {
            let on_k = if(cur == k, 1, 0)
            box { from: x0 + k * (pw + pg), py; size: pw, ph; corner: ph / 2; color: if(on_k > 0.5, mint, ink); opacity: (if(on_k > 0.5, 85%, 10% + 8% * chip.$k.hover)) * shown * dim }
            text pick(k, "Flat", "Bass", "Vocal", "Treble", "Loud") { at: x0 + k * (pw + pg) + pw / 2, py + ph / 2; anchor: center; size: 11.5 * u; weight: 700; color: if(on_k > 0.5, onmint, ink); opacity: shown; family: "Space Grotesk" }
            zone box chip.$k { from: x0 + k * (pw + pg), py; size: pw, ph; corner: ph / 2; cursor: pointer; label: "Preset"; active: shown > 0.5 }
            on press chip.$k { emit preset(k) }
        }
    }

    group {
        opacity: en3
        move: 0, (1 - en3) * 12

        //  ── the ten bands ──
        //  A glow behind the bands that breathes with the whole sound.
        box { at: x0 + wd / 2, bym; size: wd + 16 * u, bh + 10 * u; corner: 16 * u; color: mint; opacity: (3% + 11% * energy) * shown * ea }
        //  The spectrum: sixteen little lights up each band, lit from the bottom to the level, the top ones warm, a peak that falls slowly. With a glow so it reads as light.
        group {
            glow: 5, 60%
            repeat i in 0..10 {
                repeat k in 0..16 {
                    box { at: x0 + colw * (i + 0.5), by1 - (k + 0.5) * bh / 16; size: colw * 0.62, bh / 16 * 0.6; corner: 1.5 * u; color: if(k > 12, alert, mix(mintlo, minthi, k / 12)); opacity: clamp(ls.$i * 16 - k, 0, 1) * 0.5 * shown }
                }
                box { at: x0 + colw * (i + 0.5), by1 - ps.$i * bh; size: colw * 0.62, 2 * u; corner: 1 * u; color: minthi; opacity: clamp(ps.$i * 25, 0, 1) * 0.9 * shown }
            }
        }
        line { from: x0, bym; to: x0 + wd, bym; width: 1; color: ink; opacity: 22% * shown }
        //  The curve through the knobs and a halo for each that swells with its band (and flashes when the switch goes on): behind the knobs, so each knob is a solid cap on top of them.
        group {
            glow: 9 + 9 * energy, 100%, mint
            path {
                at: 0, 0
                stroke: 1.8 * u
                color: mix(mint, minthi, energy)
                opacity: 80% * shown * dim
                move x0 + colw * 0.5, ky[0]
                line x0 + colw * 1.5, ky[1]
                line x0 + colw * 2.5, ky[2]
                line x0 + colw * 3.5, ky[3]
                line x0 + colw * 4.5, ky[4]
                line x0 + colw * 5.5, ky[5]
                line x0 + colw * 6.5, ky[6]
                line x0 + colw * 7.5, ky[7]
                line x0 + colw * 8.5, ky[8]
                line x0 + colw * 9.5, ky[9]
            }
            repeat i in 0..10 {
                ellipse { at: x0 + colw * (i + 0.5), ky[i]; radius: (7 + 9 * ls.$i + 12 * fl.$i) * u; color: mix(mint, minthi, fl.$i); opacity: (14% + 34% * ls.$i + 50% * fl.$i) * shown * dim }
            }
        }
        repeat i in 0..10 {
            let cxi = x0 + colw * (i + 0.5)
            let hot = if(band.$i.hover > 0.5 or held == i, 1, 0)
            //  the track, the stretch from 0 dB to the knob, the knob
            PLn(ax: cxi, ay: by0, bx: cxi, by: by1, s: 40 + i, wd: 1.4 * u, c: ink, a: 0.4 * shown * dim, f: hot * fr)
            box { at: cxi, (ky[i] + bym) / 2; size: 5 * u, abs(ky[i] - bym) + 0.01; corner: 2.5 * u; color: mint; opacity: 50% * shown * dim }
            ellipse { at: cxi, ky[i]; radius: 8 * u; color: deep; opacity: 94% * shown }
            ellipse { at: cxi, ky[i]; radius: 2.6 * u; color: mix(faint, mint, ea); opacity: (0.55 + 0.45 * ea) * shown }
            PCir(cx: cxi, cy: ky[i], rad: 8 * u, s: 60 + i, wd: 1.8 * u, c: mix(ink, mint, ea), a: 0.95 * shown, gapk: -1, f: hot * fr)
            //  the dB of the band under the pointer, and the frequency of every band
            text number(g.$i, 1, " dB") { at: cxi, by0 - 14 * u; anchor: center; size: 10.5 * u; weight: 700; color: mint; opacity: hot * shown; family: "Space Grotesk" }
            text pick(i, "32", "64", "125", "250", "500", "1k", "2k", "4k", "8k", "16k") { at: cxi, by1 + 16 * u; anchor: center; size: 10.5 * u; weight: 600; color: faint; opacity: shown; family: "Space Grotesk" }
            zone box band.$i { from: x0 + colw * i, by0 - 12 * u; size: colw, bh + 24 * u; cursor: pointer; label: "Band"; active: shown > 0.5 }
            on press band.$i { held = i; emit bset(i * 1000 + floor((12 - 24 * clamp((pointer.y - by0) / bh, 0, 1)) * 10 + 120.5)) }
            on drag band.$i { emit bset(i * 1000 + floor((12 - 24 * clamp((pointer.y - by0) / bh, 0, 1)) * 10 + 120.5)) }
            on release band.$i { held = -1 }
            on press right band.$i { emit bset(i * 1000 + 120) }
        }
        //  Sparks off the bands that are loud, over the knobs.
        group {
            glow: 6, 100%, mint
            repeat i in 0..10 {
                particles {
                    at: x0 + colw * (i + 0.5), ky[i]; count: 16
                    life: 0.5s .. 1.1s; speed: 25 .. 70
                    direction: -90deg; spread: 40deg; gravity: 0, -25
                    size: 2.4 * u, 0; colors: mint, minthi
                    emit: ls.$i > 0.5 and eq_on > 0.5 and shown > 0.5
                }
            }
        }
    }
}
