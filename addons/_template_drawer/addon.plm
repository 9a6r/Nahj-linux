language 0.1
import "addon-palette.plm"

//  A Vitreus add-on with a PANEL: the shell puts the add-on's icon on the add-on pill (the pill of icons in the corner the app dock is not in) and draws a panel out of it
//  (the same glass as its own drawers) with a title bar of its own (the add-on's name, a grip to pull it by and an X), and this scene draws what is below the bar. `icon`
//  and `[drawer]` in addon.toml ask for it. A click on the icon opens the panel (or `pleamar --say vitreus "emit ax_toggle"`, which a key can run). Like the Desk it stays
//  until its X or its icon shuts it, and it can be pulled away from the pill and left anywhere.
//
//  Vitreus tells this scene where the content goes, as the panel settles: `slot_x`, `slot_y` the middle of it, `slot_w`, `slot_h` its size, in pixels of the screen
//  (below the title bar), and `slot_open` (true while the panel is out and not being pulled). Draw inside that rectangle only. It also tells it, as in the other template, the palette (`pal_*`), the bar's room
//  (`room_*`), the theme's shape (`look`) and the forecast (`wx_*`).
//
//  What this cannot do yet: take text (the shell's drawers hold the keyboard while one is open, an add-on's scene does not), or show on more than one monitor.
//
//  The logic is addon.luau beside this file (the scene's name with .luau): it keeps what it must in the scene's own data folder with the `files` services below, and any
//  program it runs (`run("wl-paste", ...)`, `curl`, a helper of your own) has to be named in `permissions`. Since there is no text field, take text from the clipboard: a button
//  that runs `wl-paste`. The shell sets `wx_*` texts on a scene that declares them: name your own weather facts something else (the News & Weather add-on uses `nw_*`).

scene MyDrawer {
    surface { size: full, full; anchor: top_left; margin: 0; level: top; screens: each max 4 }

    permissions {
        services: "files", "files.write"          // what addon.luau uses to keep `clicks`
        // run: "wl-paste", "curl"                // the programs the logic may run, by name (this one runs none)
    }

    fact pal_ink_r = 0.9608
    fact pal_ink_g = 0.9686
    fact pal_ink_b = 0.9608
    fact pal_faint_r = 0.7608
    fact pal_faint_g = 0.7804
    fact pal_faint_b = 0.8000
    fact pal_mint_r = 0.6196
    fact pal_mint_g = 0.8392
    fact pal_mint_b = 0.7412
    fact pal_mintlo_r = 0.4235
    fact pal_mintlo_g = 0.7373
    fact pal_mintlo_b = 0.6118
    fact pal_minthi_r = 0.8627
    fact pal_minthi_g = 0.9725
    fact pal_minthi_b = 0.9255
    fact pal_onmint_r = 0.0627
    fact pal_onmint_g = 0.0863
    fact pal_onmint_b = 0.1020
    fact pal_tint_r = 0.1059
    fact pal_tint_g = 0.1294
    fact pal_tint_b = 0.1529
    fact pal_panel_r = 0.0863
    fact pal_panel_g = 0.1020
    fact pal_panel_b = 0.1216
    fact pal_deep_r = 0.0431
    fact pal_deep_g = 0.0549
    fact pal_deep_b = 0.0667
    fact pal_off_r = 0.2275
    fact pal_off_g = 0.2510
    fact pal_off_b = 0.2824
    fact pal_alert_r = 0.9373
    fact pal_alert_g = 0.2667
    fact pal_alert_b = 0.2667

    fact room_t = 0
    fact room_r = 0
    fact room_b = 0
    fact room_l = 0
    fact look = 0
    fact wx_ok = false
    text wx_temp = ""
    text wx_desc = ""

    fact slot_open = false
    fact slot_sw = 0                                  // the size of the monitor the panel is on: the scene has a copy on each (`screens: each`, numbered in its own order) and only the copy of that size draws (0: not told yet, every copy does)
    fact slot_sh = 0
    fact slot_x = 0
    fact slot_y = 0
    fact slot_w = 0
    fact slot_h = 0
    let shown = if(slot_open and (slot_sw == 0 or (screen.width == slot_sw and screen.height == slot_sh)), 1, 0)       // 1 on the copy that is on the panel's monitor, while the panel is out

    fact clicks = 0
    let left = slot_x - slot_w / 2
    let top = slot_y - slot_h / 2

    text "Your panel goes here" { at: left + 24, top + 28; anchor: left center; size: 18; weight: 700; color: ink; opacity: shown; family: "Space Grotesk" }
    text wx_temp { at: left + 24, top + 56; anchor: left center; size: 16; color: faint; opacity: shown; family: "Space Grotesk" }
    box { at: left + 70, top + 104; size: 124, 36; corner: 18; color: mint; opacity: 80% * shown }
    text "Press me" { at: left + 70, top + 104; anchor: center; size: 15; weight: 700; color: onmint; opacity: shown; family: "Space Grotesk" }
    zone box press_me { at: left + 70, top + 104; size: 124, 36; corner: 18; cursor: pointer; active: shown > 0.5 }
    on press press_me { clicks = clicks + 1 }
    repeat i in 0..8 {
        ellipse { at: left + 150 + i * 16, top + 104; radius: 5; color: mint; opacity: if(clicks > i, 1, 0.2) * shown }
    }
}
