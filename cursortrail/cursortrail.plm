language 0.1
import "../palette.plm"

//  The UwU cursor trail: little sparkles that fall away behind the mouse, in the theme's candy pinks. It is a full-screen
//  surface that catches nothing (it has no zones, so every click goes through), and it draws only while `look` says UwU.
//  Vitreus tells it the theme:   pleamar --say cursortrail "fact look 2"   (0 Glass, 1 Retro, 2 UwU, 3 Cyber)

scene CursorTrail {
    surface { size: full, full; anchor: top_left; margin: 0; level: overlay; screens: each; reserve: -1 }

    fact look = 0

    //  Where the mouse was a moment ago: the trail is born only while it has moved away from there.
    prop lx = 0 ~60ms
    prop ly = 0 ~60ms
    follow lx = cursor.x
    follow ly = cursor.y
    let moving = (look == 2) and (abs(cursor.x - lx) + abs(cursor.y - ly) > 3)

    group {
        glow: 3, 50%
        particles sparkle {
            at: cursor.x, cursor.y; area: 6, 6
            count: 40; life: 0.35s .. 0.7s
            speed: 4 .. 26; spread: 360deg; gravity: 0, 36; drag: 1.2
            size: 3, 0.5; colors: minthi, mint; opacity: 70%, 0%
            shape: dot; emit: moving
        }
        particles dots {
            at: cursor.x, cursor.y; area: 10, 10
            count: 16; life: 0.4s .. 0.8s
            speed: 0 .. 14; gravity: 0, 20; drag: 1
            size: 2.5, 0.5; colors: #ffffff, #5fe3d6; opacity: 60%, 0%
            shape: dot; emit: moving
        }
    }
}
