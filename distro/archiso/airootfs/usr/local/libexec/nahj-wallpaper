#!/usr/bin/env bash
set -euo pipefail
for _ in {1..300}; do
    if awww query >/dev/null 2>&1; then
        # awww restore exits successfully even with no saved wallpaper. Keep our own
        # marker so the first desktop is never an empty compositor background.
        marker=${XDG_DATA_HOME:-$HOME/.local/share}/nahj/wallpaper-initialized
        if [[ -e "$marker" ]]; then
            exec awww restore
        fi
        awww img /usr/share/nahj/vitreus/assets/greeter.jpeg --transition-type fade --transition-duration 1
        mkdir -p "${marker%/*}"
        touch "$marker"
        exit 0
    fi
    sleep 0.2
done
printf '%s\n' 'Nahj: wallpaper daemon did not become ready' >&2
exit 1
