#!/usr/bin/env bash
set -euo pipefail
deadline=$((SECONDS + 60))
while (( SECONDS < deadline )); do
    # The daemon socket can answer before Wayland outputs are registered.
    # Retry failed image requests too; never mark a failed first setup complete.
    outputs=$(timeout 5s awww query 2>/dev/null || true)
    if [[ -n "$outputs" ]]; then
        # awww restore exits successfully even with no saved wallpaper. Keep our own
        # marker so the first desktop is never an empty compositor background.
        marker=${XDG_DATA_HOME:-$HOME/.local/share}/nahj/wallpaper-initialized
        if [[ -e "$marker" ]]; then
            if timeout 20s awww restore; then exit 0; fi
        elif timeout 20s awww img /usr/share/nahj/vitreus/assets/greeter.jpeg --transition-type fade --transition-duration 1; then
            mkdir -p "${marker%/*}"
            touch "$marker"
            exit 0
        fi
    fi
    sleep 0.2
done
printf '%s\n' 'Nahj: wallpaper output did not become ready or image request failed' >&2
exit 1
