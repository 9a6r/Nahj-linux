#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.local/bin:/usr/local/bin:$PATH"
export XDG_CURRENT_DESKTOP=Hyprland XDG_SESSION_DESKTOP=Hyprland XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM='wayland;xcb'
export MOZ_ENABLE_WAYLAND=1
# Software Vulkan cannot reliably export frames as DMA-BUFs on virtual GPUs.
# Keep the original portable presentation path for CPU or inconclusive probes.
# shellcheck source=../libexec/nahj-vulkan-env
source /usr/local/libexec/nahj-vulkan-env
/usr/local/bin/nahj-session-init
# SDDM provides the user bus; direct TTY launches get their own session bus.
if [[ -n ${DBUS_SESSION_BUS_ADDRESS:-} ]]; then
    exec Hyprland
fi
exec dbus-run-session -- Hyprland
