+void
+UserTests::testNahjPasswordPolicy()
+{
+    const QString path = qEnvironmentVariable( "NAHJ_USERS_CONFIG" );
+    if ( path.isEmpty() )
+    {
+        QSKIP( "Set NAHJ_USERS_CONFIG to test the actual Nahj installer policy." );
+    }
+    bool ok = false;
+    const auto map = Calamares::YAML::load( QFileInfo( path ), &ok );
+    QVERIFY( ok );
+    Config c;
+    c.setConfigurationMap( map );
+    QVERIFY( !c.permitWeakPasswords() );
+    QVERIFY( c.requireStrongPasswords() );
+    const QList< QPair< QString, bool > > cases = {
+        { QString(), false },
+        { QStringLiteral( "1234567" ), false },
+        { QStringLiteral( "12345678" ), true },
+        { QString( 128, QChar( 'x' ) ), true },
+        { QString( 129, QChar( 'x' ) ), false },
+        { QString( 512, QChar( 'x' ) ), false },
+        { QString( 128, QChar( 0x0633 ) ), true },
+        { QString::fromUtf8( "كلمة مرور اختبارية" ), true },
+        { QStringLiteral( "quotes'$` spaces!" ), true },
+        { QStringLiteral( "validpass" ) + QChar( u'\0' ) + QStringLiteral( "suffix" ), false }
+    };
+    for ( const auto& entry : cases )
+    {
+        c.setUserPassword( entry.first );
+        c.setUserPasswordSecondary( entry.first );
+        QCOMPARE( c.userPasswordValidity() != Config::PasswordValidity::Invalid, entry.second );
+        c.setUserPasswordSecondary( entry.first + QStringLiteral( "mismatch" ) );
+        QCOMPARE( c.userPasswordValidity(), int( Config::PasswordValidity::Invalid ) );
+    }
+}
+
+void
+UserTests::testRejectedPasswordHash()
+{
+    QTemporaryDir directory;
+    QVERIFY( directory.isValid() );
+    auto* storage = Calamares::JobQueue::instance()->globalStorage();
+    const QVariant previous = storage->value( "rootMountPoint" );
+    storage->insert( "rootMountPoint", directory.path() );
+    for ( const auto& password : { QString( 512, QChar( 'x' ) ),
+                                   QStringLiteral( "prefix" ) + QChar( u'\0' ) + QStringLiteral( "suffix" ) } )
+    {
+        SetPasswordJob job( QStringLiteral( "nahj-test-no-account" ), password );
+        auto result = job.exec();
+        QVERIFY( !result );
+        QCOMPARE( result.message(), QStringLiteral( "Cannot create a valid password hash." ) );
+    }
+    storage->insert( "rootMountPoint", previous );
+}
