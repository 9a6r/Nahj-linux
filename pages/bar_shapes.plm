part BarShapes {
            //  the calendar included, is a drawer of its own that drops from it, below.
            box shell { at: cx, mix(bar.y0 + pop / 2, yo + th.t / 2, fm); size: mix(bar.w + pv * 10 * u, screen.width, fm), mix(bar.h + pop, th.t, fm); corner: mix(bar.rad, 0, fm) }
            //  Down the left: the strip, and the frame's other two edges, plain rectangles. The inside corners are rounded by a ring: a rounded
            //  rectangle drawn as an outline as thick as the frame, whose inner edge is the opening (its left side lies in the strip), so the corners
            //  are exact curves and the glass's edge light runs round them unbroken. The ring has NO NAME on purpose: a named shape takes clicks across
            //  its whole bounding box, and the ring's is the whole screen. The ring is 50 * u thicker than the frame, outwards, so that its outer curve is off
            //  the screen: inside the screen it made a one-pixel speck of edge light at the corners. When the left layout is not in it is moved 30000 px away
            //  (`show:` does not take it off the glass, and a ring thinned to a hair counts as a filled box and frosts the whole screen).
            //  The strip's side of the drip (see `dj.*`): all melted into the strip and the drawers, so that the neck and the bulge are not drawn, they are
            //  what the distances between the shapes make. Moved off the screen outside the left layout (`show:` does not take a shape off the glass).
            ellipse { at: mix(lf.w, ccx, edg) + dj.px, mix(dj.y0, dj.ey, edg); radius: 30 * u; scale: mix(dj.sag / (30 * u), 1, edg), mix(1, dj.sag / (30 * u), edg); blend: (16 * u * clamp(dj.sag / (6 * u), 0, 1)) * bk }
            ellipse { at: mix(lf.w, ccx - dj.ripx, edg) + dj.px, mix(dj.y0 - dj.ripx, dj.ey, edg); radius: 9 * u; scale: mix(max(dj.riph, 0.3) / (9 * u), 1, edg), mix(1, max(dj.riph, 0.3) / (9 * u), edg); blend: (8 * u * clamp(dj.riph / (3 * u), 0, 1)) * bk }
            ellipse { at: mix(lf.w, ccx + dj.ripx, edg) + dj.px, mix(dj.y0 + dj.ripx, dj.ey, edg); radius: 9 * u; scale: mix(max(dj.riph, 0.3) / (9 * u), 1, edg), mix(1, max(dj.riph, 0.3) / (9 * u), edg); blend: (8 * u * clamp(dj.riph / (3 * u), 0, 1)) * bk }
            ellipse { at: mix(lf.w + dj.stray * 0.7, ccx, edg) + dj.px, mix(dj.y0, dj.ey + dj.es * dj.stray * 0.7, edg); radius: max(dj.stray, 0.3); blend: (7 * u * clamp(dj.stray / (3 * u), 0, 1)) * bk }
            ellipse { at: th.l / 2 + dj.spx, lp.cy; radius: 30 * u; scale: dj.sag / (30 * u), 1; blend: (16 * u * clamp(dj.sag / (6 * u), 0, 1)) * bk }
            ellipse { at: th.l / 2 + dj.spx, lp.cy - dj.ripx; radius: 9 * u; scale: max(dj.riph, 0.3) / (9 * u), 1; blend: (8 * u * clamp(dj.riph / (3 * u), 0, 1)) * bk }
            ellipse { at: th.l / 2 + dj.spx, lp.cy + dj.ripx; radius: 9 * u; scale: max(dj.riph, 0.3) / (9 * u), 1; blend: (8 * u * clamp(dj.riph / (3 * u), 0, 1)) * bk }
            ellipse { at: th.l / 2 + dj.stray * 0.7 + dj.spx, lp.cy; radius: max(dj.stray, 0.3); blend: (7 * u * clamp(dj.stray / (3 * u), 0, 1)) * bk }
            box lf_left { at: th.l * fm / 2, vc; size: th.l * fm, vh; show: fm > 0.004 }
            box lf_right { at: screen.width - th.r * fm / 2, vc; size: th.r * fm, vh; show: fm > 0.004 }
            box lf_bottom { at: cx, vb - th.b * fm / 2; size: screen.width, th.b * fm; show: fm > 0.004 }
            //  The audio visualiser: the edge of the screen rising into the music, as columns of the same glass standing on the frame's inner edge and melted into it (and into each other) like a drawer's neck.
            //  Where each stands, which way it points and how long it is are worked out in vitreus.plm (`fwx_*`, `fwy_*`, `fwdx_*`, `fwdy_*`, `fwh_*`) from the options (Settings > Widgets): along the bottom, the top,
            //  the left or the right, or fanned out of the four corners. Without the frame (the Island) they stand on the screen's edge. Moved off the screen while a column has no length (`show:` does not take a shape off the glass).
            box { at: fwx_0 + if(fwh_0 > 1, 0, 30000), fwy_0; size: fw.bw, fwh_0 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_0, 0 - fwdy_0) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_1 + if(fwh_1 > 1, 0, 30000), fwy_1; size: fw.bw, fwh_1 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_1, 0 - fwdy_1) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_2 + if(fwh_2 > 1, 0, 30000), fwy_2; size: fw.bw, fwh_2 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_2, 0 - fwdy_2) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_3 + if(fwh_3 > 1, 0, 30000), fwy_3; size: fw.bw, fwh_3 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_3, 0 - fwdy_3) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_4 + if(fwh_4 > 1, 0, 30000), fwy_4; size: fw.bw, fwh_4 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_4, 0 - fwdy_4) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_5 + if(fwh_5 > 1, 0, 30000), fwy_5; size: fw.bw, fwh_5 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_5, 0 - fwdy_5) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_6 + if(fwh_6 > 1, 0, 30000), fwy_6; size: fw.bw, fwh_6 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_6, 0 - fwdy_6) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_7 + if(fwh_7 > 1, 0, 30000), fwy_7; size: fw.bw, fwh_7 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_7, 0 - fwdy_7) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_8 + if(fwh_8 > 1, 0, 30000), fwy_8; size: fw.bw, fwh_8 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_8, 0 - fwdy_8) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_9 + if(fwh_9 > 1, 0, 30000), fwy_9; size: fw.bw, fwh_9 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_9, 0 - fwdy_9) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_10 + if(fwh_10 > 1, 0, 30000), fwy_10; size: fw.bw, fwh_10 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_10, 0 - fwdy_10) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_11 + if(fwh_11 > 1, 0, 30000), fwy_11; size: fw.bw, fwh_11 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_11, 0 - fwdy_11) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_12 + if(fwh_12 > 1, 0, 30000), fwy_12; size: fw.bw, fwh_12 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_12, 0 - fwdy_12) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_13 + if(fwh_13 > 1, 0, 30000), fwy_13; size: fw.bw, fwh_13 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_13, 0 - fwdy_13) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_14 + if(fwh_14 > 1, 0, 30000), fwy_14; size: fw.bw, fwh_14 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_14, 0 - fwdy_14) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_15 + if(fwh_15 > 1, 0, 30000), fwy_15; size: fw.bw, fwh_15 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_15, 0 - fwdy_15) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_16 + if(fwh_16 > 1, 0, 30000), fwy_16; size: fw.bw, fwh_16 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_16, 0 - fwdy_16) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_17 + if(fwh_17 > 1, 0, 30000), fwy_17; size: fw.bw, fwh_17 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_17, 0 - fwdy_17) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_18 + if(fwh_18 > 1, 0, 30000), fwy_18; size: fw.bw, fwh_18 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_18, 0 - fwdy_18) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_19 + if(fwh_19 > 1, 0, 30000), fwy_19; size: fw.bw, fwh_19 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_19, 0 - fwdy_19) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_20 + if(fwh_20 > 1, 0, 30000), fwy_20; size: fw.bw, fwh_20 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_20, 0 - fwdy_20) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_21 + if(fwh_21 > 1, 0, 30000), fwy_21; size: fw.bw, fwh_21 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_21, 0 - fwdy_21) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_22 + if(fwh_22 > 1, 0, 30000), fwy_22; size: fw.bw, fwh_22 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_22, 0 - fwdy_22) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_23 + if(fwh_23 > 1, 0, 30000), fwy_23; size: fw.bw, fwh_23 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_23, 0 - fwdy_23) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_24 + if(fwh_24 > 1, 0, 30000), fwy_24; size: fw.bw, fwh_24 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_24, 0 - fwdy_24) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_25 + if(fwh_25 > 1, 0, 30000), fwy_25; size: fw.bw, fwh_25 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_25, 0 - fwdy_25) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_26 + if(fwh_26 > 1, 0, 30000), fwy_26; size: fw.bw, fwh_26 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_26, 0 - fwdy_26) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_27 + if(fwh_27 > 1, 0, 30000), fwy_27; size: fw.bw, fwh_27 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_27, 0 - fwdy_27) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_28 + if(fwh_28 > 1, 0, 30000), fwy_28; size: fw.bw, fwh_28 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_28, 0 - fwdy_28) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_29 + if(fwh_29 > 1, 0, 30000), fwy_29; size: fw.bw, fwh_29 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_29, 0 - fwdy_29) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_30 + if(fwh_30 > 1, 0, 30000), fwy_30; size: fw.bw, fwh_30 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_30, 0 - fwdy_30) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_31 + if(fwh_31 > 1, 0, 30000), fwy_31; size: fw.bw, fwh_31 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_31, 0 - fwdy_31) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_32 + if(fwh_32 > 1, 0, 30000), fwy_32; size: fw.bw, fwh_32 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_32, 0 - fwdy_32) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_33 + if(fwh_33 > 1, 0, 30000), fwy_33; size: fw.bw, fwh_33 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_33, 0 - fwdy_33) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_34 + if(fwh_34 > 1, 0, 30000), fwy_34; size: fw.bw, fwh_34 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_34, 0 - fwdy_34) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_35 + if(fwh_35 > 1, 0, 30000), fwy_35; size: fw.bw, fwh_35 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_35, 0 - fwdy_35) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_36 + if(fwh_36 > 1, 0, 30000), fwy_36; size: fw.bw, fwh_36 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_36, 0 - fwdy_36) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_37 + if(fwh_37 > 1, 0, 30000), fwy_37; size: fw.bw, fwh_37 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_37, 0 - fwdy_37) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_38 + if(fwh_38 > 1, 0, 30000), fwy_38; size: fw.bw, fwh_38 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_38, 0 - fwdy_38) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_39 + if(fwh_39 > 1, 0, 30000), fwy_39; size: fw.bw, fwh_39 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_39, 0 - fwdy_39) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_40 + if(fwh_40 > 1, 0, 30000), fwy_40; size: fw.bw, fwh_40 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_40, 0 - fwdy_40) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_41 + if(fwh_41 > 1, 0, 30000), fwy_41; size: fw.bw, fwh_41 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_41, 0 - fwdy_41) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_42 + if(fwh_42 > 1, 0, 30000), fwy_42; size: fw.bw, fwh_42 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_42, 0 - fwdy_42) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_43 + if(fwh_43 > 1, 0, 30000), fwy_43; size: fw.bw, fwh_43 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_43, 0 - fwdy_43) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_44 + if(fwh_44 > 1, 0, 30000), fwy_44; size: fw.bw, fwh_44 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_44, 0 - fwdy_44) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_45 + if(fwh_45 > 1, 0, 30000), fwy_45; size: fw.bw, fwh_45 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_45, 0 - fwdy_45) * 1deg; blend: fw.bl * u * bk }
            box { at: fwx_46 + if(fwh_46 > 1, 0, 30000), fwy_46; size: fw.bw, fwh_46 + 3 * u; corner: fw.bw * 0.45; rotate: atan2(fwdx_46, 0 - fwdy_46) * 1deg; blend: fw.bl * u * bk }
            box { from: th.l - (lf.t + 50 * u) / 2 + if(fm > 0.35, 0, 30000), yo + th.t - (lf.t + 50 * u) / 2 + if(fm > 0.35, 0, 30000); size: screen.width - th.r - th.l + lf.t + 50 * u, vh - th.t - th.b + lf.t + 50 * u; corner: rc + (lf.t + 50 * u) / 2; stroke: lf.t * max(fm, 0.35) + 50 * u * fm }
            //  The drawer is a second shape in the same glass. `blend` melts it into the bar, so where the
            //  narrow drawer meets the wide bar there is a liquid neck, not a corner. It is only there
            //  while it has size: a zero-size shape would leave a stray shadow behind.
            box drawer { at: dk.ex, dk.ey; size: dk.ew * (1 + dj.stretch - 0.07 * dk.bell + 0.003 * wobble), dk.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(dk.ew, dk.eh) / 2, rc, clamp(dk0 * 1.6 - 0.1, 0, 1)); blend: (mix((26 + 20 * dk.bell) * u * min(1, dk0 * 4), mix(dj.neck, (26 + 20 * dk.bell) * u * min(1, dk0 * 4), att), lm)) * bk; show: dk0 > 0.004 }
            box cdrawer { at: dc.ex, dc.ey; size: dc.ew * (1 + dj.stretch - 0.07 * dc.bell + 0.003 * wobble), dc.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(dc.ew, dc.eh) / 2, rc, clamp(dc0 * 1.6 - 0.1, 0, 1)); blend: (mix((26 + 20 * dc.bell) * u * min(1, dc0 * 4) * dc.neck, mix(dj.neck, (26 + 20 * dc.bell) * u * min(1, dc0 * 4), att), lm)) * bk; show: dc0 > 0.004 }
            box sdrawer { at: ds.ex, ds.ey; size: ds.ew * (1 + dj.stretch - 0.07 * ds.bell + 0.003 * wobble), ds.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(ds.ew, ds.eh) / 2, rc, clamp(ds0 * 1.6 - 0.1, 0, 1)); blend: (mix((26 + 20 * ds.bell) * u * min(1, ds0 * 4), dj.neck, fm)) * bk; show: ds0 > 0.004 }
            box ldrawer { at: dl.ex, dl.ey; size: dl.ew * (1 + dj.stretch - 0.07 * dl.bell + 0.003 * wobble), dl.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(dl.ew, dl.eh) / 2, rc, clamp(dl0 * 1.6 - 0.1, 0, 1)); blend: (mix((26 + 20 * dl.bell) * u * min(1, dl0 * 4) * (1 - dl.f * (1 - lm)), dj.neck, fm)) * bk; show: dl0 > 0.004 }
            box odrawer { at: do.ex + if(fm > 0.5, 0, 30000), do.ey; size: do.ew * (1 + do.stretch - 0.07 * do.bell + 0.003 * wobble), do.eh * (1 - do.stretch * 0.5 - 0.002 * wobble); corner: mix(min(do.ew, do.eh) / 2, rc, clamp(do0 * 1.6 - 0.1, 0, 1)); blend: (do.bl) * bk; show: do0 > 0.004 }
            box mdrawer { at: dm.ex, dm.ey; size: dm.ew * (1 + dj.stretch - 0.07 * dm.bell + 0.003 * wobble), dm.eh * (1 - dj.stretch * 0.5 - 0.002 * wobble); corner: mix(min(dm.ew, dm.eh) / 2, rc, clamp(dm0 * 1.6 - 0.1, 0, 1)); blend: (mix((26 + 20 * dm.bell) * u * min(1, dm0 * 4), mix(dj.neck, (26 + 20 * dm.bell) * u * min(1, dm0 * 4), att), lm)) * bk; show: dm0 > 0.004 }
            //  The notches, melted into the frame like the drawers: as tall as the frame while they are in it, and they grow out of it by `nt_vis_*`.
            //  (Moved off the screen outside the Frame layout: `show:` does not take a shape off the glass.)
            box { at: (th.l + nt_d * nt_vis_l) / 2 + if(tm > 0.35, 0, 30000), vcc; size: th.l + nt_d * nt_vis_l, nt_w; corner: 9 * cu * (1 - 0.73 * sq); blend: (9 * u) * bk }
            box { at: ccx + if(lm > 0.35, 0, 30000), yo + (lf.t + nt_d * nt_vis_t) / 2; size: nt_w, lf.t + nt_d * nt_vis_t; corner: 9 * cu * (1 - 0.73 * sq); blend: (9 * u) * bk }
            box { at: ccx + if(fm > 0.35, 0, 30000), vb - (th.b + nt_d * nt_vis_b) / 2; size: nt_w, th.b + nt_d * nt_vis_b; corner: 9 * cu * (1 - 0.73 * sq); blend: (9 * u) * bk }
            box { at: screen.width - (th.r + nt_d * nt_vis_r) / 2 + if(fm > 0.35, 0, 30000), vcc; size: th.r + nt_d * nt_vis_r, nt_w; corner: 9 * cu * (1 - 0.73 * sq); blend: (9 * u) * bk }
            //  The title's small tab: `ptab_d` out of the strip's edge while the title is under the pointer. At rest it is off the screen,
            //  not tucked into the strip: the glass melts shapes that are near each other, and a tucked tab would still bulge the edge.
            box { at: lf.w - 6 * u + (6 * u + ptab_d * ptab_vis) / 2 + if(lm > 0.35 and ptab_vis > 0.01, 0, 30000), lv.tm; size: 6 * u + ptab_d * ptab_vis, ptab_h; corner: 5 * u * (1 - 0.5 * sq); blend: (6 * u * ptab_vis) * bk }
            //  Along the top it hangs from the pill's bottom edge instead, under the title button.
            box { at: ptab_ix + if(lm < 0.65 and ptab_vis > 0.01, 0, 30000), bar.y + bar.h / 2 - 6 * u + (6 * u + ptab_d * ptab_vis) / 2; size: ptab_iw, 6 * u + ptab_d * ptab_vis; corner: 5 * u * (1 - 0.5 * sq); blend: (6 * u * ptab_vis) * bk }
            //  The title's panel's ripple (see `tprip`): the two crests run out along the strip's edge from the panel, as a drop's do. Off the screen when it is not running.
            ellipse { at: lf.w + if(tq.act > 0.5, 0, 30000), lp.cy - tq.x; radius: 9 * u; scale: tq.h / (9 * u), 1; blend: (8 * u * clamp(tq.h / (3 * u), 0, 1)) * bk }
            ellipse { at: lf.w + if(tq.act > 0.5, 0, 30000), lp.cy + tq.x; radius: 9 * u; scale: tq.h / (9 * u), 1; blend: (8 * u * clamp(tq.h / (3 * u), 0, 1)) * bk }
            //  Along the top or the bottom the crests run along the strip's edge from the panel's middle, sideways.
            ellipse { at: pcx - tq.x + if(tq.actt > 0.5, 0, 30000), lf.w; radius: 9 * u; scale: 1, tq.h / (9 * u); blend: (8 * u * clamp(tq.h / (3 * u), 0, 1)) * bk }
            ellipse { at: pcx + tq.x + if(tq.actt > 0.5, 0, 30000), lf.w; radius: 9 * u; scale: 1, tq.h / (9 * u); blend: (8 * u * clamp(tq.h / (3 * u), 0, 1)) * bk }
            //  The frame's side of the desk's liquid (see `dz.sag`): all melted into the frame and the desk, so what shows is what the distances make.
            ellipse { at: screen.width - th.r + dz.px, dz.fy; radius: 30 * u; scale: dz.sag / (30 * u), 1; blend: (16 * u * clamp(dz.sag / (6 * u), 0, 1)) * bk }
            ellipse { at: screen.width - th.r + dz.rpx, dz.fy - dz.ripx; radius: 9 * u; scale: max(dz.riph, 0.3) / (9 * u), 1; blend: (8 * u * clamp(dz.riph / (3 * u), 0, 1)) * bk }
            ellipse { at: screen.width - th.r + dz.rpx, dz.fy + dz.ripx; radius: 9 * u; scale: max(dz.riph, 0.3) / (9 * u), 1; blend: (8 * u * clamp(dz.riph / (3 * u), 0, 1)) * bk }
            ellipse { at: screen.width - th.r - dz.stray * 0.7 + dz.px, dz.fy; radius: max(dz.stray, 0.3); blend: (7 * u * clamp(dz.stray / (3 * u), 0, 1)) * bk }
            box zdrawer { at: dz.fx + if(fm > 0.5, 0, 30000), dz.fcy; size: dz.fw * (1 + dz.stretch - 0.07 * dz.bell), dz.fh * (1 - dz.stretch * 0.5); corner: mix(min(dz.fw, dz.fh) / 2, 26 * u * desk_s * (1 - 0.73 * sq), clamp(dz0 * 1.6 - 0.1, 0, 1)); blend: ((26 + 20 * dz.bell) * u * min(1, dz0 * 4)) * bk; show: dz0 > 0.004 }
            //  The floating media card's side of the frame (`mf.f*`): the same, melted into the frame where it is carried against it.
            box { at: mix(mf.fx, screen.width - mf.fx, rt) + if(fm > 0.5, 0, 30000), mix(mf.fcy, yo + vb - mf.fcy, bt); size: max(0.3, mf.fw * mf.g), max(0.3, mf.fh * mf.g); corner: mix(min(mf.fw, mf.fh) / 2, 26 * u * mf.k * (1 - 0.73 * sq), clamp(mf.g * 1.6 - 0.1, 0, 1)); blend: (26 * u * min(1, mf.g * 4)) * bk; show: mf.g > 0.004 }
}
