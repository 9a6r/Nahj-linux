part BarGlass {
    //  The whole bar, glass and all, is one group so the wave can bend it as one thing.
    group {
        //  Only while it does something: the Retro's pixelation, or a wave that can bend (not on the left, not with the panel half down, and while a beat or a ring is moving).
        //  The rest of the time the group goes without its shader and its full-surface pass (pleamar 0.3.12 and later).
        shader: wave, pv, mix(clamp(ring, 0, 1), 1, lm), mix((mc - (pcx - bar.w / 2)) / bar.w, 0.5, clamp(ring_mid, 0, 1)), lf.w, 2.6 * u * (1 - min(1, drop * 2)) * (1 - lm), bar.w, pxa, lf.t while pxa > 1.5 or (lm < 0.999 and drop < 0.5 and (pv > 0.001 or ring < 0.999))
        //  With the Retro on, a barely visible box over the whole surface makes the group's box the surface, so the pixelation (wave.wgsl) knows where the opening is.
        box { from: 0, 0; size: screen.width, screen.height; color: deep; opacity: 1.2% * cas_k }
        // ── the liquid ───────────────────────────────────────────────
        body {
            color: tint
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend
            frost: glass_clear
            refraction: glass_refr
            dispersion: glass_disp
            rim: 10% * glass_rim + 14% * pv * glass_rim
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            show: obs < 0.996 and not glass_auto
            include "bar_shapes.plm"
        }
        //  The same glass with `frost: auto` (frosted only where what is behind is busy): `frost:` cannot take `auto` from an expression, so it is a body of its own.
        body {
            color: tint
            glass: 100%
            opacity: glass_op * (1 - obs)
            lens: glass_bend
            frost: auto
            refraction: glass_refr
            dispersion: glass_disp
            rim: 10% * glass_rim + 14% * pv * glass_rim
            shine: pointer
            shadow: 0, 1 + 6 * drop + 3 * pv, 6 + 14 * drop + 8 * pv, 8% + 16% * drop + 8% * pv, deep
            show: obs < 0.996 and glass_auto
            include "bar_shapes.plm"
        }
        //  The same shapes again, as flat obsidian: a body with a literal `rim: 0%`, because a `rim` that is an expression keeps a hairline of
        //  light on the edge even when it is worth zero.
        //  Blur behind the obsidian: a glass body asks the compositor for it (100 % glass at 34 %: the request needs glass x opacity of 30 % or more, and a more opaque layer would hide the blur), and the obsidian over it (60 % opaque while blur is on, solid when it is off) hides the glass's look.
        body {
            color: obsidian
            glass: 100%
            lens: false
            rim: 0%
            refraction: 0%
            dispersion: 0%
            shine: 9000, 9000
            opacity: obs * 0.34 * (1 - pk)
            show: obs > 0.97
            include "bar_shapes.plm"
        }
        body {
            color: obsidian
            rim: 0%
            opacity: obs * (1 - 0.4 * clamp(hy_blur, 0, 1))
            shadow: 0, 3 + 6 * drop + 3 * pv, 14 + 14 * drop + 8 * pv, (30% + 16% * drop + 8% * pv) * (1 - pk), #000000
            show: obs > 0.004
            include "bar_shapes.plm"
        }
        //  The Cassette's plastic over it (see `cas_k`): a lit lip, a dark outline, a hard shadow.
        body {
            color: obsidian
            rim: 40% * cas_k
            border: 1.7 * u * cas_k, deep
            shadow: 4.5 * u * cas_k, 5.5 * u * cas_k, 0, 55% * cas_k, deep
            opacity: cas_k
            show: cas_k > 0.004
            include "bar_shapes.plm"
        }
        //  The UwU's candy plastic over it: a pastel gradient across the whole screen (pink, lilac, sky, mint), a thick grape outline, a lit lip and a hard pink shadow.
        body {
            gradient: 0, 0 to screen.width, screen.height, #ffcfe8, #e6d6ff 38%, #cfeaff 68%, #d2fff0
            rim: 55% * uwu_k
            border: 3 * u * uwu_k, deep
            shadow: 4 * u * uwu_k, 5 * u * uwu_k, 0, 90% * uwu_k, mix(deep, #ff6ec7, 0.75)
            opacity: uwu_k
            show: uwu_k > 0.004
            include "bar_shapes.plm"
        }
        //  The Cassette's detail on each drawer, only while it is plastic and the drawer is out: an accent-coloured tab at the top left (opposite the grips) (a console's button), a row of straight vertical grip slots in the bottom right
        //  corner (like the vents of a handheld: dark, with a lit edge) that run a few pixels past the drawer's bottom edge as if they wrapped round the base, and a screw in the bottom left.
        //  Inside the drawer they stay in its margin, so they never touch what it holds.
        group {
            show: cas_k > 0.01 and dk0 > 0.9
            opacity: cas_k * clamp(dk0 * 3 - 2, 0, 1)
            let gdk.l = dk.ex - dk.ew / 2
            let gdk.r = dk.ex + dk.ew / 2
            let gdk.t = dk.ey - dk.eh / 2
            let gdk.b = min(dk.ey + dk.eh / 2, vb - lf.t - 1)
            box { at: gdk.l + 58.5 * u + 2, gdk.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gdk.l + 58.5 * u, gdk.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
            box { at: gdk.l + 58.5 * u, gdk.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
            line { from: gdk.l + 58.5 * u - 24 * u, gdk.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gdk.l + 58.5 * u + 24 * u, gdk.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
            box { at: gdk.l + 58.5 * u, gdk.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gdk.r - 20 * u - k * 11 * u, gdk.b + 4; to: gdk.r - 20 * u - k * 11 * u, gdk.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gdk.r - 20 * u - k * 11 * u + 3.6, gdk.b + 4; to: gdk.r - 20 * u - k * 11 * u + 3.6, gdk.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gdk.l + 12, gdk.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gdk.l + 12, gdk.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gdk.l + 10, gdk.b - 10; to: gdk.l + 14, gdk.b - 14; width: 1.3; color: deep }
        }
        group {
            show: cas_k > 0.01 and dc0 > 0.9
            opacity: cas_k * clamp(dc0 * 3 - 2, 0, 1)
            let gdc.l = dc.ex - dc.ew / 2
            let gdc.r = dc.ex + dc.ew / 2
            let gdc.t = dc.ey - dc.eh / 2
            let gdc.b = min(dc.ey + dc.eh / 2, vb - lf.t - 1)
            box { at: gdc.l + 58.5 * u + 2, gdc.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gdc.l + 58.5 * u, gdc.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
            box { at: gdc.l + 58.5 * u, gdc.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
            line { from: gdc.l + 58.5 * u - 24 * u, gdc.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gdc.l + 58.5 * u + 24 * u, gdc.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
            box { at: gdc.l + 58.5 * u, gdc.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gdc.r - 20 * u - k * 11 * u, gdc.b + 4; to: gdc.r - 20 * u - k * 11 * u, gdc.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gdc.r - 20 * u - k * 11 * u + 3.6, gdc.b + 4; to: gdc.r - 20 * u - k * 11 * u + 3.6, gdc.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gdc.l + 12, gdc.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gdc.l + 12, gdc.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gdc.l + 10, gdc.b - 10; to: gdc.l + 14, gdc.b - 14; width: 1.3; color: deep }
        }
        group {
            show: cas_k > 0.01 and ds0 > 0.9
            opacity: cas_k * clamp(ds0 * 3 - 2, 0, 1)
            let gds.l = ds.ex - ds.ew / 2
            let gds.r = ds.ex + ds.ew / 2
            let gds.t = ds.ey - ds.eh / 2
            let gds.b = min(ds.ey + ds.eh / 2, vb - lf.t - 1)
            box { at: gds.l + 58.5 * u + 2, gds.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gds.l + 58.5 * u, gds.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
            box { at: gds.l + 58.5 * u, gds.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
            line { from: gds.l + 58.5 * u - 24 * u, gds.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gds.l + 58.5 * u + 24 * u, gds.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
            box { at: gds.l + 58.5 * u, gds.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gds.r - 20 * u - k * 11 * u, gds.b + 4; to: gds.r - 20 * u - k * 11 * u, gds.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gds.r - 20 * u - k * 11 * u + 3.6, gds.b + 4; to: gds.r - 20 * u - k * 11 * u + 3.6, gds.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gds.l + 12, gds.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gds.l + 12, gds.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gds.l + 10, gds.b - 10; to: gds.l + 14, gds.b - 14; width: 1.3; color: deep }
        }
        group {
            show: cas_k > 0.01 and dl0 > 0.9
            opacity: cas_k * clamp(dl0 * 3 - 2, 0, 1)
            let gdl.l = dl.ex - dl.ew / 2
            let gdl.r = dl.ex + dl.ew / 2
            let gdl.t = dl.ey - dl.eh / 2
            let gdl.b = min(dl.ey + dl.eh / 2, vb - lf.t - 1)
            box { at: gdl.l + 58.5 * u + 2, gdl.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gdl.l + 58.5 * u, gdl.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
            box { at: gdl.l + 58.5 * u, gdl.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
            line { from: gdl.l + 58.5 * u - 24 * u, gdl.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gdl.l + 58.5 * u + 24 * u, gdl.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
            box { at: gdl.l + 58.5 * u, gdl.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gdl.r - 20 * u - k * 11 * u, gdl.b + 4; to: gdl.r - 20 * u - k * 11 * u, gdl.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gdl.r - 20 * u - k * 11 * u + 3.6, gdl.b + 4; to: gdl.r - 20 * u - k * 11 * u + 3.6, gdl.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gdl.l + 12, gdl.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gdl.l + 12, gdl.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gdl.l + 10, gdl.b - 10; to: gdl.l + 14, gdl.b - 14; width: 1.3; color: deep }
        }
        group {
            show: cas_k > 0.01 and dm0 > 0.9
            opacity: cas_k * clamp(dm0 * 3 - 2, 0, 1)
            let gdm.l = dm.ex - dm.ew / 2
            let gdm.r = dm.ex + dm.ew / 2
            let gdm.t = dm.ey - dm.eh / 2
            let gdm.b = min(dm.ey + dm.eh / 2, vb - lf.t - 1)
            box { at: gdm.l + 58.5 * u + 2, gdm.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gdm.l + 58.5 * u, gdm.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
            box { at: gdm.l + 58.5 * u, gdm.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
            line { from: gdm.l + 58.5 * u - 24 * u, gdm.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gdm.l + 58.5 * u + 24 * u, gdm.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
            box { at: gdm.l + 58.5 * u, gdm.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gdm.r - 20 * u - k * 11 * u, gdm.b + 4; to: gdm.r - 20 * u - k * 11 * u, gdm.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gdm.r - 20 * u - k * 11 * u + 3.6, gdm.b + 4; to: gdm.r - 20 * u - k * 11 * u + 3.6, gdm.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gdm.l + 12, gdm.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gdm.l + 12, gdm.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gdm.l + 10, gdm.b - 10; to: gdm.l + 14, gdm.b - 14; width: 1.3; color: deep }
        }
        group {
            show: cas_k > 0.01 and dz0 > 0.9
            opacity: cas_k * clamp(dz0 * 3 - 2, 0, 1)
            let gdz.l = dz.fx - dz.fw / 2
            let gdz.r = dz.fx + dz.fw / 2
            let gdz.t = dz.fcy - dz.fh / 2
            let gdz.b = min(dz.fcy + dz.fh / 2, vb - lf.t - 1)
            box { at: gdz.l + 58.5 * u + 2, gdz.t + 9 + 3; size: 58 * u, 24; corner: 5; color: deep; opacity: 38% }
            box { at: gdz.l + 58.5 * u, gdz.t + 9; size: 58 * u, 24; corner: 5; color: mintlo }
            box { at: gdz.l + 58.5 * u, gdz.t + 9 - 2.5; size: 58 * u, 24 - 5; corner: 5; color: mint }
            line { from: gdz.l + 58.5 * u - 24 * u, gdz.t + 9 - 2.5 - (24 - 5) / 2 + 4; to: gdz.l + 58.5 * u + 24 * u, gdz.t + 9 - 2.5 - (24 - 5) / 2 + 4; width: 2.2; color: minthi; opacity: 70% }
            box { at: gdz.l + 58.5 * u, gdz.t + 9; size: 58 * u, 24; corner: 5; stroke: 1.4; color: deep }
            repeat k in 0..8 {
                line { from: gdz.r - 20 * u - k * 11 * u, gdz.b + 4; to: gdz.r - 20 * u - k * 11 * u, gdz.b - 18; width: 6; color: mix(deep, #ffffff, 6%) }
                line { from: gdz.r - 20 * u - k * 11 * u + 3.6, gdz.b + 4; to: gdz.r - 20 * u - k * 11 * u + 3.6, gdz.b - 18; width: 1.2; color: #ffffff; opacity: 45% }
            }
            ellipse { at: gdz.l + 12, gdz.b - 12; radius: 3.6; color: mix(deep, #ffffff, 38%) }
            ellipse { at: gdz.l + 12, gdz.b - 12; radius: 3.6; stroke: 1.1; color: deep }
            line { from: gdz.l + 10, gdz.b - 10; to: gdz.l + 14, gdz.b - 14; width: 1.3; color: deep }
        }
        //  The UwU theme's graphics, on every drawer that is out (and round the screen, below): cat ears on its top corners, three twinkling stars along its
        //  top, two hearts that bob and a trail of paw prints in its bottom corners, and sparkles rising from the hearts. The ears are the only part outside
        //  the drawer; the rest sits in its margin and never touches what it holds. Each sticker has a grape outline, as the drawers have.
        group {
            show: uwu_k > 0.01 and dk0 > 0.9
            opacity: uwu_k * clamp(dk0 * 3 - 2, 0, 1)
            let wdk.l = dk.ex - dk.ew / 2
            let wdk.r = dk.ex + dk.ew / 2
            let wdk.t = dk.ey - dk.eh / 2
            let wdk.b = min(dk.ey + dk.eh / 2, vb - lf.t - 1)
            let wdk.m = (dk.ex)
            repeat side in 0..2 {
                let ex = if(side == 0, wdk.l + 50 * u, wdk.r - 50 * u)
                let sg = if(side == 0, -1, 1)
                path { at: ex, wdk.t; color: obsidian; move -23 * u, 8; line sg * 13 * u, -30 * u; line 23 * u, 8; close }
                path { at: ex, wdk.t; stroke: 3 * u; color: deep; move -23 * u, 8; line sg * 13 * u, -30 * u; line 23 * u, 8 }
                path { at: ex, wdk.t; color: #ff8fc8; move -14 * u, 5; line sg * 9 * u, -19 * u; line 14 * u, 5; close }
            }
            //  Whiskers: three on each side of the drawer, fanning out of its edges at the bottom corners.
            repeat wk in 0..6 {
                let wks = if(wk < 3, -1, 1)
                let wkx = if(wk < 3, wdk.l, wdk.r)
                let wky = wdk.b - 20 * u + (mod(wk, 3) - 1) * 7 * u
                line { from: wkx - wks * 6 * u, wky; to: wkx + wks * 26 * u, wky + (mod(wk, 3) - 1) * 6 * u; width: 4; color: deep }
                line { from: wkx - wks * 6 * u, wky; to: wkx + wks * 26 * u, wky + (mod(wk, 3) - 1) * 6 * u; width: 1.8; color: #ffffff }
            }
            repeat s in 0..3 {
                let sx = wdk.m + (s - 1) * 44 * u
                let sr = if(s == 1, 7, 5) * u
                group { scale: 1 + 0.22 * sin(time * 160 + s * 120); pivot: sx, wdk.t + 9
                    path { at: sx, wdk.t + 9; stroke: 3; color: deep; move 0, -sr; line 0.3 * sr, -0.3 * sr; line sr, 0; line 0.3 * sr, 0.3 * sr; line 0, sr; line -0.3 * sr, 0.3 * sr; line -sr, 0; line -0.3 * sr, -0.3 * sr; close }
                    path { at: sx, wdk.t + 9; color: pick(s, #ffe27a, #ffffff, #7fd3ff); move 0, -sr; line 0.3 * sr, -0.3 * sr; line sr, 0; line 0.3 * sr, 0.3 * sr; line 0, sr; line -0.3 * sr, 0.3 * sr; line -sr, 0; line -0.3 * sr, -0.3 * sr; close }
                }
            }
            repeat hh in 0..2 {
                let hx = wdk.l + (22 + hh * 22) * u
                let hy = wdk.b - 11
                let hr = if(hh == 0, 5.5, 4.5) * u
                group { scale: 1 + 0.13 * sin(time * 200 + hh * 150); pivot: hx, hy
                    ellipse { at: hx - 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62 + 1.5; color: deep }
                    ellipse { at: hx + 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62 + 1.5; color: deep }
                    path { at: hx, hy; stroke: 3; color: deep; move -1.12 * hr, -0.1 * hr; line 0, 1.2 * hr; line 1.12 * hr, -0.1 * hr; close }
                    ellipse { at: hx - 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62; color: pick(hh, #ff6eb4, #b69cff) }
                    ellipse { at: hx + 0.52 * hr, hy - 0.3 * hr; radius: hr * 0.62; color: pick(hh, #ff6eb4, #b69cff) }
                    path { at: hx, hy; color: pick(hh, #ff6eb4, #b69cff); move -1.1 * hr, -0.1 * hr; line 0, 1.15 * hr; line 1.1 * hr, -0.1 * hr; close }
                    ellipse { at: hx - 0.7 * hr, hy - 0.5 * hr; radius: hr * 0.2; color: #ffffff; opacity: 80% }
                }
            }
            repeat pw in 0..3 {
                let px = wdk.r - (26 + pw * 28) * u
                let py = wdk.b - 12 + if(mod(pw, 2) == 0, 0, -3)
                ellipse { at: px, py + 2.4; radius: 6; color: deep }
                ellipse { at: px - 6.4, py - 3.2; radius: 3.4; color: deep }
                ellipse { at: px - 2.4, py - 7.6; radius: 3.4; color: deep }
                ellipse { at: px + 2.4, py - 7.6; radius: 3.4; color: deep }
                ellipse { at: px + 6.4, py - 3.2; radius: 3.4; color: deep }
                ellipse { at: px, py + 2.4; radius: 4.6; color: #ff8fc8 }
                ellipse { at: px - 6.4, py - 3.2; radius: 2.2; color: #ff8fc8 }
                ellipse { at: px - 2.4, py - 7.6; radius: 2.2; color: #ff8fc8 }
                ellipse { at: px + 2.4, py - 7.6; radius: 2.2; color: #ff8fc8 }
                ellipse { at: px + 6.4, py - 3.2; radius: 2.2; color: #ff8fc8 }
            }
            particles { at: wdk.l + 36 * u, wdk.b - 16; area: 36 * u, 6; count: 16; life: 1.4s .. 2.6s; speed: 18 .. 42; direction: -90deg; spread: 40deg; size: 3.6, 1; colors: #ff6eb4, #b69cff, #7fd3ff, #5fe3d6, #ffe27a; shape: spark }
        }
        group {
            show: uwu_k > 0.01 and dc0 > 0.9
            opacity: uwu_k * clamp(dc0 * 3 - 2, 0, 1)
            let wdc.l = dc.ex - dc.ew / 2
            let wdc.r = dc.ex + dc.ew / 2
            let wdc.t = dc.ey - dc.eh / 2
            let wdc.b = min(dc.ey + dc.eh / 2, vb - lf.t - 1)
            let wdc.m = (dc.ex)
            repeat side in 0..2 {
                let ex = if(side == 0, wdc.l + 50 * u, wdc.r - 50 * u)
                let sg = if(side == 0, -1, 1)
                path { at: ex, wdc.t; color: obsidian; move -23 * u, 8; line sg * 13 * u, -30 * u; line 23 * u, 8; close }
                path { at: ex, wdc.t; stroke: 3 * u; color: deep; move -23 * u, 8; line sg * 13 * u, -30 * u; line 23 * u, 8 }
                path { at: ex, wdc.t; color: #ff8fc8; move -14 * u, 5; line sg * 9 * u, -19 * u; line 14 * u, 5; close }
            }
