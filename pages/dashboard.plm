part Dashboard {
    // ── the dashboard ────────────────────────────────────────────
    //  The calendar's drawer, down the left, is wider and taller than the calendar alone (see `lp_w`, `dc.rt` and `dc.gh`): the calendar keeps its
    //  place at the left (shifted by half the extra width), and what else wants a glance goes round it, drawn straight on the glass, no plates:
    //  three orbs (Wi-Fi with its signal, the sound with its level, Do Not Disturb), what is playing with the spectrum under it, three rings for
    //  the machine and a minute of its activity; and under the calendar the notifications that came.
    //  Only in the left layout; in the top one the drawer is the calendar's own size and none of this is drawn.
    group {
        show: lm > 0.5
        opacity: pown
        clip inset 2 box { at: mix(pcx, dc.gx, lm), mix(bar.y + dc.hh / 2, lp.cy, lm); size: mix(dc.w, dc.gw, lm), mix(dc.hh, dc.gh, lm); corner: 26 * cu }
        group {
            pivot: lp.xl, lp.cy
            scale: mix(1, max(dc.lf, 0.05), lm * att)
        group {
            opacity: f4
            move: 0, (1 - f4) * 12 * cu
            let db.lx = pcx - 185 * cu                 // the middle of the left column (the calendar's)
            let db.rx = pcx + 217 * cu                 // and of the right one, 362 wide
            let db.top = cy - 112 * cu                 // where the weather strip starts
            let db.x0 = db.rx - 181 * cu               // the right column's left edge
            let db.y1 = cy + 359 * cu                  // where both columns end
            let dq.x = db.x0 + 14 * cu                 // the content's left edge in the right column
            let dq.w = 334 * cu                        // and its width

            prop dh.w = 0 ~pop                         // each orb swells under the pointer
            prop dh.s = 0 ~pop
            prop dh.d = 0 ~pop
            prop dh.b = 0 ~pop
            follow dh.w = dc_wifi.hover
            follow dh.s = dc_snd.hover
            follow dh.d = dc_dnd.hover
            follow dh.b = dc_bt.hover

            //  A hairline between two parts of the column.
            component DashRule(rx: number, ry: number, rw: number) {
                box { at: rx, ry; size: rw, 1 * cu; color: ink; opacity: 8% }
            }
            //  A ring gauge: a track, and the value over it with a glow, a little under three quarters of a turn; `p` is 0..1.
            component DashRing(gx: number, gy: number, p: number) {
                arc { at: gx, gy; radius: 34 * cu; span: 270deg; width: 7 * cu; color: ink; opacity: 10%; rotate: 0deg }
                group {
                    glow: 8 * cu, 40%
                    arc { at: gx, gy; radius: 34 * cu; span: (270 * clamp(p, 0.006, 1)) * 1deg; width: 7 * cu; color: mix(mint, alert, clamp((p - 0.75) / 0.25, 0, 1)); rotate: (-135 + 135 * clamp(p, 0.006, 1)) * 1deg }
                }
            }

                // ── the orbs ──
            let do.y = db.top + 30 * cu
            let do.s = db.rx + 45 * cu                 // the sound's middle
            let do.b = db.rx - 45 * cu                 // and the Bluetooth's
            //  Wi-Fi: the signal in its arcs, the ring is lit while it is connected.
            group {
                pivot: db.rx - 135 * cu, do.y
                scale: 1 + 0.09 * dh.w
                group {
                    blur: 11 * cu
                    ellipse { at: db.rx - 135 * cu, do.y; radius: 25 * cu; color: mint; opacity: if(on_wifi, 30%, 0%) }
                }
                ellipse { at: db.rx - 135 * cu, do.y; radius: 25 * cu; stroke: 2.2 * cu; color: mix(ink, mint, if(on_wifi, 1, 0)); opacity: if(on_wifi, 100%, 22%) }
                ellipse { at: db.rx - 135 * cu, do.y; radius: 21 * cu; color: ink; opacity: 5% + 9% * dh.w }
                ellipse { at: db.rx - 135 * cu, do.y + 8 * cu; radius: 2.3 * cu; color: ink }
                arc { at: db.rx - 135 * cu, do.y + 8 * cu; radius: 7.5 * cu; span: 84deg; width: 2.4 * cu; color: ink; rotate: 0deg; opacity: if(on_wifi, 40% + 60% * clamp(net.strength / 0.3, 0, 1), 18%) }
                arc { at: db.rx - 135 * cu, do.y + 8 * cu; radius: 13 * cu; span: 84deg; width: 2.4 * cu; color: ink; rotate: 0deg; opacity: if(on_wifi, 40% + 60% * clamp(net.strength / 0.65, 0, 1), 18%) }
                arc { at: db.rx - 135 * cu, do.y + 8 * cu; radius: 18.5 * cu; span: 84deg; width: 2.4 * cu; color: ink; rotate: 0deg; opacity: if(on_wifi, 40% + 60% * clamp(net.strength, 0, 1), 18%) }
            }
            //  The sound: the speaker, the ring is the volume.
            group {
                pivot: do.s, do.y
                scale: 1 + 0.09 * dh.s
                group {
                    blur: 11 * cu
                    ellipse { at: do.s, do.y; radius: 25 * cu; color: mint; opacity: if(audio.muted, 0%, 26%) }
                }
                ellipse { at: do.s, do.y; radius: 25 * cu; stroke: 2.2 * cu; color: ink; opacity: 14% }
                arc { at: do.s, do.y; radius: 25 * cu; span: (359 * clamp(if(audio.muted, 0, audio.volume), 0.004, 1)) * 1deg; width: 2.8 * cu; color: mint; rotate: (180 * clamp(if(audio.muted, 0, audio.volume), 0.004, 1)) * 1deg; opacity: if(audio.muted, 0%, 100%) }
                ellipse { at: do.s, do.y; radius: 20 * cu; color: ink; opacity: 5% + 9% * dh.s }
                box { at: do.s - 6.5 * cu, do.y; size: 5 * cu, 7 * cu; corner: 1 * cu; color: ink }
                path { at: do.s, do.y; color: ink; move -4 * cu, -3.5 * cu; line 2 * cu, -7.5 * cu; line 2 * cu, 7.5 * cu; line -4 * cu, 3.5 * cu; close }
                arc { at: do.s + 2 * cu, do.y; radius: 6.5 * cu; span: 90deg; width: 2 * cu; color: ink; rotate: 90deg; opacity: if(audio.muted, 0%, 90%) }
                arc { at: do.s + 2 * cu, do.y; radius: 11 * cu; span: 90deg; width: 2 * cu; color: ink; rotate: 90deg; opacity: if(audio.muted, 0%, 55%) }
                line { from: do.s - 10 * cu, do.y - 10 * cu; to: do.s + 10 * cu, do.y + 10 * cu; width: 2.6 * cu; color: alert; opacity: if(audio.muted, 100%, 0%) }
            }
            //  Bluetooth: the rune, the ring lit while a device is connected, and its name under it.
            group {
                pivot: do.b, do.y
                scale: 1 + 0.09 * dh.b
                group {
                    blur: 11 * cu
                    ellipse { at: do.b, do.y; radius: 25 * cu; color: mint; opacity: if(bt_connected, 30%, 0%) }
                }
                ellipse { at: do.b, do.y; radius: 25 * cu; stroke: 2.2 * cu; color: mix(ink, mint, if(bt_connected, 1, 0)); opacity: if(bt_connected, 100%, if(bt.powered, 38%, 22%)) }
                ellipse { at: do.b, do.y; radius: 21 * cu; color: ink; opacity: 5% + 9% * dh.b }
                group {
                    opacity: if(bt.powered, 100%, 40%)
                    line { from: do.b - 5 * cu, do.y - 4.5 * cu; to: do.b + 4.5 * cu, do.y + 4.5 * cu; width: 1.9 * cu; color: ink }
                    line { from: do.b + 4.5 * cu, do.y + 4.5 * cu; to: do.b, do.y + 9 * cu; width: 1.9 * cu; color: ink }
                    line { from: do.b, do.y + 9 * cu; to: do.b, do.y - 9 * cu; width: 1.9 * cu; color: ink }
                    line { from: do.b, do.y - 9 * cu; to: do.b + 4.5 * cu, do.y - 4.5 * cu; width: 1.9 * cu; color: ink }
                    line { from: do.b + 4.5 * cu, do.y - 4.5 * cu; to: do.b - 5 * cu, do.y + 4.5 * cu; width: 1.9 * cu; color: ink }
                }
            }
            text bt_name { at: floor(do.b + 0.5), floor(do.y + 40 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 84 * cu; lines: 1; color: ink; family: "Space Grotesk"; show: bt_connected }
            text "Not connected" { at: floor(do.b + 0.5), floor(do.y + 40 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 84 * cu; lines: 1; color: faint; family: "Space Grotesk"; show: bt.powered and not bt_connected }
            text "Bluetooth off" { at: floor(do.b + 0.5), floor(do.y + 40 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 84 * cu; lines: 1; color: faint; family: "Space Grotesk"; show: not bt.powered }
            zone ellipse dc_bt { at: do.b, do.y; radius: 27 * cu; cursor: pointer; label: "Bluetooth" }
            on press dc_bt { emit togglebt(not bt.powered) }
            //  Do Not Disturb: sleepers, in the accent while it is on.
            group {
                pivot: db.rx + 135 * cu, do.y
                scale: 1 + 0.09 * dh.d
                group {
                    blur: 11 * cu
                    ellipse { at: db.rx + 135 * cu, do.y; radius: 25 * cu; color: mint; opacity: if(dnd_on, 30%, 0%) }
                }
                ellipse { at: db.rx + 135 * cu, do.y; radius: 25 * cu; stroke: 2.2 * cu; color: mix(ink, mint, if(dnd_on, 1, 0)); opacity: if(dnd_on, 100%, 22%) }
                ellipse { at: db.rx + 135 * cu, do.y; radius: 21 * cu; color: ink; opacity: 5% + 9% * dh.d }
                text "Z" { at: floor(db.rx + 128 * cu + 0.5), floor(do.y + 4 * cu + 0.5); anchor: center; align: center; size: 12; weight: 700; color: mix(faint, mint, if(dnd_on, 1, 0)); family: "Space Grotesk" }
                text "Z" { at: floor(db.rx + 136 * cu + 0.5), floor(do.y - 1 * cu + 0.5); anchor: center; align: center; size: 15; weight: 700; color: mix(faint, mint, if(dnd_on, 1, 0)); family: "Space Grotesk" }
                text "Z" { at: floor(db.rx + 145 * cu + 0.5), floor(do.y - 7 * cu + 0.5); anchor: center; align: center; size: 18; weight: 700; color: mix(faint, mint, if(dnd_on, 1, 0)); family: "Space Grotesk" }
            }
            text net.name { at: floor(db.rx - 135 * cu + 0.5), floor(do.y + 40 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; width: 84 * cu; lines: 1; color: ink; family: "Space Grotesk"; show: on_wifi }
            text "Not connected" { at: floor(db.rx - 135 * cu + 0.5), floor(do.y + 40 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; color: faint; family: "Space Grotesk"; show: net.wifi and not on_wifi }
            text "Wi-Fi off" { at: floor(db.rx - 135 * cu + 0.5), floor(do.y + 40 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; color: faint; family: "Space Grotesk"; show: not net.wifi }
            text number(audio.volume * 100, 0, "%") { at: floor(do.s + 0.5), floor(do.y + 40 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; color: ink; family: "Space Grotesk"; show: not audio.muted }
            text "Muted" { at: floor(do.s + 0.5), floor(do.y + 40 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; color: faint; family: "Space Grotesk"; show: audio.muted }
            text "Silenced" { at: floor(db.rx + 135 * cu + 0.5), floor(do.y + 40 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; color: mint; family: "Space Grotesk"; show: dnd_on }
            text "Notifications" { at: floor(db.rx + 135 * cu + 0.5), floor(do.y + 40 * cu + 0.5); anchor: center; align: center; size: 11.5; weight: 600; color: faint; family: "Space Grotesk"; show: not dnd_on }
            zone ellipse dc_wifi { at: db.rx - 135 * cu, do.y; radius: 27 * cu; cursor: pointer; label: "Wi-Fi" }
            zone ellipse dc_snd { at: do.s, do.y; radius: 27 * cu; cursor: pointer; label: "Mute or unmute the sound" }
            zone ellipse dc_dnd { at: db.rx + 135 * cu, do.y; radius: 27 * cu; cursor: pointer; label: "Do not disturb" }
            on press dc_wifi { emit togglewifi(not net.wifi) }
            on press dc_snd { emit mute }
            on press dc_dnd { emit togglednd }
            DashRule(db.rx, db.top + 80 * cu, 334 * cu)

            // ── what is playing ──
            let dp.x = db.x0 + 60 * cu                  // the cover's middle
            let dp.y = db.top + 128 * cu
            text "Nothing is playing" { at: floor(db.rx + 0.5), floor(db.top + 144 * cu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: faint; family: "Space Grotesk"; show: not media_on }
            group {
                show: media_on
                //  The cover, round, with a glow that swells on the beat and a ring round it.
                group {
                    blur: 13 * cu
                    ellipse { at: dp.x, dp.y; radius: (36 + 5 * bass) * cu; color: mint; opacity: playf * (22% + 22% * bass) }
                }
                ellipse { at: dp.x, dp.y; radius: 42 * cu; stroke: 1.6 * cu; color: mix(ink, mint, playf); opacity: 30% + 40% * playf }
                ellipse { at: dp.x, dp.y; radius: 36 * cu; color: ink; opacity: 10% }
                group {
                    opacity: art_on
                    saturation: 0.3 + 0.7 * playf
                    clip inset 0 box { at: dp.x, dp.y; size: 72 * cu, 72 * cu; corner: 36 * cu }
                    image art { at: dp.x - 36 * cu, dp.y - 36 * cu; size: 72 * cu, 72 * cu }
                }
                text media.title { at: floor(dp.x + 56 * cu + 0.5), floor(dp.y - 22 * cu + 0.5); anchor: left center; size: 16; weight: 700; width: 236 * cu; lines: 1; color: ink; family: "Space Grotesk" }
                text media.artist { at: floor(dp.x + 56 * cu + 0.5), floor(dp.y - 3 * cu + 0.5); anchor: left center; size: 13; width: 236 * cu; lines: 1; color: mint; opacity: 90%; family: "Space Grotesk" }
                //  previous, play / pause (a ring with the mark in it), next
                let dp.cx = dp.x + 56 * cu + 70 * cu
                let dp.by = dp.y + 24 * cu
                path { at: dp.cx - 44 * cu, dp.by; color: ink; opacity: 70% + 30% * dc_prev.hover; move 4 * cu, -5 * cu; line -4 * cu, 0; line 4 * cu, 5 * cu; close }
                box { at: dp.cx - 50 * cu, dp.by; size: 1.8 * cu, 10 * cu; corner: 0.9 * cu; color: ink; opacity: 70% + 30% * dc_prev.hover }
                ellipse { at: dp.cx, dp.by; radius: (11 + 1.5 * dc_play.hover) * cu; stroke: 1.8 * cu; color: mint }
                path { at: dp.cx, dp.by; color: mint; show: not media.playing; move -2.5 * cu, -5 * cu; line 5.5 * cu, 0; line -2.5 * cu, 5 * cu; close }
                box { at: dp.cx - 2.8 * cu, dp.by; size: 2.8 * cu, 9 * cu; corner: 1.2 * cu; color: mint; show: media.playing }
                box { at: dp.cx + 2.8 * cu, dp.by; size: 2.8 * cu, 9 * cu; corner: 1.2 * cu; color: mint; show: media.playing }
                path { at: dp.cx + 44 * cu, dp.by; color: ink; opacity: 70% + 30% * dc_next.hover; move -4 * cu, -5 * cu; line 4 * cu, 0; line -4 * cu, 5 * cu; close }
                box { at: dp.cx + 50 * cu, dp.by; size: 1.8 * cu, 10 * cu; corner: 0.9 * cu; color: ink; opacity: 70% + 30% * dc_next.hover }
                zone ellipse dc_prev { at: dp.cx - 46 * cu, dp.by; radius: 15 * cu; cursor: pointer; label: "Previous" }
                zone ellipse dc_play { at: dp.cx, dp.by; radius: 15 * cu; cursor: pointer; label: "Play or pause" }
                zone ellipse dc_next { at: dp.cx + 46 * cu, dp.by; radius: 15 * cu; cursor: pointer; label: "Next" }
                on press dc_prev { emit mcmd(0) }
                on press dc_play { emit mcmd(1) }
                on press dc_next { emit mcmd(2) }
                //  The spectrum: 24 bars standing on a line, from the accent to white as they rise, with their reflection, under a soft glow.
                group {
                    glow: 7 * cu, 35%
                    let dsp.y = db.top + 196 * cu
                    repeat i in 0..24 {
                        let lvl = clamp(spec.s.$i * (0.8 + 0.7 * i / 23), 0, 1)
                        let bh = (1.5 + 20 * lvl) * cu
                        let bx = dq.x + (i + 0.5) * dq.w / 24
                        box { at: bx, dsp.y - bh / 2; size: 5 * cu, bh; corner: 2.5 * cu; color: mix(mint, ink, lvl * 0.85); opacity: (0.35 + 0.65 * playf) * (45% + 55% * lvl) }
                        box { at: bx, dsp.y + bh * 0.28 + 2 * cu; size: 5 * cu, bh * 0.56; corner: 2.5 * cu; color: mint; opacity: playf * lvl * 28% }
                    }
                }
            }
            DashRule(db.rx, db.top + 218 * cu, 334 * cu)

            // ── the machine ──
            let dg.y = db.top + 262 * cu
            DashRing(db.rx - 118 * cu, dg.y, sm_cpu_p)
            DashRing(db.rx, dg.y, sm_mem_p)
            DashRing(db.rx + 118 * cu, dg.y, if(sm_gpu_on, sm_gpu_p, 0))
            text sm_cpu_txt { at: floor(db.rx - 118 * cu + 0.5), floor(dg.y - 2 * cu + 0.5); anchor: center; align: center; size: 20; weight: 700; width: 64 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text sm_mem_pct { at: floor(db.rx + 0.5), floor(dg.y - 2 * cu + 0.5); anchor: center; align: center; size: 20; weight: 700; width: 64 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text sm_gpu_txt { at: floor(db.rx + 118 * cu + 0.5), floor(dg.y - 2 * cu + 0.5); anchor: center; align: center; size: 20; weight: 700; width: 64 * cu; lines: 1; color: ink; family: "Space Grotesk"; show: sm_gpu_on }
            text "-" { at: floor(db.rx + 118 * cu + 0.5), floor(dg.y - 2 * cu + 0.5); anchor: center; align: center; size: 20; weight: 700; color: faint; family: "Space Grotesk"; show: not sm_gpu_on }
            text "PROCESSOR" { at: floor(db.rx - 118 * cu + 0.5), floor(dg.y + 36 * cu + 0.5); anchor: center; align: center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
            text "MEMORY" { at: floor(db.rx + 0.5), floor(dg.y + 36 * cu + 0.5); anchor: center; align: center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
            text "GRAPHICS" { at: floor(db.rx + 118 * cu + 0.5), floor(dg.y + 36 * cu + 0.5); anchor: center; align: center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
            text sm_cpu_meta { at: floor(db.rx - 118 * cu + 0.5), floor(dg.y + 51 * cu + 0.5); anchor: center; align: center; size: 11; width: 112 * cu; lines: 1; color: ink; opacity: 80%; family: "Space Grotesk" }
            text sm_mem_used { at: floor(db.rx + 0.5), floor(dg.y + 51 * cu + 0.5); anchor: center; align: center; size: 11; width: 112 * cu; lines: 1; color: ink; opacity: 80%; family: "Space Grotesk" }
            text sm_gpu_temp { at: floor(db.rx + 118 * cu + 0.5), floor(dg.y + 51 * cu + 0.5); anchor: center; align: center; size: 11; width: 112 * cu; lines: 1; color: ink; opacity: 80%; family: "Space Grotesk"; show: sm_gpu_on }
            DashRule(db.rx, db.top + 334 * cu, 334 * cu)

            //  The last minute: the processor standing up from a centre line, the network coming down from it.
            let da.y = db.top + 382 * cu
            text "LAST MINUTE" { at: floor(dq.x + 0.5), floor(db.top + 346 * cu + 0.5); anchor: left center; size: 10.5; weight: 700; color: faint; family: "Space Grotesk" }
            text "Up {sm_uptime}" { at: floor(dq.x + dq.w + 0.5), floor(db.top + 346 * cu + 0.5); anchor: right center; align: right; size: 10.5; weight: 600; width: 200 * cu; lines: 1; color: faint; family: "Space Grotesk" }
            group {
                glow: 6 * cu, 30%
                repeat i in 0..60 {
                    let k = i + 60 - sm_hist.count
                    let bx = dq.x + (k + 0.5) * dq.w / 60
                    let ch = max(1.6 * cu, clamp(sm_hist.$i.cpu, 0, 1) * 30 * cu)
                    let nh = max(1.6 * cu, clamp(sm_hist.$i.rx, 0, 1) * 22 * cu)
                    box { at: bx, da.y - ch / 2; size: 3.2 * cu, ch; corner: 1.4 * cu; color: mix(mint, alert, clamp((sm_hist.$i.cpu - 0.75) / 0.25, 0, 1)); opacity: 25% + 70% * k / 60; show: i < sm_hist.count }
                    box { at: bx, da.y + 2 * cu + nh / 2; size: 3.2 * cu, nh; corner: 1.4 * cu; color: ink; opacity: 14% + 40% * k / 60; show: i < sm_hist.count }
                }
            }
            text "{sm_rx_txt}" { at: floor(dq.x + 0.5), floor(da.y + 34 * cu + 0.5); anchor: left center; size: 12; weight: 700; width: 120 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text "{sm_tx_txt}" { at: floor(dq.x + dq.w + 0.5), floor(da.y + 34 * cu + 0.5); anchor: right center; align: right; size: 12; weight: 700; width: 120 * cu; lines: 1; color: ink; family: "Space Grotesk" }
            text "down" { at: floor(dq.x + 70 * cu + 0.5), floor(da.y + 34 * cu + 0.5); anchor: left center; size: 10.5; color: faint; family: "Space Grotesk" }
            text "up" { at: floor(dq.x + dq.w - 70 * cu + 0.5), floor(da.y + 34 * cu + 0.5); anchor: right center; align: right; size: 10.5; color: faint; family: "Space Grotesk" }
            DashRule(db.rx, db.top + 428 * cu, 334 * cu)
            repeat r in 0..3 {
                text sm_proc.$r.name { at: floor(dq.x + r * 114 * cu + 0.5), floor(db.top + 444 * cu + 0.5); anchor: left center; size: 12; weight: 600; width: 104 * cu; lines: 1; color: ink; family: "Space Grotesk"; show: r < sm_proc.count }
                text sm_proc.$r.cpu_txt { at: floor(dq.x + r * 114 * cu + 0.5), floor(db.top + 459 * cu + 0.5); anchor: left center; size: 11; width: 104 * cu; lines: 1; color: mint; family: "Space Grotesk"; show: r < sm_proc.count }
            }

            // ── the notifications ──
            let dn.y = cy + 250 * cu                    // the header's middle; the list starts 12 under it
            let dn.x = db.lx - 213 * cu
            Envelope(dn.x + 12 * cu, dn.y + 4 * cu * env_o - 2 * cu * env_pop, (0.5 + 0.08 * env_pop) * cu, env_o, 1, 55% + 45% * clamp(env_o + env_pop, 0, 1))
            text "NOTIFICATIONS" { at: floor(dn.x + 30 * cu + 0.5), floor(dn.y + 0.5); anchor: left center; size: 11; weight: 700; color: faint; family: "Space Grotesk" }
            text nt_tile_sub { at: floor(dn.x + 372 * cu + 0.5), floor(dn.y + 0.5); anchor: right center; align: right; size: 11; width: 200 * cu; lines: 1; color: faint; opacity: 75%; family: "Space Grotesk" }
            text "Clear" { at: floor(dn.x + 426 * cu + 0.5), floor(dn.y - 1 * cu + 0.5); anchor: right center; align: right; size: 12; weight: 700; width: 44 * cu; lines: 1; color: mint; opacity: if(nt_hist.count > 0, 65% + 35% * dc_clear.hover, 0%); family: "Space Grotesk" }
            box { at: dn.x + 426 * cu - 17 * cu, dn.y + 9 * cu; size: 34 * cu, 1 * cu; color: mint; opacity: if(nt_hist.count > 0, 30% + 50% * dc_clear.hover, 0%) }
            zone box dc_clear { at: dn.x + 426 * cu - 20 * cu, dn.y; size: 44 * cu, 24 * cu; cursor: pointer; active: nt_hist.count > 0; label: "Clear the notifications" }
            on press dc_clear { emit nt_clear }
            text "All clear" { at: floor(db.lx + 0.5), floor(dn.y + 56 * cu + 0.5); anchor: center; align: center; size: 14; weight: 600; color: faint; show: nt_hist.count < 1; family: "Space Grotesk" }
            column dc_nt_col {
                at: floor(dn.x + 0.5), floor(dn.y + 12 * cu + 0.5)
                view: 426 * cu, 150
                gap: 6
                for h in nt_hist { NtDashRow(h, del: nt_hist_del) }
            }
        }
        }
    }
}
