part Addons {
        //  The Add-ons page: a card for each folder in ~/.config/pleamar/vitreus-addons (logic/addons.luau; the model is addons/_template/). The card carries what the
        //  add-on's own addon.toml says (its name as the title, its description under it, then who wrote it and its version) and its own switch, which starts or stops
        //  its scene. The page scrolls like Widgets.
        group {
            show: set_pgo > 0.01
            opacity: set_pgo
            let ad.sc = clamp(ad_scroll, 0, max(0, ad.h - set.h))
            let ad.off = floor(ad.sc * pu + 0.5)         // whole pixels: text that is shifted by a fraction of one is resampled, and looks soft
            clip box { at: spx + 224 * pu, sby + set.h / 2 * pu; size: 456 * pu, set.h * pu }
            zone box ad_wheel { at: spx + 219 * pu, sby + set.h / 2 * pu; size: 446 * pu, set.h * pu }
            on scroll ad_wheel { ad_scroll_to = clamp(ad_scroll_to - wheel * 44, 0, max(0, ad.h - set.h)) }
            group {
                move: 0, -ad.off
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); text "Each add-on is a scene of its own; turn on the ones you want" { at: floor(spx + 14 * pu + 0.5), floor(sby + 16 * pu + 0.5); anchor: left center; size: 14; color: faint; width: (420 * pu) / rs; lines: 1; family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + 70 * pu + 0.5); show: addons.count == 0; text "No add-ons yet" { at: floor(spx + 14 * pu + 0.5), floor(sby + 70 * pu + 0.5); anchor: left center; size: 17; weight: 700; color: faint; family: "Space Grotesk" } }
                repeat i in 0..12 {
                    let adt = 36 + i * 92                 // the card's top
                    let adc = adt + 41                    // and its middle
                    group {
                        show: i < addons.count
                        body { color: mix(obsidian, ink, (veil) * 1.6); opacity: obs; shadow: 0, 2 * pu, 7 * pu, 40%, #000000; show: obs > 0.004; box { at: spx + 219 * pu, sby + adc * pu; size: 438 * pu, 82 * pu; corner: 14 * pu } }
                        box { at: spx + 219 * pu, sby + adc * pu; size: 438 * pu, 82 * pu; corner: 14 * pu; color: ink; opacity: (veil) * (1 - obs) }
                        group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + (adt + 20) * pu + 0.5); text addons.$i.name { at: floor(spx + 14 * pu + 0.5), floor(sby + (adt + 20) * pu + 0.5); anchor: left center; size: 19; weight: 700; width: (350 * pu) / rs; lines: 1; color: ink; family: "Space Grotesk" } }
                        group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + (adt + 43) * pu + 0.5); text addons.$i.desc { at: floor(spx + 14 * pu + 0.5), floor(sby + (adt + 43) * pu + 0.5); anchor: left center; size: 14; width: (350 * pu) / rs; lines: 1; color: faint; family: "Space Grotesk" } }
                        group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + (adt + 64) * pu + 0.5); text addons.$i.by { at: floor(spx + 14 * pu + 0.5), floor(sby + (adt + 64) * pu + 0.5); anchor: left center; size: 12.5; width: (350 * pu) / rs; lines: 1; color: faint; opacity: 65%; family: "Space Grotesk" } }
                        SettingsSwitch(spx + 424 * pu, sby + adc * pu, ad_pill.$i, ad_hit.$i.pressed, ad_hit.$i.hover, mint)
                        zone box ad_hit.$i { at: spx + 405 * pu, sby + adc * pu; size: 46 * pu, 30 * pu; cursor: pointer; active: (sby + adc * pu) - ad.off > sby and (sby + adc * pu) - ad.off < sby + set.h * pu; label: "Add-on" }
                        on press ad_hit.$i { emit addon_toggle(i) }
                    }
                }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + (36 + max(1, addons.count) * 92 + 6) * pu + 0.5); text ad_note { at: floor(spx + 14 * pu + 0.5), floor(sby + (36 + max(1, addons.count) * 92 + 6) * pu + 0.5); anchor: left center; size: 13; width: (410 * pu) / rs; lines: 1; color: if(ad_err, alert, faint); opacity: if(ad_err, 100%, 70%); family: "Space Grotesk" } }
                group { scale: rs; pivot: floor(spx + 14 * pu + 0.5), floor(sby + (36 + max(1, addons.count) * 92 + 26) * pu + 0.5); text ad_tpl { at: floor(spx + 14 * pu + 0.5), floor(sby + (36 + max(1, addons.count) * 92 + 26) * pu + 0.5); anchor: left center; size: 13; width: (410 * pu) / rs; lines: 1; color: faint; opacity: 70%; family: "Space Grotesk" } }
            }
            let ad.thh = set.h * set.h / max(set.h, ad.h)
            let ad.thy = ad.thh / 2 + ad.sc / max(1, ad.h - set.h) * (set.h - ad.thh)
            box { at: spx + 442 * pu, sby + set.h / 2 * pu; size: 3 * pu, set.h * pu; corner: 1.5 * pu; color: ink; opacity: if(ad.h > set.h, 6%, 0%) }
            box { at: spx + 442 * pu, sby + ad.thy * pu; size: 3 * pu, ad.thh * pu; corner: 1.5 * pu; color: mint; opacity: if(ad.h > set.h, 55%, 0%) }
        }
}
