// Key binds for the Vitreus shell on niri: the ones hypr_vitreus.lua has on Hyprland. The installer adds `include "niri_vitreus.kdl"` to config.kdl, after what
// is there, so where a key is bound twice this one wins. Take a line out to go without that bind.
binds {
    Mod+Space { spawn-sh "pleamar --say vitreus 'emit launch_toggle'"; }
    Mod+Shift+Space { spawn-sh "pleamar --say vitreus 'emit settings_toggle'"; }
    Mod+B { spawn-sh "pleamar --say vitreus 'emit wp_picker_toggle'"; }
    Mod+D { spawn-sh "pleamar --say vitreus 'emit desk_toggle'"; }
    Mod+Shift+D { spawn-sh "pleamar --say vitreus 'emit dash_toggle'"; }
    Mod+Tab { spawn-sh "pleamar --say vitreus 'emit ov_toggle'"; }
    Mod+C { spawn-sh "pleamar --say vitreus 'emit shot 0'"; }
    Mod+Shift+C { spawn-sh "pleamar --say vitreus 'emit rec_toggle'"; }
    Mod+E { spawn "vitreus-files"; }
}
