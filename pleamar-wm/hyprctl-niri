#!/usr/bin/env python3
"""hyprctl for niri: `hyprctl [-j] monitors | activewindow | clients | workspaces | dispatch ...`, answered from `niri msg --json` in Hyprland's words (the ones Vitreus reads:
monitors with name, id, size, scale, transform, focused; the focused window; the windows as Hyprland's text lists them; the workspaces; and the dispatchers that focus, close and move a window). Anything else
fails (exit 1), which is what a program asking hyprctl has to be ready for on a desktop that is not Hyprland. Reached through pleamar-wm/hyprctl."""
import json, re, subprocess, sys

def niri(*args):
    r = subprocess.run(["niri", "msg", "--json", *args], capture_output=True, text=True, timeout=5)
    if r.returncode != 0:
        raise RuntimeError(r.stderr.strip() or "niri msg failed")
    return json.loads(r.stdout) if r.stdout.strip() else None

# niri's transform names, in Hyprland's numbers (0 normal, 1..3 rotated, 4 flipped, 5..7 flipped and rotated)
TRANSFORM = {"Normal": 0, "90": 1, "180": 2, "270": 3, "Flipped": 4, "Flipped90": 5, "Flipped180": 6, "Flipped270": 7}

def monitors():
    outs = niri("outputs") or {}
    try:
        focused = (niri("focused-output") or {}).get("name")
    except RuntimeError:
        focused = None
    try:
        workspaces = niri("workspaces") or []
    except RuntimeError:
        workspaces = []
    active = {w.get("output"): w for w in workspaces if w.get("is_active")}
    result = []
    for i, name in enumerate(sorted(outs, key=lambda n: (outs[n].get("logical") or {}).get("x", 0))):
        o = outs[name]
        modes, cur = o.get("modes") or [], o.get("current_mode")
        mode = modes[cur] if cur is not None and cur < len(modes) else (modes[0] if modes else {"width": 0, "height": 0, "refresh_rate": 60000})
        lg = o.get("logical") or {}
        aw = active.get(name) or {}
        make, model, serial = o.get("make") or "", o.get("model") or "", o.get("serial") or ""
        result.append({
            "id": i, "name": name, "description": " ".join(x for x in (make, model, serial) if x), "make": make, "model": model, "serial": serial,
            "width": mode["width"], "height": mode["height"], "refreshRate": round(mode["refresh_rate"] / 1000, 3),
            "x": lg.get("x", 0), "y": lg.get("y", 0), "scale": lg.get("scale", 1.0), "transform": TRANSFORM.get(lg.get("transform", "Normal"), 0),
            "focused": name == focused, "activeWorkspace": {"id": aw.get("idx", 1), "name": str(aw.get("idx", 1))},
            "availableModes": ["%dx%d@%.2fHz" % (m["width"], m["height"], m["refresh_rate"] / 1000) for m in modes],
        })
    return result

def windows():
    wins = niri("windows") or []
    wss = {w["id"]: w for w in (niri("workspaces") or [])}
    # the focus order: the focused one first (Hyprland's focusHistoryID 0), then the rest as niri lists them
    wins.sort(key=lambda w: 0 if w.get("is_focused") else 1)
    out = []
    for n, w in enumerate(wins):
        ws = wss.get(w.get("workspace_id")) or {}
        out.append((n, w, ws))
    return out

def workspaces():
    wss = niri("workspaces") or []
    counts = {}
    for w in niri("windows") or []:
        counts[w.get("workspace_id")] = counts.get(w.get("workspace_id"), 0) + 1
    return [{"id": w["idx"], "name": w.get("name") or str(w["idx"]), "monitor": w.get("output") or "", "windows": counts.get(w["id"], 0),
             "active": bool(w.get("is_active")), "focused": bool(w.get("is_focused"))} for w in wss]

def dispatch(arg):
    """The few dispatchers Vitreus sends, in Hyprland's Lua words, as niri's actions."""
    def act(*a):
        sys.exit(subprocess.run(["niri", "msg", "action", *a], capture_output=True, timeout=5).returncode)
    m = re.search(r'hl\.dsp\.focus\(\{\s*window\s*=\s*"address:0x([0-9a-fA-F]+)"', arg)
    if m:
        act("focus-window", "--id", str(int(m.group(1), 16)))
    m = re.search(r'hl\.dsp\.focus\(\{\s*workspace\s*=\s*(\d+)', arg)
    if m:
        act("focus-workspace", m.group(1))
    if re.search(r'hl\.dsp\.window\.close\(\)', arg):
        act("close-window")
    m = re.search(r'hl\.dsp\.window\.move\(\{\s*workspace\s*=\s*(\d+)[^}]*window\s*=\s*"address:0x([0-9a-fA-F]+)"', arg)
    if m:
        act("move-window-to-workspace", "--window-id", str(int(m.group(2), 16)), "--focus", "false", m.group(1))
    sys.exit(1)

def addr(w):
    return "%x" % w["id"]

def main():
    args = [a for a in sys.argv[1:] if a != "-j"]
    as_json = "-j" in sys.argv[1:]
    cmd = args[0] if args else ""
    if cmd == "monitors":
        mons = monitors()
        if as_json:
            print(json.dumps(mons))
        else:
            for m in mons:
                print("Monitor %s (ID %d):" % (m["name"], m["id"]))
                print("\t%dx%d@%.5f at %dx%d" % (m["width"], m["height"], m["refreshRate"], m["x"], m["y"]))
                print("\tscale: %.2f" % m["scale"])
                print("\ttransform: %d" % m["transform"])
                print("\tfocused: %s" % ("yes" if m["focused"] else "no"))
                print()
    elif cmd == "workspaces":
        print(json.dumps(workspaces()))
    elif cmd == "dispatch" and len(args) > 1:
        dispatch(" ".join(args[1:]))
    elif cmd == "activewindow":
        focused = next((w for _, w, _ in windows() if w.get("is_focused")), None)
        if as_json:
            print(json.dumps({} if focused is None else {
                "address": "0x" + addr(focused), "title": focused.get("title") or "", "class": focused.get("app_id") or "", "initialClass": focused.get("app_id") or "",
                "pid": focused.get("pid") or 0, "mapped": True, "floating": bool(focused.get("is_floating")), "fullscreen": 0,
                "workspace": {"id": focused.get("workspace_id", 0), "name": str(focused.get("workspace_id", 0))}}))
        elif focused is None:
            print("Invalid")
        else:
            print("Window %s -> %s:" % (addr(focused), focused.get("title") or ""))
            print("\tclass: %s" % (focused.get("app_id") or ""))
    elif cmd == "clients":
        for n, w, ws in windows():
            wid = ws.get("idx", w.get("workspace_id", 0))
            if as_json:
                continue
            print("Window %s -> %s:" % (addr(w), w.get("title") or ""))
            print("\tmapped: 1")
            print("\tat: 0,0")
            print("\tsize: 0,0")
            print("\tworkspace: %s (%s)" % (wid, wid))
            print("\tfloating: %d" % (1 if w.get("is_floating") else 0))
            print("\tpid: %s" % (w.get("pid") or 0))
            print("\tclass: %s" % (w.get("app_id") or ""))
            print("\ttitle: %s" % (w.get("title") or ""))
            print("\tfocusHistoryID: %d" % n)
            print()
        if as_json:
            print(json.dumps([{"address": "0x" + addr(w), "mapped": True, "title": w.get("title") or "", "class": w.get("app_id") or "", "pid": w.get("pid") or 0,
                               "floating": bool(w.get("is_floating")), "workspace": {"id": ws.get("idx", 0), "name": str(ws.get("idx", 0))}, "focusHistoryID": n}
                              for n, w, ws in windows()]))
    else:
        sys.exit(1)

try:
    main()
except (RuntimeError, OSError, subprocess.SubprocessError, ValueError, KeyError):
    sys.exit(1)
